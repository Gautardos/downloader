{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Gautardos/hash-db"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_sqlite": "*",
        "ext-simplexml": "*",
        "gautardos/hash-db": "dev-master",
        "guzzlehttp/guzzle": "^7.12",
        "guzzlehttp/psr7": "^2.12",
        "minishlink/web-push": "^10.1",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "6.4.*",
        "symfony/process": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/yaml": "6.4.*",
        "twig/twig": "^3.27"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:automation": "php tests/automation_smoke.php",
        "test:navigation": "php tests/navigation_smoke.php",
        "test:statistics": "php tests/statistics_smoke.php",
        "test:maintenance": "php tests/maintenance_smoke.php",
        "test:integrity": "php tests/integrity_smoke.php",
        "test:search": "php tests/global_search_smoke.php",
        "test:pwa": "php tests/pwa_smoke.php",
        "test:jellyfin": "php tests/jellyfin_smoke.php",
        "test:security": "php tests/session_secrets_smoke.php",
        "test:ssrf": "php tests/ssrf_smoke.php",
        "test:csrf": "php tests/csrf_smoke.php",
        "test:backfill": "php tests/backfill_smoke.php",
        "test:auth": "php tests/auth_security_smoke.php",
        "test:http-auth": "php tests/http_auth_smoke.php",
        "test:music-library": [
            "php tests/music_library_smoke.php",
            "python3 tests/lyrics_audit_smoke.py"
        ],
        "test:music-automations": "php tests/music_automations_smoke.php",
        "test:music-runtime": [
            "php tests/librespot_auth_smoke.php",
            "php tests/music_downloader_command_smoke.php",
            "sh -c 'PY=python3; [ -x /opt/venv/bin/python3 ] && PY=/opt/venv/bin/python3; \"$PY\" tests/music_downloader_smoke.py'",
            "sh -c 'PY=python3; [ -x /opt/venv/bin/python3 ] && PY=/opt/venv/bin/python3; \"$PY\" tests/spotify_user_smoke.py'"
        ],
        "test:security:all": [
            "@test:auth",
            "@test:security",
            "@test:csrf",
            "@test:ssrf"
        ],
        "test:functional": [
            "php tests/functional_flow_smoke.php",
            "@test:automation",
            "@test:backfill",
            "@test:jellyfin",
            "@test:music-library",
            "@test:music-automations",
            "@test:music-runtime",
            "@test:navigation",
            "@test:statistics",
            "@test:maintenance",
            "@test:integrity",
            "@test:search",
            "@test:pwa"
        ],
        "test:all": [
            "@test:security:all",
            "@test:functional",
            "php bin/console lint:twig templates",
            "php bin/console lint:container"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    }
}
