        background: rgba(255, 255, 255, 0.04);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        white-space: nowrap;
    }

    .db-hash {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: var(--text-muted);
    }

    .db-result-actions {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex: 0 0 auto;
    }

    .db-mini-button {
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.38rem;
        padding: 0 0.62rem;
        border: 1px solid var(--border-strong);
        border-radius: 8px;
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.035);
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
        transition: 0.18s ease;
    }

    .db-mini-button:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.08);
    }

    .db-mini-button.db-accent {
        border-color: rgba(56, 189, 248, 0.3);
        color: var(--accent);
        background: rgba(56, 189, 248, 0.08);
    }

    .db-mini-button.db-accent:hover {
        border-color: var(--accent);
        color: #07111f;
        background: var(--accent);
    }

    .db-mini-button.db-icon-only {
        width: 32px;
        padding: 0;
    }

    .db-inline-preview {
        margin-top: 0.65rem;
        padding: 0.7rem 0.8rem;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--text-secondary);
        background: rgba(15, 23, 42, 0.45);
        font-size: 0.75rem;
    }

    .db-preview-card {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .db-status {
        padding: 0.1rem 0.35rem;
        border-radius: 5px;
        font-size: 0.68rem;
        font-weight: 700;
    }

    .db-status.ready {
        color: #86efac;
        background: rgba(34, 197, 94, 0.1);
    }

    .db-status.pending {
        color: #fbbf24;
        background: rgba(245, 158, 11, 0.1);
    }

    .db-empty {
        padding: 3rem 1.5rem;
        text-align: center;
    }

    .db-empty-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        margin: 0 auto 0.85rem;
        border: 1px solid var(--border);
        border-radius: 14px;
        color: var(--text-muted);
        background: rgba(255, 255, 255, 0.035);
    }

    .db-empty h3 {
        margin: 0 0 0.35rem;
        font-size: 0.95rem;
    }

    .db-empty p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.82rem;
    }

    .db-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 1.1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        color: var(--text-muted);
        background: rgba(15, 23, 42, 0.26);
        font-size: 0.71rem;
    }

    .db-secure-dot {
        width: 6px;
        height: 6px;
        display: inline-block;
        border-radius: 50%;
        background: var(--success);
        margin-right: 0.25rem;
    }

    .db-add-card {
        padding: 1.25rem;
    }

    .db-add-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.9rem;
    }

    .db-add-header h2 {
        margin: 0;
        font-size: 1.02rem;
    }

    .db-add-header p {
        margin: 0.3rem 0 0;
        color: var(--text-secondary);
        font-size: 0.78rem;
        line-height: 1.5;
    }

    .db-textarea {
        width: 100%;
        min-height: 92px;
        padding: 0.8rem 0.9rem;
        resize: vertical;
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.76rem;
        line-height: 1.55;
    }

    .db-drop-zone {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        margin-top: 0.6rem;
        padding: 0.7rem;
        border: 1px dashed rgba(255, 255, 255, 0.15);
        border-radius: 10px;
        color: var(--text-muted);
        background: rgba(255, 255, 255, 0.02);
        font-size: 0.72rem;
        text-align: center;
        transition: 0.18s ease;
        cursor: pointer;
    }

    .db-drop-zone:hover,
    .db-drop-zone.dragover {
        border-color: rgba(56, 189, 248, 0.4);
        color: var(--text-secondary);
        background: rgba(56, 189, 248, 0.045);
    }

    .db-add-actions {
        display: flex;
        gap: 0.55rem;
        margin-top: 0.75rem;
    }

    .db-hint {
        margin: 0.6rem 0 0;
        color: var(--text-muted);
        font-size: 0.68rem;
        line-height: 1.5;
    }

    .db-preview-area {
        margin-top: 0.8rem;
        padding: 0.75rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: rgba(15, 23, 42, 0.4);
    }

    .db-preview-loading {
        color: var(--text-secondary);
        font-size: 0.76rem;
        margin-bottom: 0.5rem;
    }

    .db-preview-result,
    .db-debrid-result {
        padding: 0.55rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.055);
        font-size: 0.76rem;
    }

    .db-preview-result:last-child,
    .db-debrid-result:last-child {
        border-bottom: 0;
    }

    .db-debrid-name {
        color: var(--text-primary);
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .db-debrid-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.2rem;
        color: var(--text-secondary);
        font-size: 0.68rem;
    }

    .db-host-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.12rem 0.35rem;
        border-radius: 5px;
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.055);
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .db-debrid-link {
        display: inline-block;
        margin-top: 0.3rem;
        color: var(--success);
        font-size: 0.72rem;
        text-decoration: none;
    }

    .db-debrid-link:hover {
        text-decoration: underline;
    }

    .db-preview-files {
        max-height: 150px;
        overflow-y: auto;
        margin-top: 0.4rem;
        padding: 0.4rem;
        border-radius: 6px;
        background: rgba(0, 0, 0, 0.2);
        font-size: 0.68rem;
    }

    .db-preview-file {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.18rem 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .db-preview-file:last-child {
        border-bottom: 0;
    }

    .db-preview-file span:first-child {
        overflow-wrap: anywhere;
    }

    .db-recent-list {
        padding: 0.5rem;
        max-height: 430px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(148, 163, 184, 0.3) transparent;
    }

    .db-recent-list::-webkit-scrollbar {
        width: 8px;
    }

    .db-recent-list::-webkit-scrollbar-thumb {
        border: 2px solid transparent;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.28);
        background-clip: padding-box;
    }

    .db-recent-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.68rem 0.6rem;
        border: 1px solid transparent;
        border-radius: 12px;
        transition: 0.18s ease;
    }

    .db-recent-row + .db-recent-row {
        margin-top: 0.15rem;
    }

    .db-recent-row:hover {
        border-color: rgba(255, 255, 255, 0.06);
        background: rgba(255, 255, 255, 0.03);
    }

    .db-file-icon {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--accent);
        background: rgba(56, 189, 248, 0.07);
    }

    .db-file-icon.audio {
        color: #c4b5fd;
        background: rgba(168, 85, 247, 0.08);
    }

    .db-file-icon.archive {
        color: #fbbf24;
        background: rgba(245, 158, 11, 0.08);
    }

    .db-recent-meta {
        min-width: 0;
        flex: 1 1 auto;
    }

    .db-recent-name {
        margin: 0;
        overflow: hidden;
        color: var(--text-primary);
        font-size: 0.78rem;
        font-weight: 650;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .db-recent-sub {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: 0.22rem;
        color: var(--text-secondary);
        font-size: 0.66rem;
    }

    .db-recent-actions {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        flex: 0 0 auto;
    }

    .db-recent-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        padding: 0.8rem 1.1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(15, 23, 42, 0.26);
    }

    .db-load-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.42rem;
        height: 34px;
        padding: 0 0.72rem;
        border: 1px solid rgba(56, 189, 248, 0.28);
        border-radius: 8px;
        color: var(--accent);
        background: rgba(56, 189, 248, 0.07);
        font-size: 0.71rem;
        font-weight: 750;
        transition: 0.18s ease;
    }

    .db-load-more:hover:not(:disabled) {
        border-color: var(--accent);
        color: #07111f;
        background: var(--accent);
    }

    .db-load-more:disabled {
        cursor: default;
        border-color: var(--border);
        color: var(--text-muted);
        background: rgba(255, 255, 255, 0.03);
    }

    .db-recent-count {
        color: var(--text-muted);
        font-size: 0.68rem;
        white-space: nowrap;
    }

    .db-skeleton-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.7rem 0.6rem;
    }

    .db-skeleton-lines {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .db-skeleton {
        position: relative;
        overflow: hidden;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.055);
    }

    .db-skeleton::after {
        content: '';
        position: absolute;
        inset: 0;
        transform: translateX(-100%);
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.07), transparent);
        animation: db-shimmer 1.25s infinite;
    }

    .db-skeleton-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
    }

    .db-skeleton-line {
        height: 9px;
        width: 78%;
    }

    .db-skeleton-line.short {
        width: 45%;
    }

    @keyframes db-shimmer {
        to { transform: translateX(100%); }
    }

    .db-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: rgba(2, 6, 23, 0.78);
        backdrop-filter: blur(8px);
    }

    .db-modal-backdrop.visible {
        display: flex;
    }

    .db-modal {
        width: min(560px, 100%);
        overflow: hidden;
        border: 1px solid var(--border-strong);
        border-radius: 18px;
        background: var(--bg-secondary);
        box-shadow: 0 28px 80px rgba(0, 0, 0, 0.55);
    }

    .db-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem 1.35rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .db-modal-header h2 {
        margin: 0;
        font-size: 1.05rem;
    }

    .db-modal-header p {
        margin: 0.35rem 0 0;
        max-width: 420px;
        overflow: hidden;
        color: var(--text-secondary);
        font-size: 0.76rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .db-modal-close {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border: 1px solid var(--border);
        border-radius: 9px;
        color: var(--text-secondary);
        background: transparent;
    }

    .db-modal-close:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.06);
    }

    .db-modal-body {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        padding: 1.25rem 1.35rem;
    }

    .db-field {
        display: flex;
        flex-direction: column;
        gap: 0.38rem;
    }

    .db-field label {
        color: var(--text-secondary);
        font-size: 0.72rem;
        font-weight: 650;
    }

    .db-field input {
        height: 40px;
        padding: 0 0.8rem;
        margin: 0;
        font-size: 0.8rem;
    }

    .db-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.55rem;
        padding: 1rem 1.35rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .db-description-content {
        max-height: 60vh;
        overflow-y: auto;
        padding: 1.25rem 1.35rem;
        color: var(--text-secondary);
        font-size: 0.85rem;
        line-height: 1.65;
    }

    @media (max-width: 1020px) {
        .db-layout {
            grid-template-columns: 1fr;
        }

        .db-side {
            display: grid;
            grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
            align-items: start;
        }
    }

    @media (max-width: 860px) {
        .db-side {
            grid-template-columns: 1fr;
        }

        .db-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .db-category {
            max-width: none;
        }
    }

    @media (max-width: 600px) {
        .db-tabs {
            display: flex;
            width: 100%;
        }

        .db-tab {
            flex: 1 1 auto;
            justify-content: center;
        }

        .db-result-top {
            flex-direction: column;
        }

        .db-result-actions {
            width: 100%;
        }

        .db-result-actions .db-mini-button.db-accent {
            flex: 1 1 auto;
        }

        .db-recent-row {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .db-recent-actions {
            width: 100%;
            justify-content: flex-end;
        }

        .db-recent-footer,
        .db-add-actions,
        .db-modal-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .db-load-more {
            width: 100%;
        }

        .db-recent-count {
            text-align: center;
        }

        .db-card-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.35rem;
        }

        .db-modal-backdrop {
            padding: 0.8rem;
        }
    }
</style>
{% endblock %}
