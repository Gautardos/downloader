<script>
    const playlistState = {
        playlists: [],
        filter: 'all',
        loading: false,
    };

    const playlistList = document.getElementById('playlist-list');
    const playlistLoading = document.getElementById('playlist-loading');
    const emptyState = document.getElementById('empty-state');
    const emptyTitle = document.getElementById('empty-title');
    const emptyMessage = document.getElementById('empty-message');
    const playlistCount = document.getElementById('playlist-count');
    const playlistSearch = document.getElementById('playlist-search');
    const refreshButton = document.getElementById('refresh-playlists');
    const lastSync = document.getElementById('last-sync');
    const spotifySearchInput = document.getElementById('spotify-search');
    const searchFilters = document.getElementById('search-filters');
    const searchResults = document.getElementById('search-results');
    const searchCount = document.getElementById('search-count');

    const searchState = {
        type: 'all',
        timer: null,
        requestId: 0,
    };

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function coverLabel(name) {
        const parts = String(name || '?').trim().split(/\s+/).filter(Boolean);
        if (parts.length > 1) {
            return (parts[0][0] + parts[1][0]).toUpperCase();
        }
        return String(parts[0] || '?').slice(0, 2).toUpperCase();
    }

    function visibilityInfo(isPublic) {
        if (isPublic === true) {
            return { className: 'public', label: 'Publique', icon: '' };
        }
        const lock = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>';
        return { className: 'private', label: 'Privée', icon: lock };
    }

    function renderPlaylists() {
        const query = playlistSearch.value.trim().toLowerCase();
        const items = playlistState.playlists.filter((playlist) => {
            const matchesSearch = !query || String(playlist.name || '').toLowerCase().includes(query);
            const isPublic = playlist.public === true;
            const matchesFilter = playlistState.filter === 'all'
                || (playlistState.filter === 'public' && isPublic)
                || (playlistState.filter === 'private' && !isPublic);
            return matchesSearch && matchesFilter;
        });

        playlistList.querySelectorAll('.playlist-row').forEach((row) => row.remove());
        playlistLoading.style.display = 'none';

        if (items.length === 0) {
            const hasPlaylists = playlistState.playlists.length > 0;
            emptyTitle.textContent = hasPlaylists ? 'Aucune playlist trouvée' : 'Aucune playlist disponible';
            emptyMessage.textContent = hasPlaylists
                ? 'Essayez un autre nom ou changez le filtre de visibilité.'
                : 'Aucune playlist n’a été retournée par Spotify pour ce compte.';
            emptyState.classList.add('visible');
        } else {
            emptyState.classList.remove('visible');
        }

        items.forEach((playlist, index) => {
            const visibility = visibilityInfo(playlist.public);
            const coverClass = `cover-${index % 8}`;
            const cover = playlist.image
                ? `<img src="${escapeHtml(playlist.image)}" alt="" loading="lazy" referrerpolicy="no-referrer">`
                : escapeHtml(coverLabel(playlist.name));
            const trackCount = Number(playlist.track_count || 0);
            const owner = playlist.owner ? escapeHtml(playlist.owner) : 'Playlist personnelle';
            const row = document.createElement('article');
            row.className = 'playlist-row';
            row.dataset.name = playlist.name || '';
            row.dataset.visibility = playlist.public === true ? 'public' : 'private';
            row.innerHTML = `
                <div class="cover ${coverClass}">${cover}</div>
                <div class="playlist-meta">
                    <div class="name-line">
                        <h3>${escapeHtml(playlist.name)}</h3>
                        <span class="visibility-badge ${visibility.className}">${visibility.icon}${visibility.label}</span>
                    </div>
                    <div class="subline">
                        <span>${trackCount} titre${trackCount > 1 ? 's' : ''}</span>
                        <span class="dot"></span>
                        <span>${owner}</span>
                    </div>
                </div>
                <button class="download-btn" type="button" data-id="${escapeHtml(playlist.id)}" data-name="${escapeHtml(playlist.name)}">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                    Télécharger
                </button>
            `;
            row.querySelector('.download-btn').addEventListener('click', (event) => {
                queuePlaylist(event.currentTarget, playlist.id, playlist.name);
            });
            playlistList.appendChild(row);
        });

        playlistCount.textContent = `${items.length} playlist${items.length > 1 ? 's' : ''}`;
    }

    async function loadPlaylists(force = false) {
        if (playlistState.loading) {
            return;
        }

        playlistState.loading = true;
        refreshButton.classList.add('is-loading');
        refreshButton.disabled = true;
        emptyState.classList.remove('visible');
        playlistLoading.style.display = 'flex';
        playlistLoading.innerHTML = '<span class="spinner"></span><span>Chargement de vos playlists Spotify…</span>';
        lastSync.textContent = 'Synchronisation…';

        try {
            const url = new URL("{{ path('spotify_playlists') }}", window.location.origin);
            if (force) {
                url.searchParams.set('refresh', '1');
            }

            const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(data.error || data.message || 'Impossible de charger les playlists Spotify.');
            }

            playlistState.playlists = Array.isArray(data.playlists) ? data.playlists : [];
            renderPlaylists();

            if (data.stale) {
                lastSync.textContent = 'Cache utilisé · Spotify indisponible';
                window.notify('info', data.message || 'Spotify est temporairement indisponible. Liste en cache affichée.');
            } else if (data.partial) {
                lastSync.textContent = 'Liste publique · limite Spotify';
                if (force) {
                    window.notify('info', data.warning || 'Spotify limite temporairement l’accès aux playlists privées.');
                }
            } else {
                lastSync.textContent = 'Synchronisé à l’instant';
            }
        } catch (error) {
            playlistState.playlists = [];
            playlistList.querySelectorAll('.playlist-row').forEach((row) => row.remove());
            playlistLoading.style.display = 'none';
            playlistCount.textContent = 'Indisponible';
            emptyTitle.textContent = 'Impossible de charger les playlists';
            emptyMessage.textContent = error.message || 'Vérifiez vos identifiants Spotify dans les réglages.';
            emptyState.classList.add('visible');
            lastSync.textContent = 'Échec de synchronisation';
            window.notify('error', error.message || 'Impossible de charger les playlists Spotify.');
        } finally {
            playlistState.loading = false;
            refreshButton.classList.remove('is-loading');
            refreshButton.disabled = false;
        }
    }

    async function queueSpotifyUrl(button, url, label) {
        if (button.disabled) {
            return;
        }

        const originalHtml = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<span class="spinner" style="width:14px;height:14px;border-width:2px;"></span> Ajout…';

        const formData = new FormData();
        formData.append('urls', url);

        try {
            const response = await fetch("{{ path('music_add') }}", { method: 'POST', body: formData });
            const data = await response.json();

            if (!data.success) {
                throw new Error(data.message || data.error || 'Ajout impossible.');
            }

            button.classList.add('is-done');
            button.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Ajouté';
            window.notify('success', `« ${label} » ajouté à la file.`);

            window.setTimeout(() => {
                button.classList.remove('is-done');
                button.innerHTML = originalHtml;
                button.disabled = false;
            }, 2200);
        } catch (error) {
            button.innerHTML = originalHtml;
            button.disabled = false;
            window.notify('error', error.message || 'Impossible d’ajouter cet élément.');
        }
    }

    function queuePlaylist(button, playlistId, playlistName) {
        return queueSpotifyUrl(button, `https://open.spotify.com/playlist/${playlistId}`, playlistName);
    }

    // ─── Recherche publique Spotify ──────────────────────────────────
    function searchHint(message) {
        searchResults.innerHTML = `<div class="search-hint">${escapeHtml(message)}</div>`;
        searchCount.textContent = 'Recherche';
    }

    function renderSearchResults(results) {
        searchResults.innerHTML = '';

        if (results.length === 0) {
            searchResults.innerHTML = '<div class="search-empty">Aucun résultat public trouvé pour cette recherche.</div>';
            searchCount.textContent = '0 résultat';
            return;
        }

        results.forEach((result, index) => {
            const coverClass = `cover-${index % 8}`;
            const cover = result.image
                ? `<img src="${escapeHtml(result.image)}" alt="" loading="lazy" referrerpolicy="no-referrer">`
                : escapeHtml(coverLabel(result.name));

            const sublineParts = [result.subtitle, result.meta]
                .filter((part) => part !== null && part !== undefined && String(part).trim() !== '')
                .map((part) => escapeHtml(part));

            const row = document.createElement('article');
            row.className = 'playlist-row search-result-row';
            row.innerHTML = `
                <div class="cover ${coverClass}">${cover}</div>
                <div class="playlist-meta">
                    <div class="name-line">
                        <h3>${escapeHtml(result.name)}</h3>
                        <span class="type-badge ${escapeHtml(result.type)}">${escapeHtml(result.badge)}</span>
                    </div>
                    <div class="subline">${sublineParts.join(' <span class="dot"></span> ')}</div>
                </div>
                <button class="download-btn" type="button">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                    Ajouter
                </button>
            `;

            row.querySelector('.download-btn').addEventListener('click', (event) => {
                queueSpotifyUrl(event.currentTarget, result.url, result.name);
            });

            searchResults.appendChild(row);
        });

        searchCount.textContent = `${results.length} résultat${results.length > 1 ? 's' : ''}`;
    }

    async function runSearch() {
        const query = spotifySearchInput.value.trim();
        if (query.length < 2) {
            return;
        }

        const requestId = searchState.requestId;
        searchResults.innerHTML = '<div class="search-loading"><span class="spinner"></span><span>Recherche Spotify…</span></div>';
        searchCount.textContent = 'Recherche…';

        try {
            const url = new URL("{{ path('spotify_search') }}", window.location.origin);
            url.searchParams.set('q', query);
            if (searchState.type !== 'all') {
                url.searchParams.set('type', searchState.type);
            }

            const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
            const data = await response.json();

            if (requestId !== searchState.requestId) {
                return;
            }

            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Recherche Spotify impossible.');
            }

            renderSearchResults(Array.isArray(data.results) ? data.results : []);
        } catch (error) {
            if (requestId !== searchState.requestId) {
                return;
            }

            searchResults.innerHTML = `<div class="search-empty">${escapeHtml(error.message || 'Recherche Spotify impossible.')}</div>`;
            searchCount.textContent = 'Erreur';
            window.notify('error', error.message || 'Recherche Spotify impossible.');
        }
    }

    function scheduleSearch() {
        const query = spotifySearchInput.value.trim();
        window.clearTimeout(searchState.timer);
        searchState.requestId += 1;

        if (query.length < 2) {
            searchHint('Saisissez au moins 2 caractères pour lancer la recherche publique Spotify.');
            return;
        }

        searchState.timer = window.setTimeout(runSearch, 350);
    }

    spotifySearchInput.addEventListener('input', scheduleSearch);

    searchFilters.addEventListener('click', (event) => {
        const button = event.target.closest('button[data-type]');
        if (!button) {
            return;
        }

        searchState.type = button.dataset.type;
        searchFilters.querySelectorAll('button').forEach((item) => {
            item.classList.toggle('active', item === button);
        });

        if (spotifySearchInput.value.trim().length >= 2) {
            window.clearTimeout(searchState.timer);
            searchState.requestId += 1;
            runSearch();
        }
    });

    document.getElementById('visibility-filters').addEventListener('click', (event) => {
        const button = event.target.closest('button[data-filter]');
        if (!button) {
            return;
        }
        playlistState.filter = button.dataset.filter;
        document.querySelectorAll('#visibility-filters button').forEach((item) => {
            item.classList.toggle('active', item === button);
        });
        renderPlaylists();
    });

    playlistSearch.addEventListener('input', renderPlaylists);
    refreshButton.addEventListener('click', () => loadPlaylists(true));

    // ─── Ajout manuel ────────────────────────────────────────────────
    function parseCsvLine(line) {
        const result = [];
        let current = '';
        let inQuotes = false;
        for (let i = 0; i < line.length; i += 1) {
            const char = line[i];
            if (char === '"') {
                inQuotes = !inQuotes;
            } else if (char === ',' && !inQuotes) {
                result.push(current);
                current = '';
            } else {
                current += char;
            }
        }
        result.push(current);
        return result;
    }

    function handleCsvUpload(input) {
        const file = input.files[0];
        if (!file) {
            return;
        }

        const reader = new FileReader();
        reader.onload = function (event) {
            const lines = String(event.target.result || '').split(/\r?\n/);
            if (lines.length < 2) {
                window.notify('error', 'CSV file seems empty or invalid.');
                return;
            }

            const headers = lines[0].split(',').map((header) => header.trim().replace(/^"|"$/g, ''));
            const trackIdIndex = headers.findIndex((header) => header.toLowerCase() === 'spotify track id');
            const trackIds = new Set();
            const spotifyIdRegex = /^[a-zA-Z0-9]{22}$/;

            for (let i = 1; i < lines.length; i += 1) {
                const line = lines[i].trim();
                if (!line) {
                    continue;
                }

                const cols = parseCsvLine(line);
                if (trackIdIndex !== -1 && cols[trackIdIndex]) {
                    const id = cols[trackIdIndex].trim().replace(/^"|"$/g, '');
                    if (spotifyIdRegex.test(id)) {
                        trackIds.add(id);
                        continue;
                    }
                }

                for (const col of cols) {
                    const value = col.trim().replace(/^"|"$/g, '');
                    if (spotifyIdRegex.test(value)) {
                        trackIds.add(value);
                    }
                }
            }

            if (trackIds.size === 0) {
                window.notify('error', 'No Spotify Track IDs found in CSV.');
                return;
            }

            const textarea = document.getElementById('music-links');
            const existingContent = textarea.value.trim();
            const newUrls = Array.from(trackIds).map((id) => `https://open.spotify.com/track/${id}`).join('\n');
            textarea.value = (existingContent ? existingContent + '\n' : '') + newUrls;
            window.notify('success', `Successfully imported ${trackIds.size} tracks from CSV!`);
            input.value = '';
        };
        reader.readAsText(file);
    }

    async function addMusicToQueue() {
        const textarea = document.getElementById('music-links');
        const button = document.getElementById('btn-add-music');
        const urls = textarea.value.trim();

        if (!urls) {
            window.notify('error', 'Please enter at least one link.');
            return;
        }

        button.disabled = true;
        const originalHtml = button.innerHTML;
        button.innerHTML = '<span class="spinner" style="width:14px;height:14px;border-width:2px;"></span> Ajout…';

        const formData = new FormData();
        formData.append('urls', urls);

        try {
            const response = await fetch("{{ path('music_add') }}", { method: 'POST', body: formData });
            const data = await response.json();

            if (data.success) {
                window.notify('success', 'Music links added to queue!');
                textarea.value = '';
            } else {
                window.notify('error', 'Failed to add links: ' + (data.message || data.error || 'Unknown error'));
            }
        } catch (error) {
            window.notify('error', 'Network error while adding links.');
        } finally {
            button.disabled = false;
            button.innerHTML = originalHtml;
        }
    }

    document.getElementById('btn-add-music').addEventListener('click', addMusicToQueue);

    loadPlaylists();
</script>
