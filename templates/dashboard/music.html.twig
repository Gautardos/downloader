{% extends 'base.html.twig' %}

{% block title %}Music Downloader{% endblock %}

{% block body %}
<div class="music-page">
    {% embed '_partials/page_header.html.twig' with {
        title: 'Music Downloader',
        subtitle: 'Sélectionnez une de vos playlists Spotify ou collez vos liens pour les ajouter à la file de téléchargement.',
        icon: 'music',
        icon_class: 'page-icon--music',
        badge: 'Session Zotify active'
    } %}{% endembed %}

    {% set musicQuality = config.music_quality|default('auto') %}
    {% set showFreeWarning = config.spotify_client_id is empty %}
    {% set musicQualityLabels = {
        'auto': 'Auto — best quality (Premium)',
        'very_high': 'Very High — 320 kbps (Premium only)',
        'high': 'High — 160 kbps',
        'normal': 'Normal — 96 kbps'
    } %}
    {% set musicQualityLabel = musicQualityLabels[musicQuality]|default(musicQualityLabels['auto']) %}

    <div class="music-quality-strip{{ (musicQuality == 'very_high' or showFreeWarning) ? ' is-warning' : '' }}">
        <span class="music-quality-eyebrow">Qualité audio</span>
        <span class="music-quality-value">{{ musicQualityLabel }}</span>
        <a class="music-quality-link" href="{{ path('config') }}">Modifier</a>
        {% if musicQuality == 'very_high' %}
            <span class="music-quality-warning">Premium requis — un compte Free échouera avec « Audio key error ».</span>
        {% elseif showFreeWarning %}
            <span class="music-quality-warning">Téléchargement : Premium + app Spotify requis. Compte Free non supporté (audio bloqué par Spotify).</span>
        {% endif %}
    </div>

    <section class="card search-card" aria-labelledby="search-title">
        <div class="card-header">
            <div>
                <div class="eyebrow">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/>
                        <path d="m20 20-3.5-3.5"/>
                    </svg>
                    API publique Spotify
                </div>
                <h2 id="search-title">Rechercher sur Spotify</h2>
                <p>Titres, albums et playlists publiques. Aucun accès à votre compte n’est utilisé.</p>
            </div>
            <div class="header-actions">
                <span class="count-pill" id="search-count">Recherche</span>
            </div>
        </div>

        <div class="search-toolbar">
            <div class="search-field search-field-large">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="m20 20-3.5-3.5"/>
                </svg>
                <input type="text" id="spotify-search" placeholder="Rechercher un titre, un album, une playlist…" autocomplete="off">
            </div>
            <div class="filter-pills" id="search-filters">
                <button type="button" class="active" data-type="all">Tout</button>
                <button type="button" data-type="track">Titres</button>
                <button type="button" data-type="album">Albums</button>
                <button type="button" data-type="playlist">Playlists</button>
            </div>
        </div>

        <div class="search-results" id="search-results">
            <div class="search-hint" id="search-hint">
                Saisissez au moins 2 caractères pour lancer la recherche publique Spotify.
            </div>
        </div>
    </section>

    <section class="card playlist-card" aria-labelledby="playlists-title">
        <div class="card-header">
            <div>
                <div class="eyebrow">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    Connecté via votre compte
                </div>
                <h2 id="playlists-title">Mes playlists Spotify</h2>
                <p>Playlists synchronisées depuis votre compte Spotify (cache 24 h, publiques par défaut).</p>
            </div>
            <div class="header-actions">
                <span class="count-pill" id="playlist-count">Chargement…</span>
                <button class="icon-button" id="refresh-playlists" type="button" title="Rafraîchir les playlists" aria-label="Rafraîchir les playlists">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12a9 9 0 1 1-2.64-6.36"/>
                        <path d="M21 3v6h-6"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="toolbar">
            <div class="search-field">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="m20 20-3.5-3.5"/>
                </svg>
                <input type="text" id="playlist-search" placeholder="Filtrer par nom de playlist…" autocomplete="off">
            </div>
            <div class="filter-pills" id="visibility-filters">
                <button type="button" class="active" data-filter="all">Toutes</button>
                <button type="button" data-filter="private">Privées</button>
                <button type="button" data-filter="public">Publiques</button>
            </div>
        </div>

        <div class="playlist-list" id="playlist-list">
            <div class="playlist-loading" id="playlist-loading">
                <span class="spinner"></span>
                <span>Chargement de vos playlists Spotify…</span>
            </div>

            <div class="empty-state" id="empty-state">
                <div class="empty-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </div>
                <h3 id="empty-title">Aucune playlist trouvée</h3>
                <p id="empty-message">Essayez un autre nom ou changez le filtre de visibilité.</p>
            </div>
        </div>

        <div class="card-footer">
            <span class="footer-left"><span class="secure-dot"></span> Session Spotify · app-first, cache 24 h</span>
            <span id="last-sync">Synchronisation…</span>
        </div>
    </section>

    <section class="card manual-card" aria-labelledby="manual-title">
        <div class="manual-header">
            <div>
                <h2 id="manual-title">Ajout manuel</h2>
                <p>Collez un ou plusieurs liens Spotify, un par ligne.</p>
            </div>
        </div>
        <textarea class="manual-textarea" id="music-links" placeholder="https://open.spotify.com/playlist/…&#10;https://open.spotify.com/album/…&#10;https://open.spotify.com/track/…"></textarea>
        <div class="manual-actions">
            <button class="btn btn-primary" type="button" id="btn-add-music">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                Ajouter à la file
            </button>
            <label for="csv-upload" class="btn btn-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
                Importer CSV
                <input type="file" id="csv-upload" accept=".csv" style="display: none;" onchange="handleCsvUpload(this)">
            </label>
        </div>
    </section>

    <aside class="info-box">
        <span class="info-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.74V17h8v-2.26A7 7 0 0 0 12 2z"/></svg>
        </span>
        <div>
            <h3>Un souci avec une playlist ?</h3>
            <p>Si une playlist ne remonte pas, utilisez <a href="https://www.chosic.com/spotify-playlist-exporter/" target="_blank" rel="noopener">Chosic Playlist Exporter</a> pour l’exporter en CSV, puis importez le fichier avec le bouton ci-dessus.</p>
        </div>
    </aside>
</div>

<style>
    .music-page {
        --music: #a855f7;
        --music-soft: rgba(168, 85, 247, 0.14);
        --mp-border: rgba(255, 255, 255, 0.08);
        --mp-border-strong: rgba(255, 255, 255, 0.14);
        --mp-muted: #64748b;
        max-width: none;
        margin: 0;
        padding: 0 0 3rem;
    }

    .music-page .card {
        position: relative;
        border: 1px solid var(--mp-border);
        border-radius: 18px;
        background: var(--glass);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(12px);
    }

    .music-page .music-quality-strip {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 0 0 1.35rem;
        padding: 0.7rem 1rem;
        border: 1px solid var(--mp-border);
        border-radius: 12px;
        background: rgba(15, 23, 42, 0.35);
        font-size: 0.82rem;
        color: var(--text-secondary);
    }

    .music-page .music-quality-eyebrow {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--mp-muted);
    }

    .music-page .music-quality-value {
        font-weight: 600;
        color: var(--text-primary);
    }

    .music-page .music-quality-link {
        margin-left: auto;
        color: var(--accent);
        font-weight: 500;
        text-decoration: none;
    }

    .music-page .music-quality-link:hover {
        color: var(--accent-hover);
    }

    .music-page .music-quality-strip.is-warning {
        border-color: rgba(245, 158, 11, 0.35);
        background: rgba(245, 158, 11, 0.08);
    }

    .music-page .music-quality-warning {
        color: var(--warning);
        font-weight: 500;
    }

    .music-page .playlist-card,
    .music-page .search-card {
        overflow: hidden;
        padding: 0;
    }

    .music-page .search-card {
        margin-bottom: 1.35rem;
    }

    .music-page .search-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.045);
        background: rgba(15, 23, 42, 0.2);
    }

    .music-page .search-field-large {
        max-width: 520px;
    }

    .music-page .search-results {
        max-height: 390px;
        overflow-y: auto;
        padding: 0.55rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(148, 163, 184, 0.3) transparent;
    }

    .music-page .search-results::-webkit-scrollbar {
        width: 8px;
    }

    .music-page .search-results::-webkit-scrollbar-thumb {
        border: 2px solid transparent;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.28);
        background-clip: padding-box;
    }

    .music-page .search-hint,
    .music-page .search-loading,
    .music-page .search-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        min-height: 110px;
        color: var(--text-secondary);
        font-size: 0.84rem;
        text-align: center;
    }

    .music-page .search-hint {
        color: var(--mp-muted);
    }

    .music-page .type-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.44rem;
        border-radius: 999px;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .music-page .type-badge.track {
        color: #bae6fd;
        background: rgba(56, 189, 248, 0.13);
        box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.2);
    }

    .music-page .type-badge.album {
        color: #fde68a;
        background: rgba(245, 158, 11, 0.12);
        box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.2);
    }

    .music-page .type-badge.playlist {
        color: #c4b5fd;
        background: rgba(168, 85, 247, 0.14);
        box-shadow: inset 0 0 0 1px rgba(168, 85, 247, 0.22);
    }

    .music-page .card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 1.5rem 1.5rem 1.2rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.055);
    }

    .music-page .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.45rem;
        color: var(--music);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .music-page .card-header h2 {
        margin: 0;
        font-size: 1.28rem;
        letter-spacing: -0.025em;
    }

    .music-page .card-header p {
        margin: 0.45rem 0 0;
        color: var(--text-secondary);
        font-size: 0.86rem;
        line-height: 1.5;
    }

    .music-page .header-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex: 0 0 auto;
    }

    .music-page .count-pill {
        padding: 0.42rem 0.68rem;
        border: 1px solid var(--mp-border);
        border-radius: 999px;
        color: var(--text-secondary);
        background: rgba(255, 255, 255, 0.035);
        font-size: 0.72rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .music-page .icon-button {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border: 1px solid var(--mp-border-strong);
        border-radius: 11px;
        color: var(--text-primary);
        background: rgba(255, 255, 255, 0.045);
        transition: 0.18s ease;
    }

    .music-page .icon-button:hover {
        border-color: rgba(56, 189, 248, 0.38);
        background: rgba(56, 189, 248, 0.1);
        color: var(--accent);
    }

    .music-page .icon-button.is-loading svg {
        animation: music-spin 0.8s linear infinite;
    }

    .music-page .toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.045);
        background: rgba(15, 23, 42, 0.2);
    }

    .music-page .search-field {
        position: relative;
        flex: 1 1 260px;
        max-width: 380px;
    }

    .music-page .search-field svg {
        position: absolute;
        top: 50%;
        left: 0.85rem;
        color: var(--mp-muted);
        transform: translateY(-50%);
        pointer-events: none;
    }

    .music-page .search-field input {
        width: 100%;
        height: 40px;
        margin: 0;
        padding: 0 0.9rem 0 2.4rem;
        border: 1px solid var(--mp-border);
        border-radius: 10px;
        outline: none;
        color: var(--text-primary);
        background: var(--bg-primary);
        font-size: 0.86rem;
        transition: 0.18s ease;
    }

    .music-page .search-field input::placeholder {
        color: var(--mp-muted);
    }

    .music-page .search-field input:focus {
        border-color: rgba(56, 189, 248, 0.55);
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
    }

    .music-page .filter-pills {
        display: flex;
        gap: 0.35rem;
        padding: 3px;
        border: 1px solid var(--mp-border);
        border-radius: 11px;
        background: rgba(15, 23, 42, 0.45);
    }

    .music-page .filter-pills button {
        padding: 0.42rem 0.72rem;
        border: 0;
        border-radius: 8px;
        color: var(--text-secondary);
        background: transparent;
        font-size: 0.76rem;
        font-weight: 650;
        transition: 0.18s ease;
    }

    .music-page .filter-pills button:hover {
        color: var(--text-primary);
    }

    .music-page .filter-pills button.active {
        color: var(--text-primary);
        background: rgba(56, 189, 248, 0.15);
        box-shadow: inset 0 0 0 1px rgba(56, 189, 248, 0.25);
    }

    .music-page .playlist-list {
        max-height: 520px;
        overflow-y: auto;
        padding: 0.55rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(148, 163, 184, 0.3) transparent;
    }

    .music-page .playlist-list::-webkit-scrollbar {
        width: 8px;
    }

    .music-page .playlist-list::-webkit-scrollbar-thumb {
        border: 2px solid transparent;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.28);
        background-clip: padding-box;
    }

    .music-page .playlist-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        min-height: 160px;
        color: var(--text-secondary);
        font-size: 0.86rem;
    }

    .music-page .spinner {
        width: 20px;
        height: 20px;
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: music-spin 0.8s linear infinite;
    }

    .music-page .playlist-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 0.8rem;
        border: 1px solid transparent;
        border-radius: 13px;
        transition: 0.18s ease;
    }

    .music-page .playlist-row + .playlist-row {
        margin-top: 0.2rem;
    }

    .music-page .playlist-row:hover {
        border-color: rgba(255, 255, 255, 0.065);
        background: rgba(255, 255, 255, 0.035);
    }

    .music-page .cover {
        position: relative;
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        overflow: hidden;
        border-radius: 11px;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 850;
        letter-spacing: -0.04em;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
    }

    .music-page .cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .music-page .cover::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.16), transparent 55%);
        pointer-events: none;
    }

    .music-page .cover-0 { background: linear-gradient(135deg, #7c3aed, #2563eb); }
    .music-page .cover-1 { background: linear-gradient(135deg, #db2777, #f59e0b); }
    .music-page .cover-2 { background: linear-gradient(135deg, #0891b2, #16a34a); }
    .music-page .cover-3 { background: linear-gradient(135deg, #4338ca, #a855f7); }
    .music-page .cover-4 { background: linear-gradient(135deg, #be123c, #fb923c); }
    .music-page .cover-5 { background: linear-gradient(135deg, #0f766e, #38bdf8); }
    .music-page .cover-6 { background: linear-gradient(135deg, #a16207, #84cc16); }
    .music-page .cover-7 { background: linear-gradient(135deg, #475569, #94a3b8); }

    .music-page .playlist-meta {
        min-width: 0;
        flex: 1 1 auto;
    }

    .music-page .name-line {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .music-page .name-line h3 {
        margin: 0;
        overflow: hidden;
        color: var(--text-primary);
        font-size: 0.94rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .music-page .subline {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.24rem;
        color: var(--text-secondary);
        font-size: 0.76rem;
    }

    .music-page .subline .dot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--mp-muted);
    }

    .music-page .visibility-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        padding: 0.2rem 0.42rem;
        border-radius: 999px;
        font-size: 0.62rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .music-page .visibility-badge.private {
        color: #c4b5fd;
        background: rgba(168, 85, 247, 0.14);
        box-shadow: inset 0 0 0 1px rgba(168, 85, 247, 0.22);
    }

    .music-page .visibility-badge.public {
        color: #86efac;
        background: rgba(34, 197, 94, 0.1);
        box-shadow: inset 0 0 0 1px rgba(34, 197, 94, 0.18);
    }

    .music-page .download-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.48rem;
        height: 38px;
        padding: 0 0.85rem;
        flex: 0 0 auto;
        border: 1px solid rgba(56, 189, 248, 0.32);
        border-radius: 10px;
        color: var(--accent);
        background: rgba(56, 189, 248, 0.08);
        font-size: 0.78rem;
        font-weight: 750;
        white-space: nowrap;
        transition: 0.18s ease;
    }

    .music-page .download-btn:hover {
        border-color: var(--accent);
        color: #07111f;
        background: var(--accent);
        transform: translateY(-1px);
    }

    .music-page .download-btn:active {
        transform: translateY(0);
    }

    .music-page .download-btn:disabled {
        cursor: wait;
        opacity: 0.72;
        transform: none;
    }

    .music-page .download-btn.is-done {
        border-color: rgba(34, 197, 94, 0.45);
        color: #86efac;
        background: rgba(34, 197, 94, 0.1);
    }

    .music-page .download-btn.is-done:hover {
        color: #07111f;
        background: var(--success);
    }

    .music-page .empty-state {
        display: none;
        padding: 3rem 1.5rem;
        text-align: center;
    }

    .music-page .empty-state.visible {
        display: block;
    }

    .music-page .empty-icon {
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        margin: 0 auto 0.85rem;
        border: 1px solid var(--mp-border);
        border-radius: 14px;
        color: var(--mp-muted);
        background: rgba(255, 255, 255, 0.035);
    }

    .music-page .empty-state h3 {
        margin: 0 0 0.35rem;
        font-size: 0.95rem;
    }

