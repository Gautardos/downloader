{% extends 'base.html.twig' %}

{% block title %}Music Explorer - Downloader{% endblock %}

{% block body %}
{% embed '_partials/page_header.html.twig' with {
    title: 'Music Downloads',
    subtitle: 'Explorer les fichiers dans ' ~ root ~ ' (' ~ files|length ~ ' fichier' ~ (files|length > 1 ? 's' : '') ~ ')',
    icon: 'folder'
} %}
    {% block actions %}
        <button id="btn-update-genres" class="btn btn-secondary" onclick="runBatch('genres')" {% if files is empty %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endif %}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 12 22l-9-9V4h9z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
            Update Genres
        </button>
        <button id="btn-lyrics" class="btn btn-secondary" onclick="runBatch('lyrics')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M12 17v4"/><path d="M8 21h8"/></svg>
            Add Lyrics
        </button>
        <button id="btn-move" class="btn btn-primary" onclick="runBatch('move')" {% if files is empty %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endif %}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M12 10v6"/><path d="m9 13 3 3 3-3"/></svg>
            Move to library
        </button>
    {% endblock %}
{% endembed %}

<div id="music-player" class="card music-player" style="display:none;">
    <div class="music-player-inner">
        <button id="player-prev" class="btn btn-secondary player-btn" onclick="playPreviousMusic()" title="Previous">⏮</button>
        <button id="player-toggle" class="btn btn-primary player-btn" onclick="toggleMusicPlayback()" title="Play / Pause">▶</button>
        <button id="player-next" class="btn btn-secondary player-btn" onclick="playNextMusic()" title="Next">⏭</button>
        <div class="music-player-main">
            <div id="player-title" class="music-player-title">No track selected</div>
            <input type="range" id="player-seek" min="0" max="100" step="0.1" value="0" oninput="seekMusic(this.value)" aria-label="Seek">
            <div class="music-player-time">
                <span id="player-current">0:00</span>
                <span id="player-duration">0:00</span>
            </div>
        </div>
        <input type="range" id="player-volume" class="music-player-volume" min="0" max="1" step="0.01" value="1" oninput="setMusicVolume(this.value)" title="Volume" aria-label="Volume">
        <button class="btn btn-secondary player-btn" onclick="closeMusicPlayer()" title="Close player">×</button>
    </div>
    <audio id="music-audio" preload="metadata"></audio>
</div>

<div class="card" style="padding: 0; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 800px;">
        <thead style="background: rgba(255,255,255,0.03);">
            <tr>
                <th style="padding: 1rem;">File Name</th>
                <th class="hide-mobile" style="padding: 1rem;">Location</th>
                <th class="hide-mobile" style="padding: 1rem; text-align: center;">Genre</th>
                <th class="hide-mobile" style="padding: 1rem; text-align: center;">Lyrics</th>
                <th class="hide-mobile" style="padding: 1rem;">Size</th>
                <th class="hide-mobile" style="padding: 1rem;">Added</th>
                <th style="padding: 1rem; min-width: 230px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for file in files %}
            <tr class="music-file-row" data-file-path="{{ file.path|e('html_attr') }}" data-file-name="{{ file.name|e('html_attr') }}" data-has-lyrics="{{ file.has_lyrics ? '1' : '0' }}" data-lyrics-synced="{{ file.lyrics_synced ? '1' : '0' }}" style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 1rem; font-weight: 500;">{{ file.name }}</td>
                <td class="hide-mobile" style="padding: 1rem; color: var(--text-secondary); font-size: 0.85rem;" title="{{ file.path }}">
                    {{ file.rel_path }}
                </td>
                <td class="hide-mobile" style="padding: 1rem; text-align: center; color: var(--text-secondary); font-size: 0.85rem;">
                    {{ file.genre ?: '-' }}
                </td>
                <td class="hide-mobile" style="padding: 1rem; text-align: center; font-size: 1.2rem;">
                    {% if file.has_lyrics %}
                        <span class="lyrics-badge {{ file.lyrics_synced ? 'is-synced' : 'is-unsynced' }}" title="{{ file.lyrics_synced ? 'Synced lyrics' : 'Unsynced lyrics' }}">📝</span>
                    {% else %}
                        <span title="No Lyrics" style="opacity: 0.3; filter: grayscale(1);">❌</span>
                    {% endif %}
                </td>
                <td class="hide-mobile" style="padding: 1rem;"><span class="badge" style="background: rgba(255,255,255,0.05);">{{ (file.size / 1024 / 1024)|number_format(2) }} MB</span></td>
                <td class="hide-mobile" style="padding: 1rem; font-size: 0.85rem; color: var(--text-secondary);">{{ file.mtime|date('d/m/Y H:i') }}</td>
                <td style="padding: 1rem;">
                    <div class="music-actions" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                        <button class="btn btn-secondary btn-icon btn-play" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;" onclick="playMusic({{ loop.index0 }})" title="Play">
                            ▶ Play
                        </button>
                        <button class="btn btn-secondary btn-icon" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;" onclick="viewDetails('{{ file.path|e('js') }}', '{{ file.name|e('js') }}')">
                            🔍 Details
                        </button>
                        <button class="btn btn-secondary btn-icon" 
                                style="padding: 0.4rem 0.8rem; font-size: 0.75rem; {% if file.has_lyrics %}opacity: 0.5; cursor: not-allowed; filter: grayscale(1);{% endif %}" 
                                onclick="fetchSingleLyrics('{{ file.path|e('js') }}', this)"
                                {% if file.has_lyrics %}disabled title="Lyrics already present"{% endif %}>
                            🎵 Lyrics
                        </button>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" style="padding: 2rem; text-align: center; color: var(--text-secondary);">
                    No audio files found in the download directory.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Details Modal -->
<div id="details-modal" class="modal-overlay">
    <div class="modal-container-custom">
        <div class="modal-header-custom">
            <h2 id="details-title" style="margin: 0; font-size: 1.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">File Details</h2>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <button id="btn-save-tags" class="btn btn-primary" onclick="saveTags()" style="display: none; padding: 0.4rem 0.8rem; font-size: 0.85rem;">💾 Save</button>
                <button class="btn-remove" onclick="closeDetails()" style="font-size: 2rem; background: none; border: none; color: var(--text-secondary); cursor: pointer;">×</button>
            </div>
        </div>
        <div id="details-loading" style="text-align: center; padding: 2rem;">
            <div style="font-size: 2rem; animation: spin 1s infinite linear;">⌛</div>
            <p>Extracting metadata...</p>
        </div>
        <div id="details-content" class="modal-body-custom" style="display: none;">
            <div id="details-grid" class="details-grid">
                <!-- Dynamic -->
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    .music-player {
        position: sticky;
        top: var(--music-player-top, 4.75rem);
        z-index: 900;
        margin-bottom: 1rem;
        padding: 1rem 1.25rem;
        background: var(--bg-secondary);
        border: 1px solid rgba(255,255,255,0.12);
        border-left: 4px solid var(--accent);
        box-shadow: 0 12px 36px rgba(0,0,0,0.35);
    }

    .music-player-inner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .music-player-main {
        flex: 1;
        min-width: 220px;
    }

    .music-player-title {
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.35rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .music-player-time {
        display: flex;
        justify-content: space-between;
        font-size: 0.72rem;
        color: var(--text-secondary);
        margin-top: 0.2rem;
    }

    #player-seek {
        width: 100%;
        accent-color: var(--accent);
        cursor: pointer;
    }

    .music-player-volume {
        width: 90px;
        accent-color: var(--accent);
        cursor: pointer;
    }

    .player-btn {
        padding: 0.5rem 0.7rem;
        min-width: 2.5rem;
    }

    .music-file-row.is-playing {
        background: rgba(56, 189, 248, 0.08) !important;
    }

    .lyrics-badge.is-synced {
        color: #22c55e;
    }

    .lyrics-badge.is-unsynced {
        color: #f59e0b;
    }

    .btn-play {
        border-color: rgba(56, 189, 248, 0.35);
        color: var(--accent);
    }

    @media (max-width: 768px) {
        .hide-mobile {
            display: none !important;
        }

        td {
            padding: 0.75rem !important;
        }

        .music-player {
            padding: 0.75rem;
        }

        .music-player-volume {
            display: none;
        }

        .music-actions {
            justify-content: flex-end;
        }
    }

    /* Modal Enhancements */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(8px);
        z-index: 2000;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .modal-container-custom {
        background: var(--bg-secondary);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.1);
        width: 100%;
        max-width: 600px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,0.5);
        animation: modalAppear 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        margin: 0 auto;
    }

    .modal-header-custom {
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        padding: 1.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .modal-body-custom {
        padding: 1.5rem;
        overflow-y: auto;
        flex: 1;
    }

    .details-grid {
        display: grid; 
        grid-template-columns: 140px 1fr; 
        gap: 1rem; 
        font-size: 0.9rem;
    }

    @keyframes modalAppear {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
        .modal-overlay {
            padding: 1rem;
        }
        .modal-container-custom {
            max-height: 95vh;
        }
        .details-grid {
            grid-template-columns: 1fr;
            gap: 0.5rem;
        }
        .details-grid > div:nth-child(even) {
            margin-bottom: 0.75rem;
            padding-left: 0.5rem;
            border-left: 2px solid var(--accent);
        }
        .modal-header-custom, .modal-body-custom {
            padding: 1rem;
        }
    }
</style>

<!-- Batch Progress Modal -->
<div id="batch-modal" class="modal-overlay" style="z-index: 2200;">
    <div class="modal-container-custom" style="max-width: 900px;">
        <div class="modal-header-custom">
            <h2 id="batch-modal-title" style="margin: 0; font-size: 1.25rem;">Batch processing</h2>
            <button class="btn-remove" onclick="closeBatchModal()" style="font-size: 2rem; background: none; border: none; color: var(--text-secondary); cursor: pointer;">×</button>
        </div>
        <div class="modal-body-custom">
            <div style="margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; font-size: 0.9rem;">
                    <span id="batch-current" style="color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Preparing...</span>
                    <span id="batch-counter" style="font-weight: 600; white-space: nowrap;">0 / 0</span>
                </div>
                <div style="height: 10px; background: rgba(255,255,255,0.06); border-radius: 5px; overflow: hidden;">
                    <div id="batch-progress-bar" style="width: 0%; height: 100%; background: linear-gradient(90deg, var(--accent), var(--success)); transition: width 0.25s ease;"></div>
                </div>
            </div>

            <div id="batch-summary" style="display: none; margin-bottom: 1.25rem; padding: 1rem; border-radius: 10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); font-size: 0.9rem;"></div>

            <div style="overflow-x: auto; max-height: 45vh;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
                    <thead style="position: sticky; top: 0; background: var(--bg-secondary); z-index: 1;">
                        <tr style="border-bottom: 2px solid rgba(255,255,255,0.1);">
                            <th style="padding: 0.65rem;">File</th>
                            <th style="padding: 0.65rem; width: 120px;">Status</th>
                            <th style="padding: 0.65rem;">Details</th>
                        </tr>
                    </thead>
                    <tbody id="batch-results-body">
                        <!-- Dynamic -->
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer" style="display: flex; justify-content: flex-end; gap: 0.75rem; padding: 1.25rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.05);">
            <button id="btn-batch-cancel" class="btn btn-secondary" onclick="cancelBatch()">Cancel</button>
            <button id="btn-batch-refresh" class="btn btn-secondary" onclick="window.location.reload()" style="display: none;">Refresh page</button>
            <button id="btn-batch-close" class="btn btn-primary" onclick="closeBatchModal()" style="display: none;">Close</button>
        </div>
    </div>
</div>

<!-- Lyrics Modal -->
<div id="lyrics-modal" class="modal-overlay" style="z-index: 2100;">
    <div class="modal-container-custom" style="max-width: 800px;">
        <div class="modal-header-custom">
            <h2 style="margin: 0; font-size: 1.25rem;">Lyrics Fetching Summary</h2>
            <button class="btn-remove" onclick="closeLyricsModal()" style="font-size: 2rem;">×</button>
        </div>
        
        <div class="modal-body-custom">
            <div id="lyrics-results-container" style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                    <thead style="position: sticky; top: 0; background: var(--bg-secondary); z-index: 1;">
                        <tr style="border-bottom: 2px solid rgba(255,255,255,0.1);">
                            <th style="padding: 0.75rem;">Artist</th>
                            <th style="padding: 0.75rem;">Title</th>
                            <th style="padding: 0.75rem;">Status</th>
                            <th class="hide-mobile" style="padding: 0.75rem;">Type</th>
                        </tr>
                    </thead>
                    <tbody id="lyrics-results-body">
                        <!-- Dynamic -->
                    </tbody>
                </table>
            </div>
            
            <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end;">
                <button class="btn btn-primary" onclick="window.location.reload()">Refresh Page</button>
            </div>
        </div>
    </div>
</div>

<script>
function syncMusicPlayerTop() {
    const nav = document.querySelector('nav');
    const height = nav ? Math.ceil(nav.getBoundingClientRect().height) : 0;
    document.documentElement.style.setProperty('--music-player-top', (height + 12) + 'px');
}

document.addEventListener('DOMContentLoaded', () => {
    syncMusicPlayerTop();

    // Check if Add Lyrics button should be enabled
    const filesMissingLyrics = Array.from(document.querySelectorAll('td span[title="No Lyrics"]')).length;
    const btnLyrics = document.getElementById('btn-lyrics');
    if (btnLyrics && filesMissingLyrics === 0) {
        btnLyrics.disabled = true;
        btnLyrics.style.opacity = '0.5';
        btnLyrics.title = 'All files already have lyrics.';
    }
});

window.addEventListener('resize', syncMusicPlayerTop);

const musicStreamUrl = "{{ path('music_stream') }}";
const musicAudio = document.getElementById('music-audio');
const musicPlayer = document.getElementById('music-player');
let musicPlaylist = [];
let musicIndex = -1;

function getMusicPlaylist() {
    return Array.from(document.querySelectorAll('.music-file-row')).map(row => ({
        path: row.dataset.filePath,
        name: row.dataset.fileName,
        row: row
    }));
}

function formatMusicTime(seconds) {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const minutes = Math.floor(seconds / 60);
    const remaining = Math.floor(seconds % 60);
    return minutes + ':' + String(remaining).padStart(2, '0');
}

function updateMusicPlayButton() {
    const button = document.getElementById('player-toggle');
    if (button) button.textContent = musicAudio.paused ? '▶' : '⏸';
}

function highlightMusicTrack(index) {
    document.querySelectorAll('.music-file-row.is-playing').forEach(row => row.classList.remove('is-playing'));
    if (musicPlaylist[index]?.row) {
        musicPlaylist[index].row.classList.add('is-playing');
    }
}

function loadMusicTrack(index) {
    const track = musicPlaylist[index];
    if (!track) return;

    musicIndex = index;
    musicPlayer.style.display = 'block';
    document.getElementById('player-title').textContent = track.name;
    document.getElementById('player-current').textContent = '0:00';
    document.getElementById('player-duration').textContent = '0:00';
    document.getElementById('player-seek').value = 0;
    highlightMusicTrack(index);

    musicAudio.src = musicStreamUrl + '?path=' + encodeURIComponent(track.path);
    musicAudio.load();
}

function playMusic(index) {
    musicPlaylist = getMusicPlaylist();
    if (!musicPlaylist[index]) return;

    loadMusicTrack(index);
    musicAudio.play().catch(error => {
        console.warn('Playback failed', error);
    });
}

function toggleMusicPlayback() {
    if (!musicAudio.src) {
        if (musicPlaylist.length > 0) {
            playMusic(0);
        }
        return;
    }

    if (musicAudio.paused) {
        musicAudio.play().catch(error => console.warn('Playback failed', error));
    } else {
        musicAudio.pause();
    }
}

function playNextMusic() {
    if (musicPlaylist.length === 0) {
        musicPlaylist = getMusicPlaylist();
    }
    if (musicPlaylist.length === 0) return;

    const nextIndex = musicIndex < 0 ? 0 : (musicIndex + 1) % musicPlaylist.length;
    playMusic(nextIndex);
}

function playPreviousMusic() {
    if (musicPlaylist.length === 0) {
        musicPlaylist = getMusicPlaylist();
    }
    if (musicPlaylist.length === 0) return;

    const previousIndex = musicIndex <= 0 ? musicPlaylist.length - 1 : musicIndex - 1;
    playMusic(previousIndex);
}

function closeMusicPlayer() {
    musicAudio.pause();
    musicAudio.removeAttribute('src');
    musicAudio.load();
    musicPlayer.style.display = 'none';
    document.querySelectorAll('.music-file-row.is-playing').forEach(row => row.classList.remove('is-playing'));
    musicIndex = -1;
}

function seekMusic(value) {
    if (!Number.isFinite(musicAudio.duration) || musicAudio.duration <= 0) return;
    musicAudio.currentTime = (Number(value) / 100) * musicAudio.duration;
}

function setMusicVolume(value) {
    musicAudio.volume = Number(value);
}

musicAudio.addEventListener('loadedmetadata', () => {
    document.getElementById('player-duration').textContent = formatMusicTime(musicAudio.duration);
});

musicAudio.addEventListener('timeupdate', () => {
    document.getElementById('player-current').textContent = formatMusicTime(musicAudio.currentTime);
    if (Number.isFinite(musicAudio.duration) && musicAudio.duration > 0) {
        document.getElementById('player-seek').value = (musicAudio.currentTime / musicAudio.duration) * 100;
    }
});

musicAudio.addEventListener('play', updateMusicPlayButton);
musicAudio.addEventListener('pause', updateMusicPlayButton);
musicAudio.addEventListener('ended', playNextMusic);
musicAudio.addEventListener('error', () => {
    const title = document.getElementById('player-title');
    if (title) title.textContent = 'Playback error: ' + (musicPlaylist[musicIndex]?.name || 'unknown track');
});

const batchConfig = {
    genres: {
        url: "{{ path('music_update_genres') }}",
        recordAction: 'genres',
        title: 'Updating genres',
        confirm: 'This will detect and update genres for every file using AI/Mapping. Continue?'
    },
    lyrics: {
        url: "{{ path('fetch_lyrics') }}",
        recordAction: 'lyrics',
        title: 'Fetching lyrics',
        confirm: null,
        skipWithLyrics: true
    },
    move: {
        url: "{{ path('move_to_library') }}",
        recordAction: 'library_move',
        title: 'Moving files to library',
        confirm: 'This will move every file into the configured music library. Continue?'
    }
};
const batchRecordUrl = "{{ path('music_batch_record') }}";
const batchButtonIds = ['btn-update-genres', 'btn-lyrics', 'btn-move'];
const batchRequestTimeout = 620000;

let batchState = {
    running: false,
    cancelRequested: false,
    action: null,
    files: [],
    results: [],
    completed: 0,
    controller: null
};

function getBatchFiles() {
    return Array.from(document.querySelectorAll('.music-file-row')).map(row => ({
        path: row.dataset.filePath,
        name: row.dataset.fileName,
        hasLyrics: row.dataset.hasLyrics === '1',
        row: row
    }));
}

function normalizeBatchStatus(status) {
    const value = String(status || '').toLowerCase();
    if (['success', 'found', 'completed', 'complete', 'moved', 'updated'].includes(value)) return 'success';
    if (['warning', 'not_found', 'partial'].includes(value)) return 'warning';
    if (['skipped', 'skip'].includes(value)) return 'skipped';
    if (['canceled', 'cancelled'].includes(value)) return 'canceled';
    if (['pending', 'running'].includes(value)) return value;
    return 'error';
}

function batchStatusInfo(status) {
    const normalized = normalizeBatchStatus(status);
    const map = {
        pending: { label: '⏳ Pending', color: 'var(--text-secondary)' },
        running: { label: '⌛ Running', color: 'var(--accent)' },
        success: { label: '✅ Success', color: 'var(--success)' },
        warning: { label: '⚠️ Warning', color: '#f59e0b' },
        error: { label: '❌ Error', color: 'var(--danger)' },
        skipped: { label: '⏭️ Skipped', color: '#94a3b8' },
        canceled: { label: '🚫 Canceled', color: '#94a3b8' }
    };
    return map[normalized] || map.pending;
}

function buildBatchMessage(action, result) {
    if (!result) return '';

    if (action === 'genres') {
        if (result.genre) {
            return `${result.old_genre || '?'} → ${result.genre}`;
        }
        return result.error || (result.logs && result.logs.length ? result.logs[result.logs.length - 1] : 'Updated');
    }

    if (action === 'lyrics') {
        if (result.status === 'found' || result.lyrics) {
            return `${result.title || 'Lyrics found'}${result.type ? ' (' + result.type + ')' : ''}`;
        }
        return result.reason || result.message || result.error || 'Not found';
    }

    if (action === 'move') {
        return result.final_path || result.error || 'Moved';
    }

    return result.message || result.error || '';
}

function applyBatchRowSideEffects(action, item, result) {
    if (!item.row || !result) return;

    if (action === 'genres' && result.genre) {
        const genreCell = item.row.children[2];
        if (genreCell) genreCell.textContent = result.genre;
    }

    if (action === 'lyrics' && (result.status === 'found' || result.lyrics)) {
        setMusicRowLyrics(item.row, true, result.type === 'synced');
    }

    if (action === 'move' && result.final_path) {
        item.row.dataset.filePath = result.final_path;
        const locationCell = item.row.children[1];
        if (locationCell) locationCell.textContent = result.final_path;
    }
}

function setBatchRowStatus(index, status) {
    const row = document.getElementById('batch-result-row-' + index);
    if (!row) return;
    const info = batchStatusInfo(status);
    const statusCell = row.querySelector('.batch-status-cell');
    if (statusCell) {
        statusCell.textContent = info.label;
        statusCell.style.color = info.color;
    }
}

function setBatchRowMessage(index, message) {
    const row = document.getElementById('batch-result-row-' + index);
    if (!row) return;
    const detailsCell = row.querySelector('.batch-details-cell');
    if (detailsCell) detailsCell.textContent = message || '';
}

function initBatchResults(files) {
