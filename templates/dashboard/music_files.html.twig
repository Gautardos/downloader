        const detailsCell = document.createElement('td');
        detailsCell.className = 'batch-details-cell';
        detailsCell.style.padding = '0.65rem';
        detailsCell.style.color = 'var(--text-secondary)';
        detailsCell.style.fontSize = '0.8rem';
