function updateMusicRowGenre(path, genre) {
    const row = Array.from(document.querySelectorAll('.music-file-row'))
        .find(candidate => candidate.dataset.filePath === path);

    if (!row) return;
    const genreCell = row.children[2];
    if (genreCell) genreCell.textContent = genre || '-';
}

function setMusicRowLyrics(row, hasLyrics, synced) {
    if (!row) return;
    row.dataset.hasLyrics = hasLyrics ? '1' : '0';
    row.dataset.lyricsSynced = synced ? '1' : '0';
    const lyricsCell = row.children[3];
    if (!lyricsCell) return;
    if (!hasLyrics) {
        lyricsCell.innerHTML = '<span title="No Lyrics" style="opacity: 0.3; filter: grayscale(1);">❌</span>';
        return;
    }
    const label = synced ? 'Synced lyrics' : 'Unsynced lyrics';
    const className = synced ? 'is-synced' : 'is-unsynced';
    lyricsCell.innerHTML = '<span class="lyrics-badge ' + className + '" title="' + label + '">📝</span>';
}

async function fetchAiGenre(btn) {
    if (!currentFilePath) return;

    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '⌛ AI...';

    try {
        const response = await fetch("{{ path('music_update_genres') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: currentFilePath })
        });
        const data = await response.json();

        if (!response.ok || data.success === false) {
            throw new Error(data.message || data.error || 'AI genre fetch failed.');
        }

        const result = data.result || {};
        const genre = (result.genre || '').trim();
        const genreInput = document.getElementById('edit-genre');

        if (!genre || ['unknown', 'none'].includes(genre.toLowerCase())) {
            const logs = Array.isArray(result.logs) ? result.logs : [];
            const aiFailure = logs.some(log => /AI could not determine|AI is disabled/i.test(log));

            if (aiFailure && genreInput && genreInput.value.trim()) {
                window.notify('info', 'AI could not determine a genre. Existing genre kept.');
            } else if (aiFailure) {
                window.notify('info', 'AI could not determine a genre for this track.');
            } else {
                window.notify('info', result.error || 'AI could not determine a genre for this track.');
            }
            return;
        }

        if (genreInput) genreInput.value = genre;

        updateMusicRowGenre(currentFilePath, genre);
        window.notify('success', 'AI genre: ' + genre);
    } catch (e) {
        window.notify('error', e.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
    }
}

async function refreshLyricsText(lyricsText) {
    try {
        const response = await fetch("{{ path('file_tags') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: currentFilePath })
        });
        const data = await response.json();

        if (!data.success) return null;

        let lyrics = (data.tags && data.tags.lyrics) || '';
        if (lyrics === 'None' || lyrics === '[]') lyrics = '';
        lyricsText.textContent = lyrics;
        return lyrics;
    } catch (e) {
        console.warn('Could not refresh lyrics', e);
        return null;
    }
}

async function clearLyrics(btn, lyricsText) {
    if (!currentFilePath) return;
    if (!confirm('Remove lyrics from this file?')) return;

    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '⌛';

    try {
        const response = await fetch("{{ path('update_tags') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                path: currentFilePath,
                tags: { lyrics: '' }
            })
        });
        const data = await response.json();

        if (!response.ok || data.success === false) {
            throw new Error(data.message || data.error || 'Could not clear lyrics.');
        }

        lyricsText.textContent = '';

        const row = Array.from(document.querySelectorAll('.music-file-row'))
            .find(candidate => candidate.dataset.filePath === currentFilePath);
        if (row) {
            setMusicRowLyrics(row, false, false);
        }

        window.notify('success', 'Lyrics cleared.');
    } catch (e) {
        window.notify('error', e.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
    }
}

async function fetchLyricsForDetails(btn, lyricsText) {
    if (!currentFilePath) return;

    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '⌛';

    try {
        const response = await fetch("{{ path('fetch_lyrics') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: currentFilePath })
        });
        const data = await response.json();

        if (!response.ok || data.success === false) {
            throw new Error(data.message || data.error || 'Lyrics fetch failed.');
        }

        const fileName = currentFilePath.split(/[\\/]/).pop();
        const results = Array.isArray(data.results) ? data.results : [];
        const fileResult = results.find(result => result.file === fileName) || results[0] || null;

        if (fileResult && (fileResult.status === 'found' || fileResult.status === 'skipped')) {
            await refreshLyricsText(lyricsText);

            const row = Array.from(document.querySelectorAll('.music-file-row'))
                .find(candidate => candidate.dataset.filePath === currentFilePath);
            if (row) {
                setMusicRowLyrics(row, true, fileResult.type === 'synced');
            }

            if (fileResult.status === 'found') {
                const type = fileResult.type ? ' (' + fileResult.type + ')' : '';
                window.notify('success', 'Lyrics found for ' + (fileResult.title || fileName) + type);
            } else {
                window.notify('info', 'Lyrics already present.');
            }
        } else {
            const reason = fileResult?.reason ? ' (' + fileResult.reason + ')' : '';
            window.notify('info', 'Lyrics not found' + reason);
        }
    } catch (e) {
        window.notify('error', e.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
    }
}
</script>
{% endblock %}
