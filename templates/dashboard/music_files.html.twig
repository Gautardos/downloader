function setBatchButtonsDisabled(disabled) {
    batchButtonIds.forEach(id => {
        const btn = document.getElementById(id);
        if (!btn) return;

        if (disabled) {
            btn.dataset.batchWasDisabled = btn.disabled ? '1' : '0';
            btn.disabled = true;
            btn.style.opacity = '0.6';
        } else {
            btn.disabled = btn.dataset.batchWasDisabled === '1';
            btn.style.opacity = btn.disabled ? '0.5' : '1';
        }
    });
}

function updateBatchProgress() {
    const total = batchState.files.length;
    const completed = batchState.completed;
    const percent = total > 0 ? Math.round((completed / total) * 100) : 0;

    document.getElementById('batch-counter').textContent = completed + ' / ' + total;
    document.getElementById('batch-progress-bar').style.width = percent + '%';
}

function openBatchModal(action) {
    const config = batchConfig[action];
    document.getElementById('batch-modal-title').textContent = config.title;
    document.getElementById('batch-summary').style.display = 'none';
    document.getElementById('batch-summary').innerHTML = '';
    document.getElementById('batch-current').textContent = 'Preparing...';
    document.getElementById('btn-batch-cancel').style.display = 'inline-block';
    document.getElementById('btn-batch-cancel').disabled = false;
    document.getElementById('btn-batch-cancel').textContent = 'Cancel';
    document.getElementById('btn-batch-close').style.display = 'none';
    document.getElementById('btn-batch-refresh').style.display = 'none';
    document.getElementById('batch-modal').style.display = 'flex';
}

function closeBatchModal() {
    if (batchState.running) return;
    document.getElementById('batch-modal').style.display = 'none';
}

function cancelBatch() {
    if (!batchState.running || batchState.cancelRequested) return;

    batchState.cancelRequested = true;
    const cancelBtn = document.getElementById('btn-batch-cancel');
    cancelBtn.disabled = true;
    cancelBtn.textContent = 'Stopping after current file...';
}

function showBatchSummary(action, results) {
    const counts = { success: 0, warning: 0, error: 0, skipped: 0, canceled: 0 };
    results.forEach(result => {
        const status = normalizeBatchStatus(result.status);
        if (Object.prototype.hasOwnProperty.call(counts, status)) {
            counts[status]++;
        }
    });

    const summary = document.getElementById('batch-summary');
    summary.innerHTML = `
        <div style="font-weight: 600; margin-bottom: 0.35rem;">${batchConfig[action].title} complete</div>
        <div style="color: var(--success);">✅ ${counts.success} success</div>
        <div style="color: #f59e0b;">⚠️ ${counts.warning} warning</div>
        <div style="color: var(--danger);">❌ ${counts.error} error</div>
        <div style="color: #94a3b8;">⏭️ ${counts.skipped} skipped · 🚫 ${counts.canceled} canceled</div>
    `;
    summary.style.display = 'block';

    const type = counts.error > 0 ? 'error' : (counts.warning > 0 ? 'info' : 'success');
    window.notify(type, `${batchConfig[action].title} complete: ${counts.success} success, ${counts.warning} warning, ${counts.error} error.`);
}

async function recordBatch(action, results) {
    try {
        await fetch(batchRecordUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                action: batchConfig[action].recordAction,
                results: results
            })
        });
    } catch (e) {
        console.warn('Could not record batch results', e);
    }
}

async function runBatch(action) {
    if (batchState.running) return;

    const config = batchConfig[action];
    if (!config) return;

    if (config.confirm && !confirm(config.confirm)) return;

    const files = getBatchFiles().map(file => ({
        ...file,
        skip: config.skipWithLyrics === true && file.hasLyrics,
        status: config.skipWithLyrics === true && file.hasLyrics ? 'skipped' : 'pending',
        message: config.skipWithLyrics === true && file.hasLyrics ? 'Lyrics already present' : '',
        result: null
    }));

    if (files.length === 0) {
        window.notify('info', 'No files to process.');
        return;
    }

    batchState = {
        running: true,
        cancelRequested: false,
        action: action,
        files: files,
        results: [],
        completed: files.filter(file => file.skip).length,
        controller: null
    };

    initBatchResults(files);
    openBatchModal(action);
    setBatchButtonsDisabled(true);
    updateBatchProgress();

    const results = [];

    for (let index = 0; index < files.length; index++) {
        const item = files[index];

        if (item.skip) {
            results.push({ status: 'skipped', file: item.name, reason: item.message });
            continue;
        }

        if (batchState.cancelRequested) {
            item.status = 'canceled';
            item.message = 'Canceled by user';
            setBatchRowStatus(index, item.status);
            setBatchRowMessage(index, item.message);
            batchState.completed++;
            updateBatchProgress();
            results.push({ status: 'canceled', file: item.name, reason: item.message });
            continue;
        }

        item.status = 'running';
        setBatchRowStatus(index, item.status);
        document.getElementById('batch-current').textContent = item.name;

        const controller = new AbortController();
        batchState.controller = controller;
        const timeoutId = setTimeout(() => controller.abort(), batchRequestTimeout);

        try {
            const res = await fetch(config.url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: item.path }),
                signal: controller.signal
            });

            let data = {};
            try {
                data = await res.json();
            } catch (e) {
                data = {};
            }

            if (!res.ok || data.success === false) {
                throw new Error(data.message || data.error || data.details || ('HTTP ' + res.status));
            }

            const result = data.result || (Array.isArray(data.results) ? data.results[0] : null) || data.output || {};
            item.result = result;
            item.status = normalizeBatchStatus(result.status || data.status || 'success');
            item.message = item.status === 'error'
                ? (result.error || data.message || 'Processing failed')
                : buildBatchMessage(action, result);

            applyBatchRowSideEffects(action, item, result);
        } catch (e) {
            if (e.name === 'AbortError') {
                item.status = batchState.cancelRequested ? 'canceled' : 'error';
                item.message = batchState.cancelRequested ? 'Canceled by user' : 'Request timed out';
            } else {
                item.status = 'error';
                item.message = e.message || 'Request failed';
            }
        } finally {
            clearTimeout(timeoutId);
            batchState.controller = null;
        }

        batchState.completed++;
        setBatchRowStatus(index, item.status);
        setBatchRowMessage(index, item.message);
        updateBatchProgress();

        results.push(item.result && typeof item.result === 'object'
            ? { ...item.result, status: item.result.status || item.status, file: item.result.file || item.name }
            : { status: item.status, file: item.name, reason: item.message });
    }

    await recordBatch(action, results);

    batchState.results = results;
    batchState.running = false;

    setBatchButtonsDisabled(false);
    document.getElementById('batch-current').textContent = batchState.cancelRequested ? 'Canceled' : 'Done';
    document.getElementById('btn-batch-cancel').style.display = 'none';
    document.getElementById('btn-batch-close').style.display = 'inline-block';
    document.getElementById('btn-batch-refresh').style.display = 'inline-block';

    showBatchSummary(action, results);
}

async function fetchSingleLyrics(path, btn) {
    const originalText = btn.innerHTML;
    const originalPointerEvents = btn.style.pointerEvents;

    btn.disabled = true;
    btn.style.opacity = '0.7';
    btn.style.pointerEvents = 'none';
    btn.innerHTML = '<span style="display:inline-block; animation: spin 1s infinite linear;">⌛</span>';

    try {
        const res = await fetch("{{ path('fetch_lyrics') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: path })
        });

        const data = await res.json();
        
        if (data.success) {
            // Check if specific file result is found
            const fileResult = data.results.find(r => r.file === path.split(/[\\/]/).pop());
            if (fileResult) {
                if (fileResult.status === 'found') {
                     window.notify('success', `Lyrics found for ${fileResult.title}`);
                     setTimeout(() => window.location.reload(), 1000);
                } else {
                     window.notify('info', `Lyrics status: ${fileResult.status} (${fileResult.reason || 'No reason'})`);
                }
            } else {
                showLyricsResults(data.results);
            }
        } else {
            let errorMsg = 'Error: ' + (data.message || 'Unknown error');
            if (data.details) {
                errorMsg += '\n\nDetails:\n' + data.details;
            }
            alert(errorMsg);
        }
    } catch (e) {
        alert('Fetch Error: ' + e.message);
    } finally {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.pointerEvents = originalPointerEvents;
        btn.innerHTML = originalText;
    }
}

function showLyricsResults(results) {
    const modal = document.getElementById('lyrics-modal');
    const body = document.getElementById('lyrics-results-body');
    body.innerHTML = '';

    if (!results || results.length === 0) {
        body.innerHTML = '<tr><td colspan="4" style="padding:2rem; text-align:center;">No processing needed or no files found.</td></tr>';
    } else {
        results.forEach(res => {
            const tr = document.createElement('tr');
            tr.style.borderBottom = '1px solid rgba(255,255,255,0.05)';
            
            let statusStyle = 'color: var(--text-secondary)';
            let statusText = res.status;
            if (res.status === 'found') {
                statusStyle = 'color: #4ade80; font-weight: bold;';
                statusText = '✅ Found';
            } else if (res.status === 'not_found') {
                statusStyle = 'color: #f87171';
                statusText = '❌ Not Found';
            } else if (res.status === 'skipped') {
                statusStyle = 'color: #94a3b8; font-style: italic;';
                statusText = '⏭️ ' + (res.reason || 'Skipped');
            }

            const typeBadge = res.type === 'synced' ? 
                '<span class="badge" style="background: #06b6d4; color: white;">Synced</span>' : 
                (res.type === 'unsynced' ? '<span class="badge" style="background: #f59e0b; color: white;">Unsynced</span>' : '-');

