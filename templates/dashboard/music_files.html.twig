                        group.style.alignItems = 'stretch';
                        group.style.marginTop = '2px';
                        group.style.width = '100%';

                        input.style.flex = '1';
                        input.style.width = 'auto';
                        input.style.minWidth = '0';
                        input.style.marginTop = '0';
                        input.style.marginBottom = '0';
                        input.style.boxSizing = 'border-box';

                        const aiButton = document.createElement('button');
                        aiButton.type = 'button';
                        aiButton.className = 'btn btn-secondary';
                        aiButton.title = 'Update genre with AI';
                        aiButton.innerHTML = '✨';
                        aiButton.style.display = 'flex';
                        aiButton.style.alignItems = 'center';
                        aiButton.style.justifyContent = 'center';
                        aiButton.style.minWidth = '46px';
                        aiButton.style.padding = '0 0.85rem';
                        aiButton.style.margin = '0';
                        aiButton.style.fontSize = '1rem';
