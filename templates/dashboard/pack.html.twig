{% extends 'base.html.twig' %}

{% block body %}
<a href="{{ path('dashboard') }}" class="btn" style="background-color: var(--bg-card); color: var(--text-primary); margin-bottom: 1rem;">
    &larr; Back to Dashboard
</a>

{% embed '_partials/page_header.html.twig' with {
    title: magnet.filename,
    subtitle: 'Total size: ' ~ (magnet.size / 1024 / 1024 / 1024)|number_format(2) ~ ' GB',
    icon: 'package'
} %}
    {% block actions %}
        <span class="badge {{ magnet.status == 'Ready' ? 'badge-success' : 'badge-warning' }}">{{ magnet.status }}</span>
    {% endblock %}
{% endembed %}

<div class="grid">
    {% for file in files %}
        <div class="card" id="card-{{ file.filename|replace({'.': '_', ' ': '_', '(': '', ')': '', '[': '', ']': ''}) }}">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                <h3 style="font-size: 1rem; word-break: break-all; margin-right: 1rem;">{{ file.filename }}</h3>
                {% if file.downloaded %}
                    <span class="badge badge-success">Downloaded</span>
                {% endif %}
            </div>
            
            <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.5rem;">
                Size: {{ (file.size / 1024 / 1024)|number_format(2) }} MB
            </p>

            <div class="progress-container" style="display: none; margin-bottom: 1rem;">
                <div style="background-color: var(--bg-primary); height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 0.5rem;">
                    <div class="progress-bar" style="background-color: var(--accent); height: 100%; width: 0%; transition: width 0.5s;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary);">
                    <span class="progress-status">Starting...</span>
                    <span class="progress-speed">0 MB/s</span>
                </div>
            </div>

            <form class="download-form" action="{{ path('download') }}" method="post" onsubmit="startDownload(event, '{{ file.filename }}')">
                <input type="hidden" name="url" value="{{ file.link }}">
                <input type="hidden" name="filename" value="{{ file.filename }}">
                <!-- Will be populated by JS -->
                <input type="hidden" name="download_id" value="">
                
                <div style="margin-bottom: 0.5rem;">
                        <input type="text" name="path" placeholder="Override path (optional)" style="font-size: 0.8rem; padding: 0.5rem; margin-bottom: 0.5rem; width: 100%;">
                </div>

                {% if file.link %}
                    <button type="submit" class="btn btn-primary btn-full download-btn">
                        {% if file.downloaded %}Re-Download{% else %}Download{% endif %}
                    </button>
                {% else %}
                    <button type="button" class="btn btn-full" disabled style="opacity: 0.5; cursor: not-allowed;">
                        No Link Available
                    </button>
                {% endif %}
            </form>
        </div>
    {% endfor %}
</div>

<script>
// Generate a route template we can use in JS
// We use a placeholder '000000' that we will replace
const progressRouteTemplate = "{{ path('progress', {downloadId: '000000'}) }}";

function startDownload(event, filename) {
    event.preventDefault();
    const form = event.target;
    // Generate a unique ID for this download (simple random string)
    const downloadId = 'dl_' + Math.random().toString(36).substr(2, 9);
    form.querySelector('input[name="download_id"]').value = downloadId;

    // Sanitize filename for ID selector (same as Twig filter)
    const safeFilename = filename.replace(/[\.\s\(\)\[\]]/g, '_');
    const cardId = 'card-' + safeFilename; 
    const card = document.getElementById(cardId);
    
    if (!card) {
        console.error('Card not found for ID:', cardId);
        return; 
    }

    const btn = form.querySelector('.download-btn');
    const progressContainer = card.querySelector('.progress-container');
    const progressBar = card.querySelector('.progress-bar');
    const statusText = card.querySelector('.progress-status');
    const speedText = card.querySelector('.progress-speed');

    // UI State: Downloading
    if(btn) btn.style.display = 'none';
    progressContainer.style.display = 'block';
    const pathInput = form.querySelector('input[name="path"]');
    if(pathInput) pathInput.disabled = true;
    
    // Reset bar
    progressBar.style.width = '0%';
    statusText.innerText = '0%';
    speedText.innerText = 'Starting...';

    // Start polling immediately
    let pollInterval = setInterval(() => {
        // Construct the correct URL using the template
        const pollUrl = progressRouteTemplate.replace('000000', downloadId);
        
        fetch(pollUrl)
            .then(res => res.json())
            .then(data => {
                if (data.status === 'downloading') {
                    progressBar.style.width = data.percentage + '%';
                    statusText.innerText = data.percentage + '%';
                    speedText.innerText = data.speed;
                } else if (data.status === 'complete') {
                        progressBar.style.width = '100%';
                        statusText.innerText = '100%';
                        speedText.innerText = 'Complete';
                }
            })
            .catch(err => {
                console.error('Poll error', err);
                speedText.innerText = 'Poll Error';
            });
    }, 1000);

    // Send Download Request
    const formData = new FormData(form);
    
    fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(res => res.json())
    .then(data => {
        clearInterval(pollInterval);
        if (data.success) {
            progressBar.style.width = '100%';
            statusText.innerText = 'Completed';
            speedText.innerText = '';
            // Ideally switch badge to downloaded
            setTimeout(() => {
                    location.reload(); // Refresh to update status/badge cleanly
            }, 1000);
        } else {
            alert('Error: ' + data.message);
            resetUI(btn, progressContainer, form);
        }
    })
    .catch(err => {
        clearInterval(pollInterval);
        console.error(err);
        alert('Request failed');
        resetUI(btn, progressContainer, form);
    });
}

function resetUI(btn, container, form) {
    if(btn) btn.style.display = 'block';
    if(container) container.style.display = 'none';
    const pathInput = form.querySelector('input[name="path"]');
    if(pathInput) pathInput.disabled = false;
}
</script>
{% endblock %}
