{% extends 'base.html.twig' %}

{% block title %}Queue Management{% endblock %}

{% block body %}
{% embed '_partials/page_header.html.twig' with {
    title: 'Queue Management',
        subtitle: 'Monitor and control the download worker state.',
        icon: 'queue'
    } %}
        {% block actions %}
            <button class="btn btn-purge" onclick="purgeQueue()" style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                Purge All Tasks
            </button>
        {% endblock %}
    {% endembed %}

    <div class="grid" style="grid-template-columns: 1fr;">
        <!-- Active Section -->
        <div class="card shadow-lg" style="margin-bottom: 2rem; border-left: 4px solid var(--success);">
            <h3 style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <span class="badge badge-success">NOW PROCESSING</span>
            </h3>
            <div id="active-task-container">
                <p class="empty-msg">No active task.</p>
            </div>
            
            <!-- Real-time Log Viewer (Hidden by default) -->
            <div id="log-viewer-container" style="display: none; margin-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1.5rem;">
                <h4 style="margin: 0 0 1rem 0; font-size: 0.9rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em;">Console Output</h4>
                <div id="log-content" style="background: #000; color: #0f0; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 0.8rem; padding: 1rem; border-radius: 8px; height: 300px; overflow-y: auto; white-space: pre-wrap; line-height: 1.4; border: 1px solid rgba(0,255,0,0.1);">
                    Initializing log viewer...
                </div>
            </div>
        </div>

        <!-- Queue Section -->
        <div class="card shadow-lg">
            <h3 style="margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                Upcoming in Queue
                <span id="queue-count-badge" class="badge" style="background: rgba(255,255,255,0.05); color: var(--text-secondary);">0</span>
            </h3>
            <div class="queue-table-container" style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                        <tr>
                            <th style="padding: 1rem; color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase;">Type</th>
                            <th style="padding: 1rem; color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase;">Filename</th>
                            <th class="hide-mobile" style="padding: 1rem; color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase;">Path</th>
                            <th class="hide-mobile" style="padding: 1rem; color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase;">Added At</th>
                            <th style="padding: 1rem; color: var(--text-secondary); font-size: 0.8rem; text-transform: uppercase; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="queue-tbody">
                        <!-- Dynamic -->
                        <tr><td colspan="5" style="padding: 2rem; text-align: center; color: var(--text-secondary);">Queue is empty</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<script>


function getMediaIcon(type) {
    const mediaIcons = { 
        'music': '🎵', 'audio': '🎵', 'video': '🎥', 'text': '📄', 'ebook': '📚', 
        'archive': '📦', 'image': '💿', 'photo': '🖼️', 'other': '❓' 
    };
    return mediaIcons[type] || (type === 'music' || type === 'audio' ? '🎵' : '🎥');
}

async function purgeQueue() {
    if (!confirm('This will STOP all background downloads and clear the queue. Are you sure?')) return;
    try {
        const res = await fetch("{{ path('queue_purge') }}", { method: 'POST' });
        if (res.ok) {
            window.notify('success', 'Queue purged and worker reset.');
            refreshUI();
        }
    } catch (e) {
        window.notify('error', 'Failed to purge queue.');
    }
}

async function removeTask(index) {
    try {
        const res = await fetch(`{{ path('queue_remove', {index: 'IDX'}) }}`.replace('IDX', index), { method: 'POST' });
        if (res.ok) {
            window.notify('info', 'Task removed from queue.');
            refreshUI();
        }
    } catch (e) {
        window.notify('error', 'Failed to remove task.');
    }
}

let refreshInFlight = false;

async function refreshUI() {
    if (refreshInFlight) return;
    refreshInFlight = true;
    try {
        const res = await fetch("{{ path('queue_status') }}");
        const data = await res.json();
        
        await renderActive(data.active);
        renderQueueTable(data.queue || []);
    } catch (e) {
        console.warn("Refresh failed", e);
    } finally {
        refreshInFlight = false;
    }
}

async function renderActive(active) {
    const container = document.getElementById('active-task-container');
    if (!container) return;
    if (!active) {
        container.replaceChildren();
        const empty = document.createElement('p');
        empty.className = 'empty-msg';
        empty.textContent = 'No active task.';
        container.appendChild(empty);
        return;
    }

    try {
        const downloadId = String(active.download_id || active.downloadId || '');
        const res = await fetch(progressRouteTemplate.replace('000000', encodeURIComponent(downloadId)));
        const progress = await res.json();

        const filename = String(progress.filename || active.filename || active.override_filename || 'Initializing...');
        const typeIcon = getMediaIcon(active.type);
        const typeLabel = String(active.type || 'torrent').toUpperCase();
        const downloaded = Number(progress.downloaded || 0);
        const total = Number(progress.total || 0) > 0
            ? Number(progress.total)
            : (typeof parseHumanSizeBytes === 'function' ? parseHumanSizeBytes(active.size) : 0);
        const hasTotal = total > 0;
        const percentage = hasTotal ? Math.min(100, Math.round((downloaded / total) * 100)) : 0;
        const percentLabel = hasTotal ? percentage + '%' : '—';
        const formatBytes = bytes => {
            if (bytes >= 1024 * 1024 * 1024) return (bytes / 1024 / 1024 / 1024).toFixed(2) + ' GB';
            if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
            if (bytes >= 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return bytes + ' B';
        };
        const sizeLabel = hasTotal
            ? formatBytes(downloaded) + ' / ' + formatBytes(total)
            : (downloaded > 0 ? formatBytes(downloaded) : '');
        const statusLabel = progress.status === 'downloading'
            ? 'Transferring data...' + (sizeLabel ? ' ' + sizeLabel : '')
            : 'Contacting providers...';

        const wrapper = document.createElement('div');
        wrapper.className = 'active-task-wrapper';

        const icon = document.createElement('div');
        icon.className = 'active-task-icon';
        icon.textContent = typeIcon;

        const content = document.createElement('div');
        content.style.cssText = 'flex: 1; min-width: 0;';

        const badges = document.createElement('div');
        badges.style.cssText = 'display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;flex-wrap:wrap;';
        const typeBadge = document.createElement('span');
        typeBadge.className = 'badge ' + (active.type === 'music' ? 'badge-music' : 'badge-video');
        typeBadge.style.cssText = 'padding:0.2rem 0.6rem;font-size:0.7rem;';
        typeBadge.textContent = typeIcon + ' ' + typeLabel;
        const stateBadge = document.createElement('span');
        stateBadge.className = 'badge badge-success';
        stateBadge.style.cssText = 'padding:0.2rem 0.6rem;font-size:0.7rem;';
        stateBadge.textContent = 'NOW PROCESSING';
        badges.appendChild(typeBadge);
        badges.appendChild(stateBadge);

        const title = document.createElement('h4');
        title.className = 'active-task-title';
        title.textContent = filename;

        const meta = document.createElement('div');
        meta.className = 'active-task-meta';
        const pathLabel = document.createElement('span');
        pathLabel.className = 'active-task-path';
        pathLabel.textContent = 'Target: ';
        const pathCode = document.createElement('code');
        pathCode.style.cssText = 'background:rgba(255,255,255,0.08);padding:0.2rem 0.4rem;border-radius:4px;font-family:monospace;';
        pathCode.textContent = String(active.path || 'Default');
        pathLabel.appendChild(pathCode);
        const speed = document.createElement('span');
        speed.className = 'active-task-speed';
        speed.textContent = String(progress.speed || '...');
        meta.appendChild(pathLabel);
        meta.appendChild(speed);

        const progressOuter = document.createElement('div');
        progressOuter.style.cssText = 'height:14px;background:rgba(255,255,255,0.05);border-radius:7px;overflow:hidden;margin-bottom:0.5rem;border:1px solid rgba(255,255,255,0.03);';
        const progressBar = document.createElement('div');
        progressBar.style.cssText = 'width:' + percentage + '%;height:100%;background:linear-gradient(90deg,var(--accent),var(--success));transition:width 0.5s cubic-bezier(0.4,0,0.2,1);';
        progressOuter.appendChild(progressBar);

        const footer = document.createElement('div');
        footer.style.cssText = 'display:flex;justify-content:space-between;font-size:0.85rem;';
        const status = document.createElement('span');
        status.style.cssText = 'color:var(--text-secondary);font-style:italic;';
        status.textContent = statusLabel;
        const percent = document.createElement('span');
        percent.style.cssText = 'font-weight:800;color:var(--text-primary);';
        percent.textContent = percentLabel;
        footer.appendChild(status);
        footer.appendChild(percent);

        content.appendChild(badges);
        content.appendChild(title);
        content.appendChild(meta);
        content.appendChild(progressOuter);
        content.appendChild(footer);
        wrapper.appendChild(icon);
        wrapper.appendChild(content);
        container.replaceChildren(wrapper);
    } catch (e) {
        console.warn("Active progress fetch failed", e);
    }

    // Handle Music Logs
    const logContainer = document.getElementById('log-viewer-container');
    if (active.type === 'music') {
        logContainer.style.display = 'block';
        updateActiveLog();
    } else {
        logContainer.style.display = 'none';
    }
}

async function updateActiveLog() {
    try {
        const res = await fetch("{{ path('queue_active_log') }}");
        const data = await res.json();
        const content = document.getElementById('log-content');
        if (data.log) {
            const isAtBottom = content.scrollHeight - content.clientHeight <= content.scrollTop + 50;
            content.innerText = data.log;
            if (isAtBottom) content.scrollTop = content.scrollHeight;
        }
    } catch (e) {
        console.error("Log fetch failed", e);
    }
}

function renderQueueTable(queue) {
    const tbody = document.getElementById('queue-tbody');
    const badge = document.getElementById('queue-count-badge');
    const items = Array.isArray(queue) ? queue : [];
    if (!tbody) return;
    if (badge) badge.innerText = items.length;

    if (items.length === 0) {
        tbody.replaceChildren();
        const tr = document.createElement('tr');
        const td = document.createElement('td');
        td.colSpan = 5;
        td.style.cssText = 'padding:2rem;text-align:center;color:var(--text-secondary);';
        td.textContent = 'Queue is empty';
        tr.appendChild(td);
        tbody.appendChild(tr);
        return;
    }

    tbody.replaceChildren();
    items.forEach((item, index) => {
        const typeIcon = getMediaIcon(item.type);
        const notBefore = Number(item.not_before || 0);
        const isScheduled = notBefore > Math.floor(Date.now() / 1000);
        const scheduleLabel = isScheduled
            ? new Date(notBefore * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
            : '';

        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid rgba(255,255,255,0.03)';

        const typeCell = document.createElement('td');
        typeCell.style.cssText = 'padding:1rem;font-size:1.5rem;';
        typeCell.textContent = typeIcon;

        const fileCell = document.createElement('td');
        fileCell.style.padding = '1rem';
        const file = document.createElement('div');
        file.className = 'queue-filename';
        file.title = String(item.filename || '');
        file.appendChild(document.createTextNode(String(item.filename || '')));
        if (isScheduled) {
            const retry = document.createElement('div');
            retry.style.cssText = 'font-size:0.7rem;color:var(--warning);margin-top:0.3rem;';
            retry.textContent = 'Retry programmé à ' + scheduleLabel;
            file.appendChild(retry);
        }
        fileCell.appendChild(file);

        const pathCell = document.createElement('td');
        pathCell.className = 'hide-mobile';
        pathCell.style.cssText = 'padding:1rem;font-family:monospace;font-size:0.75rem;color:var(--text-secondary);';
        pathCell.textContent = String(item.path || '--');

        const dateCell = document.createElement('td');
        dateCell.className = 'hide-mobile';
        dateCell.style.cssText = 'padding:1rem;font-size:0.8rem;color:' + (isScheduled ? 'var(--warning)' : 'var(--text-secondary)') + ';';
        dateCell.textContent = isScheduled ? 'Retry ' + scheduleLabel : String(item.date_added || '--');

        const actionCell = document.createElement('td');
        actionCell.style.cssText = 'padding:1rem;text-align:right;';
        const button = document.createElement('button');
        button.className = 'btn btn-remove-task';
        button.type = 'button';
        button.textContent = 'Remove';
        button.addEventListener('click', () => removeTask(index));
        actionCell.appendChild(button);

        tr.appendChild(typeCell);
        tr.appendChild(fileCell);
        tr.appendChild(pathCell);
        tr.appendChild(dateCell);
        tr.appendChild(actionCell);
        tbody.appendChild(tr);
    });
}

document.addEventListener('DOMContentLoaded', () => {
    refreshUI();
    setInterval(refreshUI, 2000);
});
</script>

<style>
    .btn-purge {
        background: var(--danger);
        color: white;
    }

    .active-task-wrapper {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
    }

    .active-task-icon {
        font-size: 3.5rem;
        background: rgba(255,255,255,0.03);
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.05);
    }

    .active-task-title {
        margin: 0 0 0.5rem 0;
        font-size: 1.3rem;
        font-weight: 700;
        word-break: break-all;
    }

    .active-task-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .queue-filename {
        font-weight: 500;
        font-size: 0.9rem;
        max-width: 400px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-remove-task {
        padding: 0.4rem 0.8rem;
        font-size: 0.75rem;
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    @media (max-width: 768px) {
        .active-task-wrapper {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .active-task-icon {
            font-size: 2.5rem;
            padding: 0.75rem;
        }

        .active-task-meta {
            justify-content: center;
        }

        .hide-mobile {
            display: none !important;
        }

        .queue-filename {
            max-width: 150px;
        }
    }
</style>
{% endblock %}
