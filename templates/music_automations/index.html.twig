.ma-result-title{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ma-result-title strong{font-size:.92rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%}
.ma-result-meta{font-size:.78rem;color:#94a3b8;margin-top:2px}
.ma-badge{font-size:.64rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:2px 7px;border-radius:999px;border:1px solid transparent}
.ma-badge--public{background:rgba(34,197,94,.14);color:#4ade80;border-color:rgba(34,197,94,.3)}
.ma-badge--private{background:rgba(168,85,247,.14);color:#c084fc;border-color:rgba(168,85,247,.3)}
.ma-badge--on{background:rgba(34,197,94,.14);color:#4ade80}
.ma-badge--off{background:rgba(148,163,184,.14);color:#94a3b8}
.ma-btn{border-radius:10px;border:1px solid rgba(148,163,184,.28);background:transparent;color:#e2e8f0;padding:8px 13px;font-size:.8rem;cursor:pointer;white-space:nowrap}
.ma-btn:hover{border-color:#6366f1}
.ma-btn-primary{background:#4f46e5;border-color:#4f46e5;color:#fff}
.ma-btn-danger{border-color:rgba(248,113,113,.4);color:#fca5a5}
.ma-btn-ghost{background:rgba(148,163,184,.08)}
.ma-btn[disabled]{opacity:.55;cursor:not-allowed}
.ma-rule-list{display:grid;gap:12px}
.ma-rule{display:flex;gap:16px;justify-content:space-between;align-items:flex-start;border:1px solid rgba(148,163,184,.16);border-radius:14px;padding:14px;flex-wrap:wrap}
.ma-rule-main{flex:1;min-width:240px;display:flex;flex-direction:column;gap:6px}
.ma-rule-title{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.ma-rule-title h3{margin:0;font-size:.98rem}
.ma-rule-meta,.ma-rule-times{display:flex;gap:14px;flex-wrap:wrap;font-size:.78rem;color:#94a3b8}
.ma-rule-times{color:#64748b}
.ma-rule-summary{margin:2px 0 0;font-size:.8rem;color:#cbd5e1}
.ma-rule-status{font-weight:700;text-transform:capitalize}
.ma-rule-status--success,.ma-rule-status--no_changes{color:#4ade80}
.ma-rule-status--error{color:#f87171}
.ma-rule-status--skipped{color:#fbbf24}
.ma-rule-status--dry_run{color:#60a5fa}
.ma-rule-status--idle{color:#94a3b8}
.ma-rule-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.ma-empty,.ma-muted{color:#94a3b8;font-size:.86rem;margin:0}
.ma-table-wrap{overflow-x:auto}
.ma-table{width:100%;border-collapse:collapse;font-size:.8rem;min-width:640px}
.ma-table th,.ma-table td{text-align:left;padding:9px 10px;border-bottom:1px solid rgba(148,163,184,.12)}
.ma-table th{color:#94a3b8;font-weight:600;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em}
.ma-dialog{border:1px solid rgba(148,163,184,.28);border-radius:18px;background:#111827;color:#e2e8f0;padding:0;width:min(480px,94vw)}
.ma-dialog::backdrop{background:rgba(2,6,23,.72)}
.ma-dialog-form,.ma-dialog{padding:20px}
.ma-dialog-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px}
.ma-dialog-head h2{margin:2px 0 0;font-size:1.05rem}
.ma-icon-btn{background:transparent;border:1px solid rgba(148,163,184,.3);color:#cbd5e1;width:32px;height:32px;border-radius:9px;cursor:pointer;font-size:1.1rem;line-height:1}
.ma-field{display:flex;flex-direction:column;gap:5px;margin-bottom:11px}
.ma-field label{font-size:.78rem;color:#94a3b8}
.ma-field input,.ma-field select{padding:9px 11px;border-radius:9px;border:1px solid rgba(148,163,184,.28);background:#0f172a;color:#e2e8f0}
.ma-checkbox{display:flex;gap:8px;align-items:center;font-size:.85rem;margin:4px 0 12px}
.ma-dialog-error{background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.4);color:#fca5a5;padding:9px 11px;border-radius:9px;font-size:.82rem}
.ma-dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:8px}
.ma-preview-summary{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:12px;font-size:.82rem;color:#cbd5e1}
.ma-preview-summary strong{color:#fff}
.ma-preview-track{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid rgba(148,163,184,.12);font-size:.8rem}
.ma-preview-track span:last-child{color:#94a3b8}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:640px){.ma-rule-actions{width:100%;justify-content:flex-start}.ma-card{padding:16px}.ma-dialog{width:96vw}}
</style>

<script>
(() => {
    const csrfToken = window.csrfToken || '';
    const input = document.getElementById('ma-search-input');
    const results = document.getElementById('ma-search-results');
    const searchButton = document.getElementById('ma-search-button');
    const ruleDialog = document.getElementById('ma-rule-dialog');
    const previewDialog = document.getElementById('ma-preview-dialog');
    const previewBody = document.getElementById('ma-preview-body');
    const form = document.getElementById('ma-rule-form');
    const errorBox = document.getElementById('ma-dialog-error');
    const frequency = document.getElementById('ma-frequency');
    const timeField = document.getElementById('ma-time-field');
    const weekdayField = document.getElementById('ma-weekday-field');
    let scope = 'all';
    let searchTimer = null;

    const esc = (value) => String(value == null ? '' : value).replace(/[&<>"']/g, (char) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[char]));

    const api = async (url, options = {}) => {
        const response = await fetch(url, {
            credentials: 'same-origin',
            ...options,
            headers: {
                'Accept': 'application/json',
                ...(csrfToken ? {'X-CSRF-Token': csrfToken} : {}),
                ...(options.headers || {})
            }
        });
        let data = null;
        try { data = await response.json(); } catch (e) { data = {}; }
        if (!response.ok) {
            throw new Error(data.message || data.error || ('Request failed (' + response.status + ')'));
        }
        return data;
    };

    const toggleScheduleFields = () => {
        const value = frequency.value;
        timeField.hidden = value === '6h' || value === '12h';
        weekdayField.hidden = value !== 'weekly';
    };

    const renderResults = (data) => {
        const items = data.results || [];
        if (!items.length) {
            const message = data.message || data.private_error || data.public_error || 'No playlist found.';
            results.innerHTML = '<p class="ma-muted">' + esc(message) + '</p>';
            return;
        }
        results.innerHTML = items.map((item) => `
            <article class="ma-result">
                ${item.image ? '<img class="ma-result-art" src="' + esc(item.image) + '" alt="" loading="lazy">' : '<div class="ma-result-art ma-result-art--empty" aria-hidden="true">♪</div>'}
                <div class="ma-result-body">
                    <div class="ma-result-title">
                        <strong>${esc(item.name)}</strong>
                        <span class="ma-badge ma-badge--${esc(item.visibility)}">${esc(item.visibility)}</span>
                    </div>
                    <div class="ma-result-meta">${esc(item.owner || 'Unknown owner')} · ${esc(item.track_count || 0)} tracks</div>
                </div>
                <button type="button" class="ma-btn ma-btn-primary" data-automate='${esc(JSON.stringify(item))}'>Automate</button>
            </article>
        `).join('');
    };

    const performSearch = async () => {
        const query = input.value.trim();
        results.innerHTML = '<p class="ma-muted">Searching…</p>';
        try {
            const data = await api('{{ path('music_automations_search') }}?q=' + encodeURIComponent(query) + '&scope=' + encodeURIComponent(scope));
            renderResults(data);
        } catch (error) {
            results.innerHTML = '<p class="ma-muted">' + esc(error.message) + '</p>';
        }
    };

    const openRuleDialog = (item = null) => {
        form.reset();
        errorBox.hidden = true;
        document.getElementById('ma-rule-id').value = item && item.rule_id ? item.rule_id : '';
        document.getElementById('ma-playlist-id').value = item ? (item.id || '') : '';
        document.getElementById('ma-playlist-url').value = item ? (item.url || '') : '';
        document.getElementById('ma-visibility').value = item ? (item.visibility || 'public') : 'public';
        document.getElementById('ma-name').value = item ? (item.name || '') : '';
        document.getElementById('ma-owner').value = item ? (item.owner || '') : '';
        frequency.value = item && item.frequency ? item.frequency : 'daily';
        document.getElementById('ma-run-time').value = item && item.run_time ? item.run_time : '03:00';
        document.getElementById('ma-weekday').value = item && item.weekday ? String(item.weekday) : '1';
        document.getElementById('ma-enabled').checked = item && typeof item.enabled !== 'undefined' ? Boolean(item.enabled) : true;
        toggleScheduleFields();
        ruleDialog.showModal();
    };

    document.querySelectorAll('[data-scope]').forEach((tab) => {
        tab.addEventListener('click', () => {
            scope = tab.dataset.scope;
            document.querySelectorAll('[data-scope]').forEach((node) => {
                node.classList.toggle('is-active', node === tab);
                node.setAttribute('aria-selected', node === tab ? 'true' : 'false');
            });
            performSearch();
        });
    });

    input.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(performSearch, 350);
    });
    input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
            event.preventDefault();
            performSearch();
        }
    });
    searchButton.addEventListener('click', performSearch);

    results.addEventListener('click', (event) => {
        const button = event.target.closest('[data-automate]');
        if (!button) return;
        try {
            openRuleDialog(JSON.parse(button.dataset.automate));
        } catch (e) {
            openRuleDialog(null);
        }
    });

    frequency.addEventListener('change', toggleScheduleFields);

    document.querySelectorAll('[data-close-dialog]').forEach((button) => button.addEventListener('click', () => ruleDialog.close()));
    document.querySelectorAll('[data-close-preview]').forEach((button) => button.addEventListener('click', () => previewDialog.close()));
    ruleDialog.addEventListener('click', (event) => { if (event.target === ruleDialog) ruleDialog.close(); });
    previewDialog.addEventListener('click', (event) => { if (event.target === previewDialog) previewDialog.close(); });

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.hidden = true;
        const button = document.getElementById('ma-save-rule');
        button.disabled = true;
        try {
            const data = await api('{{ path('music_automations_save') }}', {method: 'POST', body: new FormData(form)});
            if (!data.success) {
                throw new Error(data.message || 'Could not save the rule.');
            }
            window.location.reload();
        } catch (error) {
            errorBox.textContent = error.message;
            errorBox.hidden = false;
            button.disabled = false;
        }
    });

    document.querySelectorAll('[data-edit-rule]').forEach((button) => {
        button.addEventListener('click', () => {
            try {
                const rule = JSON.parse(button.dataset.rule);
                openRuleDialog({
                    id: rule.playlist_id,
                    url: rule.playlist_url,
                    name: rule.name,
                    owner: rule.owner,
                    visibility: rule.visibility,
                    frequency: rule.frequency,
                    run_time: rule.run_time,
                    weekday: rule.weekday,
                    enabled: rule.enabled,
                    rule_id: rule.id
                });
            } catch (e) {
                errorBox.textContent = 'Could not read the rule.';
                errorBox.hidden = false;
            }
        });
    });

    document.querySelectorAll('[data-run-rule]').forEach((button) => {
        button.addEventListener('click', async () => {
            const ruleId = button.dataset.runRule;
            const mode = button.dataset.mode || 'dry';
            button.disabled = true;
            try {
                const data = await api('{{ path('music_automations_run') }}', {
                    method: 'POST',
                    body: new URLSearchParams({rule_id: ruleId, mode})
                });
                const summary = data.message || ((data.found || 0) + ' found, ' + (data.new || 0) + ' new, ' + (data.skipped || 0) + ' skipped.');
                const preview = Array.isArray(data.preview) ? data.preview : [];
                previewBody.innerHTML = '<p class="ma-preview-summary">' + esc(summary) + '</p>' + preview.map((track) => `
                    <div class="ma-preview-track"><span>${esc(track.artist)} — ${esc(track.song_name)}</span><span>${esc(track.album || '')}</span></div>
                `).join('');
                previewDialog.showModal();
                if (mode === 'enqueue') {
                    window.setTimeout(() => window.location.reload(), 1200);
                }
            } catch (error) {
                previewBody.innerHTML = '<p class="ma-muted">' + esc(error.message) + '</p>';
                previewDialog.showModal();
            } finally {
                button.disabled = false;
            }
        });
    });

    document.querySelectorAll('[data-delete-rule]').forEach((button) => {
        button.addEventListener('click', async () => {
            if (!window.confirm('Delete this music automation rule?')) return;
            button.disabled = true;
            try {
                await api('{{ path('music_automations_delete') }}', {
                    method: 'POST',
                    body: new URLSearchParams({rule_id: button.dataset.deleteRule})
                });
                window.location.reload();
            } catch (error) {
                window.alert(error.message);
                button.disabled = false;
            }
        });
    });

    document.querySelectorAll('[data-toggle-rule]').forEach((button) => {
        button.addEventListener('click', async () => {
            const card = button.closest('[data-rule-card]');
            const editButton = card ? card.querySelector('[data-edit-rule]') : null;
            if (!editButton) return;
            let rule = null;
            try { rule = JSON.parse(editButton.dataset.rule); } catch (e) { return; }
            button.disabled = true;
            const body = new URLSearchParams({
                rule_id: String(rule.id),
                playlist_id: rule.playlist_id,
                playlist_url: rule.playlist_url,
                name: rule.name,
                owner: rule.owner || '',
                visibility: rule.visibility || 'public',
                frequency: rule.frequency,
                run_time: rule.run_time || '03:00',
                weekday: String(rule.weekday || 1),
                enabled: rule.enabled ? '0' : '1'
            });
            try {
                await api('{{ path('music_automations_save') }}', {method: 'POST', body});
                window.location.reload();
            } catch (error) {
                window.alert(error.message);
                button.disabled = false;
            }
        });
    });
})();
</script>
{% endblock %}
