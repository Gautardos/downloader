{% extends 'base.html.twig' %}

{% block title %}Music Automations{% endblock %}

{% block body %}
<div class="ma-page">
    {% embed '_partials/page_header.html.twig' with {
        title: 'Music Automations',
        subtitle: 'Follow Spotify playlists and queue only the tracks that are not in your music library yet.',
        icon: 'music',
        icon_class: 'page-icon--music',
        badge: 'Playlist rules',
        badge_dot: false
    } %}{% endembed %}

    {% if not spotify_ready or not music_root_ready %}
        <div class="ma-alert" role="status">
            <strong>Configuration needed.</strong>
            {% if not spotify_ready %}Spotify credentials or the credentials file is missing.{% endif %}
            {% if not music_root_ready %}Set the music download path before enabling rules.{% endif %}
            <a href="{{ path('config') }}">Open settings</a>
        </div>
    {% endif %}

    <section class="ma-card" aria-labelledby="ma-search-title">
        <div class="ma-card-head">
            <div>
                <div class="ma-eyebrow">Playlist search</div>
                <h2 id="ma-search-title">Find a playlist</h2>
                <p>Search public Spotify playlists or pick one from your connected account.</p>
            </div>
            <span class="ma-timezone">Schedule timezone: <strong>{{ timezone }}</strong></span>
        </div>

        <div class="ma-search-row">
            <label class="ma-search-field">
                <span class="sr-only">Search playlists</span>
                <input type="search" id="ma-search-input" placeholder="Search playlists…" autocomplete="off" aria-label="Search playlists">
            </label>
            <button type="button" class="ma-btn ma-btn-primary" id="ma-search-button">Search</button>
        </div>

        <div class="ma-tabs" role="tablist" aria-label="Playlist source">
            <button type="button" class="ma-tab is-active" role="tab" aria-selected="true" data-scope="all">All</button>
            <button type="button" class="ma-tab" role="tab" aria-selected="false" data-scope="public">Public</button>
            <button type="button" class="ma-tab" role="tab" aria-selected="false" data-scope="private">My playlists</button>
        </div>

        <div class="ma-search-results" id="ma-search-results" aria-live="polite">
            <p class="ma-muted">Type a playlist name and choose a source tab.</p>
        </div>
    </section>

    <section class="ma-card" aria-labelledby="ma-rules-title">
        <div class="ma-card-head">
            <div>
                <div class="ma-eyebrow">Automations</div>
                <h2 id="ma-rules-title">Playlist rules</h2>
                <p>One rule per playlist. Destination, quality, lyrics and tags use your global music settings.</p>
            </div>
            <span class="ma-count">{{ rules|length }} rule{{ rules|length == 1 ? '' : 's' }}</span>
        </div>

        {% if rules is empty %}
            <p class="ma-empty">No rule yet. Search for a playlist above and choose <strong>Automate</strong>.</p>
        {% else %}
            <div class="ma-rule-list">
                {% for rule in rules %}
                    <article class="ma-rule" data-rule-card="{{ rule.id }}">
                        <div class="ma-rule-main">
                            <div class="ma-rule-title">
                                <h3>{{ rule.name }}</h3>
                                <span class="ma-badge ma-badge--{{ rule.visibility }}">{{ rule.visibility }}</span>
                                {% if rule.enabled %}
                                    <span class="ma-badge ma-badge--on">Active</span>
                                {% else %}
                                    <span class="ma-badge ma-badge--off">Paused</span>
                                {% endif %}
                            </div>
                            <div class="ma-rule-meta">
                                <span>{{ rule.owner ?: 'Unknown owner' }}</span>
                                <span>{{ rule.schedule_label }}</span>
                                <span class="ma-rule-status ma-rule-status--{{ rule.last_status ?: 'idle' }}">{{ rule.last_status ?: 'Never run' }}</span>
                            </div>
                            <div class="ma-rule-times">
                                <span>Last run: {{ rule.last_run_at ?: '—' }} UTC</span>
                                <span>Next run: {{ rule.next_run_at ?: '—' }} UTC</span>
                            </div>
                            {% if rule.last_summary %}
                                <p class="ma-rule-summary">{{ rule.last_summary }}</p>
                            {% endif %}
                        </div>
                        <div class="ma-rule-actions">
                            <button type="button" class="ma-btn ma-btn-ghost" data-run-rule="{{ rule.id }}" data-mode="dry">Dry run</button>
                            <button type="button" class="ma-btn ma-btn-ghost" data-run-rule="{{ rule.id }}" data-mode="enqueue">Run now</button>
                            <button type="button" class="ma-btn ma-btn-ghost" data-edit-rule data-rule="{{ rule|json_encode|e('html_attr') }}">Edit</button>
                            <button type="button" class="ma-btn ma-btn-ghost" data-toggle-rule="{{ rule.id }}" data-enabled="{{ rule.enabled ? '1' : '0' }}">
                                {{ rule.enabled ? 'Pause' : 'Resume' }}
                            </button>
                            <button type="button" class="ma-btn ma-btn-danger" data-delete-rule="{{ rule.id }}">Delete</button>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="ma-card" aria-labelledby="ma-runs-title">
        <div class="ma-card-head">
            <div>
                <div class="ma-eyebrow">Activity</div>
                <h2 id="ma-runs-title">Recent runs</h2>
            </div>
        </div>
        {% if runs is empty %}
            <p class="ma-empty">No run recorded yet.</p>
        {% else %}
            <div class="ma-table-wrap">
                <table class="ma-table">
                    <thead>
                        <tr>
                            <th>Started</th>
                            <th>Rule</th>
                            <th>Trigger</th>
                            <th>Status</th>
                            <th>Found</th>
                            <th>New</th>
                            <th>Skipped</th>
                            <th>Queued</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for run in runs %}
                            <tr>
                                <td>{{ run.started_at }} UTC</td>
                                <td>#{{ run.rule_id }}</td>
                                <td>{{ run.trigger }}</td>
                                <td><span class="ma-rule-status ma-rule-status--{{ run.status }}">{{ run.status }}</span></td>
                                <td>{{ run.found }}</td>
                                <td>{{ run.new }}</td>
                                <td>{{ run.skipped }}</td>
                                <td>{{ run.queued }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>

<dialog id="ma-rule-dialog" class="ma-dialog" aria-labelledby="ma-rule-dialog-title">
    <form method="dialog" class="ma-dialog-form" id="ma-rule-form">
        <div class="ma-dialog-head">
            <div>
                <div class="ma-eyebrow">Automation</div>
                <h2 id="ma-rule-dialog-title">Schedule this playlist</h2>
            </div>
            <button type="button" class="ma-icon-btn" data-close-dialog aria-label="Close dialog">×</button>
        </div>

        <input type="hidden" name="rule_id" id="ma-rule-id" value="">
        <input type="hidden" name="playlist_id" id="ma-playlist-id" value="">
        <input type="hidden" name="playlist_url" id="ma-playlist-url" value="">
        <input type="hidden" name="visibility" id="ma-visibility" value="public">

        <div class="ma-field">
            <label for="ma-name">Playlist</label>
            <input type="text" name="name" id="ma-name" maxlength="200" readonly>
        </div>
        <div class="ma-field">
            <label for="ma-owner">Owner</label>
            <input type="text" name="owner" id="ma-owner" maxlength="200" readonly>
        </div>
        <div class="ma-field">
            <label for="ma-frequency">Frequency</label>
            <select name="frequency" id="ma-frequency">
                {% for frequency in frequencies %}
                    <option value="{{ frequency }}">{{ frequency == '6h' ? 'Every 6 hours' : (frequency == '12h' ? 'Every 12 hours' : (frequency == 'daily' ? 'Daily' : 'Weekly')) }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="ma-field" id="ma-time-field">
            <label for="ma-run-time">Run time ({{ timezone }})</label>
            <input type="time" name="run_time" id="ma-run-time" value="03:00">
        </div>
        <div class="ma-field" id="ma-weekday-field" hidden>
            <label for="ma-weekday">Weekday</label>
            <select name="weekday" id="ma-weekday">
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
                <option value="7">Sunday</option>
            </select>
        </div>
        <label class="ma-checkbox">
            <input type="checkbox" name="enabled" id="ma-enabled" value="1" checked>
            <span>Rule is active</span>
        </label>

        <p class="ma-dialog-error" id="ma-dialog-error" role="alert" hidden></p>

        <div class="ma-dialog-actions">
            <button type="button" class="ma-btn ma-btn-ghost" data-close-dialog>Cancel</button>
            <button type="submit" class="ma-btn ma-btn-primary" id="ma-save-rule">Save rule</button>
        </div>
    </form>
</dialog>

<dialog id="ma-preview-dialog" class="ma-dialog" aria-labelledby="ma-preview-title">
    <div class="ma-dialog-head">
        <div>
            <div class="ma-eyebrow">Dry run</div>
            <h2 id="ma-preview-title">Preview</h2>
        </div>
        <button type="button" class="ma-icon-btn" data-close-preview aria-label="Close preview">×</button>
    </div>
    <div id="ma-preview-body"></div>
</dialog>

<style>
.ma-page{display:flex;flex-direction:column;gap:18px}
.ma-card{background:var(--bg-secondary);border:1px solid rgba(148,163,184,.18);border-radius:18px;padding:20px;display:flex;flex-direction:column;gap:16px}
.ma-card-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap}
.ma-card-head h2{margin:2px 0 4px;font-size:1.15rem}
.ma-card-head p{margin:0;color:#94a3b8;font-size:.9rem}
.ma-eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.68rem;font-weight:700;color:#818cf8}
.ma-timezone,.ma-count{font-size:.8rem;color:#94a3b8}
.ma-alert{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.4);color:#fbbf24;padding:12px 16px;border-radius:12px;font-size:.9rem}
.ma-alert a{color:#fde68a;margin-left:6px}
.ma-search-row{display:flex;gap:10px;flex-wrap:wrap;align-items:stretch}
.ma-search-field{flex:1;min-width:220px;display:flex}
.ma-search-field input{width:100%;height:44px;padding:0 14px;border-radius:11px;border:1px solid rgba(148,163,184,.28);background:var(--bg-primary);color:var(--text-primary,#e2e8f0);box-sizing:border-box}
.ma-search-row .ma-btn{height:44px;padding:0 20px;box-sizing:border-box}
.ma-tabs{display:flex;gap:6px;flex-wrap:wrap}
.ma-tab{border:1px solid rgba(148,163,184,.24);background:transparent;color:#cbd5e1;padding:7px 14px;border-radius:999px;cursor:pointer;font-size:.82rem}
.ma-tab.is-active{background:#4f46e5;border-color:#4f46e5;color:#fff}
.ma-search-results{display:grid;gap:10px}
.ma-result{display:flex;gap:12px;align-items:center;border:1px solid rgba(148,163,184,.16);border-radius:13px;padding:10px 12px;background:rgba(15,23,42,.4)}
.ma-result-art{width:46px;height:46px;border-radius:9px;object-fit:cover;background:#1f2937;flex-shrink:0}
.ma-result-art--empty{display:flex;align-items:center;justify-content:center;color:#64748b;font-size:1.1rem}
