    </style>

    <script>
        const progressRouteTemplate = "{{ path('progress', {downloadId: '000000'}) }}";
        const queueStatusRoute = "{{ path('queue_status') }}";
        const queueRemoveRouteTemplate = "{{ path('queue_remove', {index: 'IDX'}) }}";
        const notificationsAckRoute = "{{ path('notifications_ack') }}";
        const csrfToken = "{{ csrf_token|default('')|e('js') }}";
        window.csrfToken = csrfToken;

        (function () {
            const originalFetch = window.fetch.bind(window);
            function isSameOrigin(value) {
                try {
                    const url = new URL(value, window.location.href);
                    return url.origin === window.location.origin;
                } catch (e) {
                    return false;
                }
            }

            window.fetch = function (input, init) {
                const options = init ? { ...init } : {};
                const requestUrl = input instanceof Request ? input.url : String(input);
                const method = String(options.method || (input instanceof Request ? input.method : 'GET')).toUpperCase();
                if (csrfToken && isSameOrigin(requestUrl) && ['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {
                    const headers = new Headers(options.headers || (input instanceof Request ? input.headers : undefined));
                    if (!headers.has('X-CSRF-Token')) {
                        headers.set('X-CSRF-Token', csrfToken);
                    }
                    options.headers = headers;
                    if (input instanceof Request) {
                        input = new Request(input, options);
                        return originalFetch(input);
                    }
                }

                return originalFetch(input, options);
            };

            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('form').forEach(form => {
                    if ((form.getAttribute('method') || 'get').toLowerCase() !== 'post') {
                        return;
                    }
                    if (form.querySelector('input[name="_token"]')) {
                        return;
                    }
                    const action = form.getAttribute('action') || window.location.href;
                    if (!isSameOrigin(action)) {
                        return;
                    }
                    const field = document.createElement('input');
                    field.type = 'hidden';
                    field.name = '_token';
                    field.value = csrfToken;
                    form.appendChild(field);
                });
            });
        })();

        // Queue State (UI only)
        let serverQueue = [];
        let serverActiveTask = null;

        function parseHumanSizeBytes(value) {
            if (typeof value === 'number') return Number.isFinite(value) ? value : 0;
            if (value === null || value === undefined || value === '') return 0;
            const match = String(value).trim().match(/^([0-9]+(?:\.[0-9]+)?)\s*(B|KB|MB|GB|TB)?$/i);
            if (!match) return 0;
            const units = { B: 1, KB: 1024, MB: 1024 ** 2, GB: 1024 ** 3, TB: 1024 ** 4 };
            return Math.round(parseFloat(match[1]) * (units[(match[2] || 'B').toUpperCase()] || 1));
        }

        function toggleTracker() {
            const el = document.getElementById('download-tracker');
            el.classList.toggle('collapsed');
            localStorage.setItem('tracker_collapsed', el.classList.contains('collapsed'));
            document.getElementById('tracker-toggle-btn').innerText = el.classList.contains('collapsed') ? '▲' : '▼';
        }

        function updateTrackerSummary() {
            const activeCount = serverActiveTask ? 1 : 0;
            const queuedCount = serverQueue.length;
            document.getElementById('tracker-summary').innerText = `(${activeCount} active, ${queuedCount} queued)`;
            const dot = document.getElementById('tracker-activity-dot');
            if (dot) dot.hidden = activeCount === 0;
            updateQueueNavDot(activeCount, queuedCount);
        }

        function updateQueueNavDot(activeCount, queuedCount) {
            const dot = document.getElementById('queue-nav-dot');
            if (!dot) return;
            const busy = activeCount > 0 || queuedCount > 0;
            dot.hidden = !busy;
            dot.title = activeCount > 0
                ? 'Download in progress'
                : (queuedCount > 0 ? queuedCount + ' queued' : '');
        }

        function renderQueue(queue) {
            serverQueue = Array.isArray(queue) ? queue : [];
            const list = document.getElementById('queued-downloads-list');
            if (!list) return;
            list.replaceChildren();

            if (serverQueue.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'empty-msg';
                empty.textContent = 'Queue is empty';
                list.appendChild(empty);
                updateTrackerSummary();
                return;
            }

            serverQueue.forEach((item, index) => {
                const mediaIcons = {
                    'music': '🎵', 'video': '🎥', 'text': '📄', 'ebook': '📚',
                    'archive': '📦', 'image': '💿', 'photo': '🖼️', 'other': '❓'
                };
                const typeIcon = mediaIcons[item.type] || (item.type === 'music' ? '🎵' : '🎥');
                const typeLabel = String(item.type || 'torrent').toUpperCase();
                const notBefore = Number(item.not_before || 0);
                const isScheduled = notBefore > Math.floor(Date.now() / 1000);
                const scheduleLabel = isScheduled
                    ? new Date(notBefore * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                    : '';

                const div = document.createElement('div');
                div.className = 'queued-item';

                const name = document.createElement('div');
                name.className = 'item-name';
                name.title = String(item.filename || '');

                const badge = document.createElement('span');
                badge.className = 'badge ' + (item.type === 'music' ? 'badge-music' : 'badge-video');
                badge.style.cssText = 'padding: 0.1rem 0.4rem; font-size: 0.6rem; margin-right: 0.4rem;';
                badge.textContent = typeIcon + ' ' + typeLabel;
                name.appendChild(badge);
                name.appendChild(document.createTextNode(' ' + String(item.filename || '')));

                if (isScheduled) {
                    const retry = document.createElement('div');
                    retry.style.cssText = 'font-size: 0.65rem; color: var(--warning); margin-top: 0.25rem;';
                    retry.textContent = 'Retry programmé à ' + scheduleLabel;
                    name.appendChild(retry);
                }

                const button = document.createElement('button');
                button.className = 'btn-remove';
                button.type = 'button';
                button.textContent = '×';
                button.addEventListener('click', () => removeFromQueue(index));

                div.appendChild(name);
                div.appendChild(button);
                list.appendChild(div);
            });
            updateTrackerSummary();
        }

        async function removeFromQueue(index) {
            try {
                const res = await fetch(queueRemoveRouteTemplate.replace('IDX', index), { method: 'POST' });
                if (res.ok) syncWithServer();
            } catch (e) {
                console.error("Failed to remove item", e);
            }
        }

        async function syncWithServer() {
            try {
                const res = await fetch(queueStatusRoute);
                const data = await res.json();
                
                renderQueue(data.queue || []);
                updateActiveTaskUI(data.active);
            } catch (e) {
                console.warn("Sync failed", e);
            }
        }

        async function updateActiveTaskUI(active) {
            const list = document.getElementById('active-downloads-list');
            if (!list) return;
            serverActiveTask = active;

            if (!active) {
                list.replaceChildren();
                const empty = document.createElement('div');
                empty.className = 'empty-msg';
                empty.textContent = 'No active downloads';
                list.appendChild(empty);
                updateTrackerSummary();
                return;
            }

            try {
                const downloadId = String(active.download_id || active.downloadId || '');
                const res = await fetch(progressRouteTemplate.replace('000000', encodeURIComponent(downloadId)));
                const progress = await res.json();

                const filename = String(progress.filename || active.filename || active.override_filename || 'Initializing...');
                const mediaIcons = {
                    'music': '🎵', 'audio': '🎵', 'video': '🎥', 'text': '📄', 'ebook': '📚',
                    'archive': '📦', 'image': '💿', 'photo': '🖼️', 'other': '❓'
                };
                const typeIcon = mediaIcons[active.type] || (active.type === 'music' || active.type === 'audio' ? '🎵' : '🎥');
                const typeLabel = String(active.type || 'torrent').toUpperCase();
                const isMusic = active.type === 'music';
                const downloaded = Number(progress.downloaded || 0);
                const total = Number(progress.total || 0) > 0 ? Number(progress.total) : parseHumanSizeBytes(active.size);
                const percentage = total > 0 ? Math.min(100, Math.round((downloaded / total) * 100)) : 0;
                const hasTotal = total > 0;
                const formatBytes = bytes => {
                    if (bytes >= 1024 * 1024 * 1024) return (bytes / 1024 / 1024 / 1024).toFixed(2) + ' GB';
                    if (bytes >= 1024 * 1024) return (bytes / 1024 / 1024).toFixed(1) + ' MB';
                    if (bytes >= 1024) return (bytes / 1024).toFixed(1) + ' KB';
                    return bytes + ' B';
                };
                const percentLabel = hasTotal ? percentage + '%' : '—';
                const sizeLabel = hasTotal
                    ? formatBytes(downloaded) + ' / ' + formatBytes(total)
                    : (downloaded > 0 ? formatBytes(downloaded) : '');
                const statusLabel = isMusic
                    ? 'See Queue for full logs'
                    : (progress.status === 'downloading'
                        ? 'Downloading...' + (sizeLabel ? ' ' + sizeLabel : '')
                        : 'Starting...');

                const item = document.createElement('div');
                item.className = 'active-item';
                if (downloadId !== '') item.id = 'active-' + downloadId;

                const header = document.createElement('div');
                header.style.cssText = 'display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem';
                const typeBadge = document.createElement('span');
                typeBadge.className = 'badge ' + (isMusic ? 'badge-music' : 'badge-video');
                typeBadge.style.cssText = 'padding:0.2rem 0.6rem;font-size:0.7rem;';
                typeBadge.textContent = typeIcon + ' ' + typeLabel;
                const stateBadge = document.createElement('span');
                stateBadge.className = 'badge badge-success';
                stateBadge.style.cssText = 'padding:0.2rem 0.6rem;font-size:0.7rem;';
                stateBadge.textContent = isMusic ? 'PROCESSING' : 'DOWNLOADING';
                header.appendChild(typeBadge);
                header.appendChild(stateBadge);

                const itemHeader = document.createElement('div');
                itemHeader.className = 'item-header';
                const name = document.createElement('span');
                name.className = 'item-name';
                name.title = filename;
                name.style.cssText = 'font-size:0.9rem;font-weight:600;font-family:' + (isMusic ? 'monospace' : 'inherit') + ';';
                name.textContent = filename;
                itemHeader.appendChild(name);
                if (!isMusic) {
                    const percent = document.createElement('span');
                    percent.className = 'item-percent';
                    percent.style.cssText = 'font-weight:bold;color:var(--accent);';
                    percent.textContent = percentLabel;
                    itemHeader.appendChild(percent);
                }

                const progressWrap = document.createElement('div');
                progressWrap.className = 'item-progress';
                if (isMusic) progressWrap.style.cssText = 'height:2px;opacity:0.5;';
                const bar = document.createElement('div');
                bar.className = 'bar ' + (isMusic ? 'pulsing' : (!hasTotal ? 'indeterminate' : ''));
                bar.style.width = (isMusic ? '100' : (hasTotal ? percentage : '32')) + '%';
                progressWrap.appendChild(bar);

                const footer = document.createElement('div');
                footer.className = 'item-footer';
                const status = document.createElement('span');
                status.className = 'item-status';
                status.textContent = statusLabel;
                const speed = document.createElement('span');
                speed.className = 'item-speed';
                speed.textContent = String(progress.speed || '...');
                footer.appendChild(status);
                footer.appendChild(speed);

                item.appendChild(header);
                item.appendChild(itemHeader);
                item.appendChild(progressWrap);
                item.appendChild(footer);
                list.replaceChildren(item);
            } catch (e) {
                console.warn("Progress update failed", e);
            }
            updateTrackerSummary();
        }

        const notificationMediaIcons = {
            'music': '🎵', 'audio': '🎵', 'video': '🎥', 'text': '📄', 'ebook': '📚',
            'archive': '📦', 'image': '💿', 'photo': '🖼️', 'other': '❓', 'default': '📦'
        };
        const notificationStatusEmojis = { 'success': '✅', 'error': '❌', 'warning': '⚠️', 'info': 'ℹ️', 'Finished': '✨', 'Started': '🚀', 'Failed': '❌' };

        function safeNotificationType(value) {
            const type = String(value || 'info').toLowerCase();
            return ['success', 'error', 'warning', 'info'].includes(type) ? type : 'info';
        }

        function notificationEmoji(type, action = '') {
            return notificationStatusEmojis[String(action || '')]
                || notificationStatusEmojis[String(type || '')]
                || 'ℹ️';
        }

        function notificationIcon(mediaType) {
            return notificationMediaIcons[String(mediaType || '')] || notificationMediaIcons.default;
        }

        function notificationTitle(log) {
            return String(log.action || 'Update') + ': ' + notificationIcon(log.mediaType) + ' ' + String(log.mediaType || '');
        }

        function notificationBody(log) {
            return String(log.item || log.message || '');
        }

        function renderNotification(log, container, prepend = false) {
            if (!container) return;

            const div = document.createElement('div');
            div.className = 'notif-item ' + safeNotificationType(log.type);

            const time = document.createElement('div');
            time.className = 'notif-time';
            time.textContent = String(log.time || '');

            const msg = document.createElement('div');
            msg.className = 'notif-msg';

            if (Number(log.version) === 2 && (log.action || log.mediaType || log.item)) {
                const row = document.createElement('div');
                row.style.cssText = 'display:flex;align-items:flex-start;gap:1rem;';

                const emoji = document.createElement('span');
                emoji.style.fontSize = '1.5rem';
                emoji.textContent = notificationEmoji(log.type, log.action);

                const body = document.createElement('div');
                const title = document.createElement('div');
                title.style.cssText = 'font-weight:bold;margin-bottom:2px;';
                title.textContent = notificationTitle(log);
                const text = document.createElement('div');
                text.style.cssText = 'font-size:0.85rem;opacity:0.9;word-break:break-all;';
                text.textContent = notificationBody(log);

                body.appendChild(title);
                body.appendChild(text);
                row.appendChild(emoji);
                row.appendChild(body);
                msg.appendChild(row);
            } else if (Number(log.version) === 2) {
                const strong = document.createElement('b');
                strong.textContent = notificationEmoji(log.type) + ' ' + String(log.message || '');
                msg.appendChild(strong);
            } else {
                msg.textContent = String(log.message || log.text || '');
            }

            div.appendChild(time);
            div.appendChild(msg);
            if (prepend) container.prepend(div);
            else container.appendChild(div);
        }

        function toggleNotifSidebar() {
            const sidebar = document.getElementById('notif-sidebar');
            if (!sidebar) return;
            sidebar.classList.toggle('open');
            if (sidebar.classList.contains('open')) {
                const dot = document.getElementById('notif-dot');
                if (dot) dot.style.display = 'none';
            }
        }

        function clearNotifications() {
            if (!confirm('Clear all logs?')) return;
            localStorage.setItem('notif_logs', '[]');
            const container = document.getElementById('notif-content');
            if (!container) return;
            container.replaceChildren();
            const empty = document.createElement('div');
            empty.className = 'empty-msg';
            empty.style.cssText = 'text-align: center; margin-top: 2rem; color: var(--text-secondary);';
            empty.textContent = 'No logs yet.';
            container.appendChild(empty);
        }

        window.notify = function(type, message) {
            const container = document.getElementById('notif-content');
            if (!container) return;
            const dot = document.getElementById('notif-dot');
            const sidebar = document.getElementById('notif-sidebar');

            if (container.querySelector('.empty-msg')) {
                container.replaceChildren();
            }

            const now = new Date().toLocaleTimeString();
            const isObject = message !== null && typeof message === 'object';
            const logType = safeNotificationType(isObject && message.type ? message.type : type);
            const action = isObject ? String(message.action || '') : '';
            const mediaType = isObject ? String(message.media_type || '') : '';
            const item = isObject ? String(message.item || '') : '';
            const text = isObject ? String(message.message || '') : String(message ?? '');

            const logEntry = {
                version: 2,
                type: logType,
                action,
                mediaType,
                item,
                message: text,
                time: now
            };

            let logs = [];
            try {
                logs = JSON.parse(localStorage.getItem('notif_logs') || '[]');
                if (!Array.isArray(logs)) logs = [];
            } catch (e) {
                logs = [];
            }
            logs.unshift(logEntry);
            localStorage.setItem('notif_logs', JSON.stringify(logs.slice(0, 100)));

            renderNotification(logEntry, container, true);

            if (sidebar && dot && !sidebar.classList.contains('open')) {
                dot.style.display = 'block';
            }

            const toastContainer = document.getElementById('toast-container');
            if (!toastContainer) return;
            const toast = document.createElement('div');
            toast.className = 'toast ' + logType;

            const toastEmoji = document.createElement('span');
            toastEmoji.style.fontSize = '1.25rem';
            toastEmoji.textContent = notificationEmoji(logType, action);

            const toastBody = document.createElement('div');
            toastBody.style.cssText = 'font-size:0.9rem;font-weight:500;word-break:break-word;';
            toastBody.textContent = item || text || action;

            toast.appendChild(toastEmoji);
            toast.appendChild(toastBody);
            toastContainer.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'toast-out 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards';
                setTimeout(() => toast.remove(), 300);
            }, 5000);

            if ('Notification' in window && Notification.permission === 'granted' && isObject) {
                new Notification(notificationEmoji(logType, action) + ' ' + String(action || 'Update') + ': ' + mediaType, {
                    body: item || text || '',
                    icon: '/logo.png',
                    tag: 'downloader-update'
                }).onclick = function() {
                    window.focus();
                    this.close();
                };
            }
        };

        async function requestBrowserNotifications() {
            if (!("Notification" in window)) {
                alert("This browser does not support desktop notification");
                return;
            }

            const permission = await Notification.requestPermission();
            if (permission === "granted") {
                document.getElementById('btn-browser-notif').style.display = 'none';
                new Notification("Notifications Enabled!", {
                    body: "You will now receive desktop alerts for downloads.",
                    icon: '/logo.png'
                });
            }
        }

        function toggleBurger() {
            document.getElementById('nav-links').classList.toggle('active');
        }

        document.addEventListener('DOMContentLoaded', () => {
            let logs = [];
            try {
                logs = JSON.parse(localStorage.getItem('notif_logs') || '[]');
                if (!Array.isArray(logs)) logs = [];
            } catch (e) {
                logs = [];
            }
            const container = document.getElementById('notif-content');
            if (logs.length > 0 && container) {
                container.replaceChildren();
                logs.forEach(log => renderNotification(log, container));
            }

            const seenNotificationsKey = 'notif_server_seen_ids';
            async function pollServerNotifications() {
                try {
                    const res = await fetch("{{ path('notifications_poll') }}");
                    const data = await res.json();
                    const notifications = Array.isArray(data.notifications) ? data.notifications : [];
                    if (notifications.length === 0) {
                        return;
                    }

                    let seen = [];
                    try {
                        seen = JSON.parse(localStorage.getItem(seenNotificationsKey) || '[]');
                    } catch (e) {
                        seen = [];
                    }
                    const seenSet = new Set(seen.map(String));
                    const ids = [];

                    notifications.forEach(notif => {
                        const id = String(notif.id || '');
                        if (id && seenSet.has(id)) {
                            ids.push(id);
                            return;
                        }
                        if (window.notify) {
                            window.notify(notif.type, notif);
                        }
                        if (id) {
                            seenSet.add(id);
                            ids.push(id);
                        }
                    });

                    localStorage.setItem(seenNotificationsKey, JSON.stringify(Array.from(seenSet).slice(-500)));

                    if (ids.length > 0) {
                        await fetch(notificationsAckRoute, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': csrfToken
                            },
                            body: JSON.stringify({ csrf: csrfToken, ids })
                        });
                    }
                } catch (e) {
                    console.error("Failed to poll notifications", e);
                }
            }

        // Initialize
        const tracker = document.getElementById('download-tracker');
        const trackerToggle = document.getElementById('tracker-toggle-btn');
        if (tracker && trackerToggle) {
            if (localStorage.getItem('tracker_collapsed') === 'true') {
                tracker.classList.add('collapsed');
                trackerToggle.innerText = '▲';
            } else {
                tracker.classList.remove('collapsed');
                trackerToggle.innerText = '▼';
            }
        }

        {% if app.session and app.session.get('authenticated') %}
        syncWithServer();
        setInterval(syncWithServer, 3000);
        setInterval(pollServerNotifications, 5000);
        {% endif %}

        if (Notification.permission === "granted") {
            const btn = document.getElementById('btn-browser-notif');
            if (btn) btn.style.display = 'none';
        }
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
