<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Downloader{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="/logo.svg">
    <link rel="icon" type="image/png" href="/logo.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent: #38bdf8;
            --accent-hover: #0ea5e9;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
            --glass: rgba(30, 41, 59, 0.7);
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            margin: 0;
            padding: 0;
            min-height: 100vh;
            overflow-x: hidden; /* Prevent menu overflow */
        }

        html {
            overflow-x: hidden;
        }

        @media (max-width: 768px) {
            body {
                padding-bottom: 80px; /* Space for sticky download bar */
            }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            transition: padding 0.2s;
        }

        .page-content {
            padding-bottom: 8rem;
        }

        @media (max-width: 768px) {
            .page-content {
                padding-bottom: 10rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
        }

        /* Navbar */
        nav {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0.75rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
        }

        nav a {
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 500;
            margin-left: 1.5rem;
            transition: color 0.2s;
        }

        nav a:hover {
            color: var(--accent);
            background: rgba(255,255,255,0.05);
        }

        /* Burger Menu Styles */
        .burger-btn {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 0.5rem;
            z-index: 5000;
        }

        .burger-btn span {
            width: 25px;
            height: 2px;
            background: var(--text-primary);
            transition: 0.3s;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        @media (max-width: 900px) {
            .burger-btn { display: flex; }
            .nav-links {
                position: fixed;
                top: 0;
                right: 0;
                width: 280px;
                height: 100vh;
                background: var(--bg-secondary);
                flex-direction: column;
                padding-top: 5rem;
                transform: translateX(100%);
                visibility: hidden;
                pointer-events: none;
                transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.3s;
                box-shadow: -10px 0 30px rgba(0,0,0,0.5);
                z-index: 4000;
                gap: 0;
                align-items: center; /* Center items */
                text-align: center;
            }
            .nav-links.active { 
                transform: translateX(0); 
                visibility: visible;
                pointer-events: auto;
            }
            .nav-links a {
                width: 100%;
                padding: 1.8rem 2rem;
                margin: 0;
                border-bottom: 1px solid rgba(255,255,255,0.03);
                font-size: 1.2rem;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 1rem;
            }
        }

        nav .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-primary);
            text-decoration: none;
            margin-left: 0 !important; /* Override nav a margin */
        }

        nav .brand img {
            width: 32px;
            height: 32px;
            object-fit: contain;
        }

        /* Cards */

        /* Notifications Status Colors */
        .notif-item.success { border-left: 4px solid var(--success); }
        .notif-item.error { border-left: 4px solid var(--danger); }
        .notif-item.info { border-left: 4px solid var(--accent); }

        .card {
            background-color: var(--bg-secondary);
            border-radius: 0.75rem;
            padding: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        /* Typography */
        h1, h2, h3 {
            margin-top: 0;
            color: var(--text-primary);
        }

        /* Form Elements */
        label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
            font-size: 0.875rem;
        }

        input[type="text"], input[type="password"] {
            width: 100%;
            padding: 0.75rem;
            background-color: var(--bg-primary);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            color: var(--text-primary);
            margin-bottom: 1rem;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

        input:focus {
            outline: none;
            border-color: var(--accent);
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 500;
            line-height: 1.2;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;
            border: none;
        }

        .btn svg {
            flex: 0 0 auto;
        }

        .btn-primary {
            background-color: var(--accent);
            color: var(--bg-primary);
        }

        .btn-primary:hover {
            background-color: var(--accent-hover);
        }

        .btn-warning {
            background-color: var(--warning);
            color: #0f172a;
        }

        .btn-warning:hover {
            background-color: #d97706;
        }

        .btn-secondary {
            background-color: rgba(255, 255, 255, 0.15);
            color: #ffffff !important;
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .btn-secondary:hover {
            background-color: rgba(255, 255, 255, 0.25);
            color: #ffffff !important;
        }

        .btn-full {
            width: 100%;
            text-align: center;
        }

        /* Alerts */
        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
            border-left: 4px solid transparent;
        }

        .alert-success {
            background-color: rgba(34, 197, 94, 0.1);
            border-color: var(--success);
            color: var(--success);
        }

        .alert-error {
            background-color: rgba(239, 68, 68, 0.1);
            border-color: var(--danger);
            color: var(--danger);
        }
        
        /* Status Badge */
        .badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        
        .badge-success {
            background-color: rgba(34, 197, 94, 0.2);
            color: var(--success);
        }

        /* Notifications Sidebar */
        .notif-sidebar {
            position: fixed;
            top: 0;
            left: -400px;
            width: 350px;
            height: 100vh;
            background: var(--bg-secondary);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 3000;
            transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            box-shadow: 8px 0 32px rgba(0,0,0,0.5);
        }

        .notif-sidebar.open {
            left: 0;
        }

        .notif-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 2rem;
            right: 2rem;
            z-index: 10000;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            pointer-events: none;
        }

        .toast {
            padding: 1rem 1.5rem;
            background: var(--bg-secondary);
            border-radius: 8px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 300px;
            max-width: 450px;
            animation: toast-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border-left: 4px solid var(--accent);
            pointer-events: auto;
            position: relative;
        }

        .toast.success { border-left-color: var(--success); }
        .toast.error { border-left-color: var(--danger); }

        @keyframes toast-in {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        @keyframes toast-out {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }

        .notif-content {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            max-height: calc(100vh - 80px); /* Account for header */
        }

        .notif-item {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 8px;
            padding: 0.75rem;
            border-left: 3px solid var(--accent);
            animation: notifSlide 0.3s ease-out;
        }

        @keyframes notifSlide {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .notif-item.error { border-left-color: var(--danger); }
        .notif-item.success { border-left-color: var(--success); }

        .notif-time {
            font-size: 0.7rem;
            color: var(--text-secondary);
            margin-bottom: 0.25rem;
        }

        .notif-close {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 1.5rem;
            cursor: pointer;
        }

        /* Sticky UI Container */
        .sticky-ui-container {
            position: fixed;
            bottom: 1.5rem;
            left: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 1500;
        }

        .shadow-lg {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        }

        .notif-bell-container {
            background: var(--bg-secondary);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s, background 0.2s;
            position: relative;
        }

        .notif-bell-container:hover {
            background: #2d3748;
            transform: scale(1.05);
        }

        .notif-dot {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 10px;
            height: 10px;
            background: var(--danger);
            border: 2px solid var(--bg-secondary);
            border-radius: 50%;
            display: none;
        }

        @media (max-width: 768px) {
            .sticky-ui-container {
                bottom: calc(56px + 2rem); /* Above the sticky tracker bar */
                right: 1.5rem;
                left: auto;
            }
            .notif-bell-container {
                width: 48px;
                height: 48px;
            }
        }
        .badge-video {
            background-color: rgba(56, 189, 248, 0.2);
            color: var(--accent);
        }
        .badge-music {
            background-color: rgba(168, 85, 247, 0.2);
            color: #a855f7;
        }

        /* Tracker Styles */
        .tracker-container {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            width: 450px;
            background: var(--bg-secondary);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 12px;
            box-shadow: 0 12px 48px rgba(0,0,0,0.6);
            z-index: 1000;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            max-height: 85vh;
        }

        .tracker-container.collapsed {
            max-height: 68px;
            width: 400px;
        }

        @media (max-width: 768px) {
            .tracker-container {
                bottom: 0;
                right: 0;
                left: 0;
                width: 100%;
                border-radius: 0;
                border-bottom: none;
                border-left: none;
                border-right: none;
                margin-bottom: 0;
            }
            .tracker-container.collapsed {
                width: 100%;
            }
            .tracker-header {
                padding: 0.75rem 1rem;
            }
        }

        .tracker-header {
            background: rgba(255,255,255,0.03);
            padding: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            user-select: none;
        }

        .tracker-header:hover {
            background: rgba(255,255,255,0.08);
        }

        .tracker-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.9rem;
        }

        .tracker-summary {
            color: var(--text-secondary);
            font-size: 0.8rem;
            margin-left: 0.25rem;
        }

        #tracker-toggle-btn {
            font-size: 0.7rem;
            color: var(--text-secondary);
        }

        .tracker-content {
            padding: 0 1rem 1rem 1rem;
            overflow-y: auto;
            max-height: calc(85vh - 56px);
        }

        .tracker-section h3 {
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin: 1rem 0 0.5rem 0;
            letter-spacing: 0.05em;
        }

        .tracker-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .empty-msg {
            font-size: 0.8rem;
            color: var(--text-secondary);
            font-style: italic;
            padding: 0.5rem 0;
        }

        .active-item {
            background: rgba(255,255,255,0.03);
            border-radius: 8px;
            padding: 0.75rem;
            border-left: 3px solid var(--accent);
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }

        .item-name {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            padding-right: 0.5rem;
            flex: 1;
        }

        .item-progress {
            height: 4px;
            background: rgba(255,255,255,0.05);
            border-radius: 2px;
            margin-bottom: 0.5rem;
            overflow: hidden;
        }

        .item-progress .bar {
            height: 100%;
            background: var(--accent);
            transition: width 0.3s ease;
        }

        .item-progress .bar.pulsing {
            background: linear-gradient(90deg, var(--accent), var(--success), var(--accent));
            background-size: 200% 100%;
            animation: pulse-bg 2s infinite linear;
        }

        .item-progress .bar.indeterminate {
            width: 32% !important;
            background: linear-gradient(90deg, var(--accent), #818cf8);
            animation: tracker-indeterminate 1.2s ease-in-out infinite;
        }

        @keyframes tracker-indeterminate {
            0% { transform: translateX(-110%); }
            100% { transform: translateX(320%); }
        }

        @keyframes pulse-bg {
            0% { background-position: 100% 0; }
            100% { background-position: -100% 0; }
        }

        .item-footer {
            display: flex;
            justify-content: space-between;
            font-size: 0.7rem;
            color: var(--text-secondary);
        }

        .queued-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.02);
            border-radius: 6px;
            padding: 0.5rem 0.75rem;
            font-size: 0.8rem;
        }

        .btn-remove {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 1.2rem;
            line-height: 1;
            padding: 0 0.25rem;
        }

        .btn-remove:hover {
            color: #ff4d4d;
        }
    </style>
</head>
<body>
    <nav>
        <div class="container">
            <a href="{{ path('music') }}" class="brand">
                <img src="/logo.png" alt="Logo">
                <span>Downloader</span>
            </a>
            
            {% if app.session and app.session.get('authenticated') %}
            <div class="burger-btn" onclick="toggleBurger()">
                <span></span>
                <span></span>
                <span></span>
            </div>

            {% set current_route = app.request.attributes.get('_route') %}
            <div class="nav-links" id="nav-links">
                {% if storage.isConfigured() %}
                    <a href="{{ path('music') }}" class="{{ current_route == 'music' ? 'active' : '' }}">Music</a>
                    <a href="{{ path('music_files') }}" class="{{ current_route == 'music_files' ? 'active' : '' }}">Music Downloads</a>
                    <a href="{{ path('torrent') }}" class="{{ current_route == 'torrent' ? 'active' : '' }}">Debrid</a>
                    <a href="{{ path('media_index') }}" class="{{ current_route == 'media_index' ? 'active' : '' }}">Discover</a>
                    <a href="{{ path('automation') }}" class="{{ current_route starts with 'automation' ? 'active' : '' }}">Automations</a>
                    <a href="{{ path('queue') }}" class="{{ current_route == 'queue' ? 'active' : '' }}">Queue</a>
                    <a href="{{ path('history') }}" class="{{ current_route == 'history' ? 'active' : '' }}">History</a>
                    <a href="{{ path('config') }}" class="{{ current_route == 'config' ? 'active' : '' }}">Settings</a>
                {% else %}
                    <a href="{{ path('config') }}" class="{{ current_route == 'config' ? 'active' : '' }}">Setup</a>
                {% endif %}
                <a href="{{ path('logout') }}" class="logout-link">Logout</a>
            </div>
            {% endif %}
        </div>
    </nav>

    {% if app.session and app.session.get('authenticated') %}
    <div id="notif-sidebar" class="notif-sidebar">
        <div class="notif-header">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <h3 style="margin: 0;">Logs</h3>
                <button class="btn btn-secondary" style="font-size: 0.65rem; padding: 0.2rem 0.5rem; background: rgba(255,255,255,0.05);" onclick="clearNotifications()">Clear All</button>
                <button id="btn-browser-notif" class="btn btn-primary" style="font-size: 0.65rem; padding: 0.2rem 0.5rem;" onclick="requestBrowserNotifications()">🔔 Enable Alerts</button>
            </div>
            <button class="notif-close" onclick="toggleNotifSidebar()">×</button>
        </div>
        <div id="notif-content" class="notif-content">
            <div class="empty-msg" style="text-align: center; margin-top: 2rem; color: var(--text-secondary);">No logs yet.</div>
        </div>
    </div>
    {% endif %}

    <div class="container page-content">
        <div class="toast-container" id="toast-container"></div>
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-error">
                {{ message }}
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </div>

    {% if app.session and app.session.get('authenticated') %}
    <!-- Sticky UI Container (Bottom Right) -->
    <div class="sticky-ui-container">
        <div class="notif-bell-container shadow-lg" onclick="toggleNotifSidebar()">
            <span style="font-size: 1.5rem;">🔔</span>
            <div id="notif-dot" class="notif-dot"></div>
        </div>
    </div>
    {% endif %}

    <!-- Global Download Tracker -->
    {% if (hide_tracker is not defined or not hide_tracker) and (app.session and app.session.get('authenticated')) %}
    <div id="download-tracker" class="tracker-container collapsed">
        <div class="tracker-header">
            <div class="tracker-title" onclick="toggleTracker()">
                <span class="tracker-icon">🚀</span>
                <strong>Downloads</strong>
                <span id="tracker-summary" class="tracker-summary">(0 active, 0 queued)</span>
            </div>
            <div class="tracker-controls">
                <button id="tracker-toggle-btn" class="btn btn-secondary btn-icon" onclick="toggleTracker()">▼</button>
            </div>
        </div>
        <div class="tracker-content">
            <div class="tracker-section">
                <h3>Ongoing</h3>
                <div id="active-downloads-list" class="tracker-list">
                    <!-- Dynamic -->
                    <div class="empty-msg">No active downloads</div>
                </div>
            </div>
            <div class="tracker-section">
                <h3>Upcoming</h3>
                <div id="queued-downloads-list" class="tracker-list">
                    <!-- Dynamic -->
                    <div class="empty-msg">Queue is empty</div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <style>
        :root {
            --border: rgba(255, 255, 255, 0.08);
            --panel: rgba(30, 41, 59, 0.78);
            --panel-solid: #1e293b;
            --shadow-soft: 0 18px 50px rgba(0, 0, 0, 0.24);
        }

        body {
            background:
                radial-gradient(circle at 15% 0%, rgba(56, 189, 248, 0.09), transparent 28rem),
                radial-gradient(circle at 85% 10%, rgba(129, 140, 248, 0.07), transparent 26rem),
                var(--bg-primary);
        }

        .container {
            max-width: 1240px;
        }

        nav {
            background: rgba(15, 23, 42, 0.84);
            border-bottom: 1px solid var(--border);
            padding: 0.65rem 0;
        }

        nav .container {
            max-width: 1240px;
            gap: 1.5rem;
        }

        nav .brand {
            font-size: 1.06rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        nav .brand img {
            width: 34px;
            height: 34px;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 4px 16px rgba(56, 189, 248, 0.28);
        }

        .nav-links {
            gap: 0.2rem;
        }

        .nav-links a {
            margin-left: 0;
            padding: 0.55rem 0.8rem;
            border-radius: 8px;
            color: var(--text-secondary);
            font-size: 0.88rem;
            font-weight: 650;
        }

        .nav-links a:hover {
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.04);
        }

        .nav-links a.active {
            color: var(--accent);
