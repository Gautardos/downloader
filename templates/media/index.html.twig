}

async function confirmMediaDebrid() {
    if (!pendingStream) return;
    const button = document.getElementById('mediaConfirmButton');
    const status = document.getElementById('mediaConfirmStatus');
    button.disabled = true;
    button.textContent = 'Adding...';
    status.style.display = 'block';
    status.style.background = 'rgba(255,255,255,0.05)';
    status.style.color = 'var(--text-secondary)';
    status.textContent = 'Adding torrent to Alldebrid...';

    try {
        const response = await fetch("{{ path('media_debrid') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                info_hash: pendingStream.info_hash,
                file_idx: pendingStream.file_idx,
                url: pendingStream.url,
                kind: pendingStream.kind,
                size: pendingStream.size,
                filename: mediaStreamFilename(pendingStream),
                override_filename: document.getElementById('mediaConfirmFilename').value.trim(),
                sources: pendingStream.sources || [],
                title: pendingStream.title,
                addon: pendingStream.addon,
                path: document.getElementById('mediaConfirmPath').value,
                media_title: activeMediaDetails.title
            })
        });
        const data = await response.json();
        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'Could not add this torrent to Alldebrid.');
        }

        status.style.color = 'var(--success)';
        status.textContent = 'Added to queue: ' + data.filename;
        const usedPath = document.getElementById('mediaConfirmPath').value.trim();
        if (usedPath && !recentMediaPaths.includes(usedPath)) {
            recentMediaPaths.push(usedPath);
        }
        document.getElementById('mediaDestinationPath').value = usedPath;
        destinationAutoValue = usedPath;
        window.notify('success', {
            action: 'Finished',
            media_type: 'video',
            item: data.filename + ' added to the download queue'
        });
        setTimeout(closeMediaConfirm, 700);
    } catch (error) {
        status.style.color = 'var(--danger)';
        status.textContent = error.message;
    } finally {
        button.disabled = false;
        button.textContent = 'Add to queue';
    }
}

