        list.innerHTML = '<div class="discover-empty" style="display:block;padding:1.2rem;">No stream addon configured.</div>';
        return;
    }

    addonsState.forEach((addon, index) => {
        const row = document.createElement('div');
        row.className = 'addon-row';
        row.innerHTML = `
            <span class="addon-status ${addon.enabled ? '' : 'off'}"></span>
            <div class="addon-main">
                <div class="addon-name">${escapeMediaHtml(addon.name || 'Unnamed addon')}</div>
                <div class="addon-url">${escapeMediaHtml(addon.manifest_url || '')}</div>
                <div class="addon-kind">stream · tt</div>
            </div>
            <div class="addon-priority-wrap">
                <span>Priority</span>
                <input type="number" class="addon-priority" min="1" max="999" value="${Number(addon.priority || 100)}" title="Lower number = higher priority">
            </div>
            <span class="addon-switch ${addon.enabled ? 'on' : ''}" role="switch" aria-checked="${addon.enabled ? 'true' : 'false'}"></span>
            <button class="addon-remove" title="Remove addon" onclick="removeMediaAddon(${index})">×</button>
        `;
        row.querySelector('.addon-switch').addEventListener('click', () => {
            addonsState[index].enabled = !addonsState[index].enabled;
            renderAddonsList();
        });
        row.querySelector('.addon-priority').addEventListener('input', event => {
            const value = parseInt(event.target.value, 10);
            addonsState[index].priority = Number.isFinite(value) ? Math.max(1, Math.min(999, value)) : 100;
            event.target.value = addonsState[index].priority;
        });
        list.appendChild(row);
    });
}

function removeMediaAddon(index) {
