    const meta = nuvioMeta || {};
    if (!meta.imported_at || nuvioCollections.length === 0) {
        status.textContent = 'Aucune collection Nuvio importée';
        return;
    }

    const date = new Date(Number(meta.imported_at) * 1000);
    const pending = {};
    nuvioCollections.forEach(collection => {
        (collection.folders || []).forEach(folder => {
            Object.entries(folder.pending_addons || {}).forEach(([id, count]) => {
                pending[id] = (pending[id] || 0) + Number(count || 0);
            });
        });
    });
    const pendingCount = Object.values(pending).reduce((sum, count) => sum + count, 0);
    let html = '<span class="addon-status' + (pendingCount > 0 ? ' pending' : '') + '"></span> Nuvio Collections · importées le ' + date.toLocaleDateString('fr-FR');
    if (pendingCount > 0) {
        html += ` <span style="color:#fbbf24;">· ${pendingCount} sources en attente (${Object.keys(pending).map(addonLabel).join(', ')})</span>`;
    }
    status.innerHTML = html;
}

function currentBrowseCollection() {
    return nuvioCollections[browseCollectionIndex] || null;
}

function renderBrowse() {
    const empty = document.getElementById('browseEmpty');
    const content = document.getElementById('browseContent');

    if (!Array.isArray(nuvioCollections) || nuvioCollections.length === 0) {
        empty.style.display = 'block';
        content.style.display = 'none';
        document.getElementById('browseFolderView').classList.remove('open');
        return;
    }

    empty.style.display = 'none';
    content.style.display = 'block';
    document.getElementById('browseFolderView').classList.remove('open');

    if (browseCollectionIndex >= nuvioCollections.length) browseCollectionIndex = 0;
    renderBrowseCollectionTabs();

    const collection = currentBrowseCollection();
    if (!collection) return;

    const hero = document.getElementById('browseHero');
    hero.style.backgroundImage = collection.backdrop ? `url("${collection.backdrop}")` : '';
    document.getElementById('browseCollectionTitle').textContent = collection.title;
    document.getElementById('browseCollectionDescription').textContent = browseDescriptions[collection.title] || 'Collections importées depuis Nuvio.';
    const folders = collection.folders || [];
    const sourceCount = folders.reduce((sum, folder) => sum + Number(folder.source_count || 0), 0);
    const matchedCount = folders.reduce((sum, folder) => sum + Number(folder.matched_count || 0), 0);
    const movieCount = folders.reduce((sum, folder) => sum + (folder.sources || []).filter(source => source.type === 'movie').length, 0);
    const seriesCount = folders.reduce((sum, folder) => sum + (folder.sources || []).filter(source => source.type === 'series').length, 0);
    document.getElementById('browseCollectionStats').innerHTML = `
        <span class="browse-stat-pill">${folders.length} dossiers</span>
        <span class="browse-stat-pill">${matchedCount} catalogues fusionnés</span>
        <span class="browse-stat-pill">${movieCount} sources films</span>
        <span class="browse-stat-pill">${seriesCount} sources séries</span>
    `;
    document.getElementById('browseFolderSubtitle').textContent = collection.title === 'Iptv'
        ? 'Aucune source NexoTV configurée pour le moment.'
        : 'Clique sur un dossier pour fusionner ses catalogues.';
    document.getElementById('browseFolderSearch').value = '';
    renderBrowseFolders();
}

function renderBrowseCollectionTabs() {
    const wrap = document.getElementById('browseCollectionTabs');
    wrap.innerHTML = '';

    nuvioCollections.forEach((collection, index) => {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'browse-collection-tab' + (index === browseCollectionIndex ? ' active' : '');
        const thumb = collection.backdrop || collection.folders?.[0]?.cover || '';
        tab.innerHTML = `
            <img class="browse-collection-thumb" src="${escapeMediaHtml(thumb)}" alt="">
            <span>
                <span class="browse-collection-name">${escapeMediaHtml(collection.title)}</span>
                <span class="browse-collection-count">${(collection.folders || []).length} dossiers</span>
            </span>
        `;
        const deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'browse-collection-delete';
        deleteButton.title = 'Supprimer la collection';
        deleteButton.setAttribute('aria-label', `Supprimer la collection ${collection.title}`);
        deleteButton.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>';
        deleteButton.addEventListener('click', event => {
            event.stopPropagation();
            deleteBrowseCollection(collection.id, collection.title);
        });
        tab.appendChild(deleteButton);
        const image = tab.querySelector('img');
        image.addEventListener('error', () => { image.style.visibility = 'hidden'; });
        tab.addEventListener('click', () => {
            browseCollectionIndex = index;
            browseFolder = null;
            renderBrowse();
        });
        wrap.appendChild(tab);
    });
}

function renderBrowseFolders() {
    const collection = currentBrowseCollection();
    const grid = document.getElementById('browseFolderGrid');
    if (!collection) return;

    const query = (document.getElementById('browseFolderSearch').value || '').trim().toLowerCase();
    const folders = (collection.folders || []).filter(folder => !query || String(folder.title || '').toLowerCase().includes(query));
    grid.innerHTML = '';

    if (folders.length === 0) {
        grid.innerHTML = '<div class="browse-empty-state">Aucun dossier ne correspond au filtre.</div>';
        return;
    }

    folders.forEach(folder => {
        const card = document.createElement('article');
        card.className = 'browse-folder-card' + (folder.hide_title ? ' no-title' : '');
        const cover = folder.cover ? `<img class="browse-folder-cover" src="${escapeMediaHtml(folder.cover)}" alt="${escapeMediaHtml(folder.title)}" loading="lazy">` : '';
        const logo = folder.logo && !folder.hide_title ? `<img class="browse-folder-logo" src="${escapeMediaHtml(folder.logo)}" alt="">` : '';
        const titleOverlay = folder.logo && !folder.hide_title ? '' : `
            <div class="browse-folder-title">
                <h4>${escapeMediaHtml(folder.title)}</h4>
                <span class="browse-folder-source-count">${folder.matched_count}/${folder.source_count} sources</span>
            </div>
        `;
        card.innerHTML = `
            ${cover}
            <span class="browse-folder-cta">Ouvrir</span>
            ${logo}
            ${titleOverlay}
        `;
        const deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'browse-folder-delete';
        deleteButton.title = 'Supprimer le dossier';
        deleteButton.setAttribute('aria-label', `Supprimer le dossier ${folder.title}`);
        deleteButton.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>';
        deleteButton.addEventListener('click', event => {
            event.stopPropagation();
            deleteBrowseFolder(collection.id, folder.id, folder.title);
        });
        card.appendChild(deleteButton);
        card.querySelectorAll('img').forEach(img => img.addEventListener('error', () => { img.style.display = 'none'; }));
        card.addEventListener('click', () => openBrowseFolder(folder));
        grid.appendChild(card);
    });
}

async function deleteBrowseCollection(collectionId, title) {
    if (!confirm(`Supprimer la collection « ${title} » et tous ses dossiers ?`)) return;

    try {
        const response = await fetch("{{ path('media_collections_delete') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ collection_id: collectionId })
        });
        const data = await response.json();
        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'Could not delete this collection.');
        }

        const index = nuvioCollections.findIndex(item => String(item.id) === String(collectionId));
        if (index === -1) {
            throw new Error('Collection not found locally.');
        }

        nuvioCollections.splice(index, 1);
        if (index < browseCollectionIndex) browseCollectionIndex--;
        else if (index === browseCollectionIndex) browseCollectionIndex = Math.min(index, nuvioCollections.length - 1);
        browseCollectionIndex = Math.max(0, Math.min(browseCollectionIndex, nuvioCollections.length - 1));
        browseFolder = null;
        renderBrowse();
        renderDiscoverStatus();
        window.notify('success', `Collection « ${title} » supprimée.`);
    } catch (error) {
        window.notify('error', error.message);
    }
}

function deleteCurrentBrowseCollection() {
    const collection = currentBrowseCollection();
    if (!collection) return;
    deleteBrowseCollection(collection.id, collection.title);
}

async function deleteBrowseFolder(collectionId, folderId, title) {
    if (!confirm(`Supprimer le dossier « ${title} » de cette collection ?`)) return;

    try {
        const response = await fetch("{{ path('media_collections_folder_delete') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ collection_id: collectionId, folder_id: folderId })
        });
        const data = await response.json();
        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'Could not delete this folder.');
        }

        const collection = nuvioCollections.find(item => String(item.id) === String(collectionId));
        if (collection) {
            collection.folders = (collection.folders || []).filter(folder => String(folder.id) !== String(folderId));
        }
        if (browseFolder && String(browseFolder.id) === String(folderId)) {
            closeBrowseFolder();
        }
        renderBrowse();
        renderDiscoverStatus();
        window.notify('success', `Dossier « ${title} » supprimé.`);
    } catch (error) {
        window.notify('error', error.message);
    }
}

function deleteCurrentBrowseFolder() {
    const collection = currentBrowseCollection();
    if (!browseFolder || !collection) return;
    deleteBrowseFolder(collection.id, browseFolder.id, browseFolder.title);
}

function openBrowseFolder(folder) {
    browseFolder = folder;
    browseType = 'all';
    browseVisible = 12;
    browseMergedItems = [];
    browseSourceStates = (folder.sources || []).map(source => ({
        source: source,
        items: [],
        skip: 0,
        done: false,
        error: null
    }));

    document.getElementById('browseContent').style.display = 'none';
    document.getElementById('browseFolderView').classList.add('open');
    const hero = document.getElementById('browseFolderHero');
    hero.style.backgroundImage = folder.hero || folder.cover ? `url("${folder.hero || folder.cover}")` : '';
    document.getElementById('browseFolderLogoWrap').innerHTML = folder.logo
        ? `<img class="browse-folder-logo-large" src="${escapeMediaHtml(folder.logo)}" alt="">`
        : '';
    document.getElementById('browseFolderTitle').textContent = folder.title;
    document.getElementById('browseFolderSubtitle2').textContent = 'Items fusionnés et dédupliqués depuis les catalogues du dossier.';
    const pendingAddons = Object.keys(folder.pending_addons || {}).map(addonLabel);
    document.getElementById('browseFolderStats').innerHTML = `
        <span class="browse-stat-pill">${folder.matched_count}/${folder.source_count} catalogues</span>
        <span class="browse-stat-pill">${(folder.sources || []).filter(s => s.type === 'movie').length} sources films</span>
        <span class="browse-stat-pill">${(folder.sources || []).filter(s => s.type === 'series').length} sources séries</span>
        ${pendingAddons.length ? `<span class="browse-stat-pill pending">En attente : ${escapeMediaHtml(pendingAddons.join(', '))}</span>` : ''}
    `;
    document.querySelectorAll('#browseTypeFilters button').forEach(btn => btn.classList.toggle('active', btn.dataset.type === 'all'));
    document.getElementById('browsePosterGrid').innerHTML = '';
    document.getElementById('browseLoadMoreBtn').style.display = 'none';
    document.getElementById('browseSourceSummary').textContent = 'Chargement des catalogues...';

    loadBrowseItems(true);
}

function closeBrowseFolder() {
    browseFolder = null;
    browseSourceStates = [];
    browseMergedItems = [];
    document.getElementById('browseFolderView').classList.remove('open');
    document.getElementById('browseContent').style.display = 'block';
}

function setBrowseType(type, button) {
    browseType = type;
    browseVisible = 12;
    document.querySelectorAll('#browseTypeFilters button').forEach(btn => btn.classList.toggle('active', btn === button));
    renderBrowsePosters();
}

function mapLimit(items, limit, worker) {
    return new Promise(resolve => {
        let next = 0;
        let active = 0;
        const results = new Array(items.length);
        if (items.length === 0) return resolve(results);

        const launch = () => {
            while (active < limit && next < items.length) {
                const index = next++;
                active++;
                Promise.resolve(worker(items[index], index)).then(result => {
                    results[index] = result;
                }).catch(error => {
                    results[index] = { error: error.message || 'Request failed' };
                }).finally(() => {
                    active--;
                    if (next < items.length) launch();
                    else if (active === 0) resolve(results);
                });
            }
        };
        launch();
    });
}

async function fetchBrowseSource(state) {
    if (state.done) return;
    const source = state.source;
    try {
        const response = await fetch("{{ path('media_catalog_items') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                addon_id: source.addon_id,
                type: source.type,
                catalog_id: source.catalog_id,
                genre: source.genre || null,
                skip: state.skip
            })
        });
        const data = await response.json();
        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'Catalog request failed.');
        }
        const items = Array.isArray(data.items) ? data.items : [];
        state.items = state.items.concat(items);
        state.skip += items.length;
        state.done = items.length === 0;
    } catch (error) {
        state.error = error.message;
        state.done = true;
    }
}

async function loadBrowseItems(initial = false) {
    if (!browseFolder) return;

    const summary = document.getElementById('browseSourceSummary');
    if (browseSourceStates.length === 0) {
        browseMergedItems = [];
        summary.textContent = `${browseFolder.matched_count}/${browseFolder.source_count} catalogues fusionnés`;
        renderBrowsePosters();
        return;
    }

    if (initial) {
        const states = browseSourceStates;
        await mapLimit(states, 4, state => fetchBrowseSource(state));
    } else {
        const pending = browseSourceStates.filter(state => !state.done);
        await mapLimit(pending, 4, state => fetchBrowseSource(state));
    }

    const seen = new Set();
    browseMergedItems = [];
    browseSourceStates.forEach(state => {
        state.items.forEach(item => {
            const key = item.tmdb_id ? 'tmdb:' + item.tmdb_id : (item.imdb_id ? 'imdb:' + item.imdb_id : 'id:' + item.id);
            if (seen.has(key)) return;
            seen.add(key);
            browseMergedItems.push(item);
        });
    });

    const errorCount = browseSourceStates.filter(state => state.error).length;
    summary.textContent = `${browseFolder.matched_count}/${browseFolder.source_count} catalogues fusionnés · ${browseMergedItems.length} titres` + (errorCount ? ` · ${errorCount} erreur(s)` : '');
    renderBrowsePosters();
}

function browseItemType(item) {
    if (item.media_type === 'movie' || item.media_type === 'series') return item.media_type;
    if (item.type === 'movie') return 'movie';
    if (item.type === 'series' || item.type === 'tv' || item.type === 'anime') return 'series';
    return null;
}

function renderBrowsePosters() {
    const grid = document.getElementById('browsePosterGrid');
    const button = document.getElementById('browseLoadMoreBtn');
    if (!grid) return;

    browseFilteredItems = browseMergedItems.filter(item => browseType === 'all' || browseItemType(item) === browseType);
    const visible = browseFilteredItems.slice(0, browseVisible);
    grid.innerHTML = '';

    if (visible.length === 0) {
        let message = 'Aucun titre trouvé pour ce filtre.';
        let action = '';
        if (browseSourceStates.length === 0) {
            const pendingAddons = Object.keys(browseFolder.pending_addons || {}).map(addonLabel);
            if (Number(browseFolder.source_count || 0) > 0 && pendingAddons.length > 0) {
                message = `Sources présentes, mais aucun addon configuré : ${pendingAddons.join(', ')}.`;
                action = '<div style="margin-top:1rem;"><button class="btn btn-primary" onclick="openAddonsDrawer()">Configurer les addons</button></div>';
            } else {
                message = 'Aucune source configurée pour ce dossier.';
            }
        }
        grid.innerHTML = `<div class="browse-empty-state">${escapeMediaHtml(message)}${action}</div>`;
    } else {
        visible.forEach(item => {
            const type = browseItemType(item);
            const card = document.createElement('article');
            card.className = 'browse-poster-card';
            card.innerHTML = `
                <div class="browse-poster-wrap">
                    <span class="browse-poster-type">${type === 'movie' ? 'FILM' : 'SÉRIE'}</span>
                    ${item.rating ? `<span class="browse-poster-rating">${escapeMediaHtml(item.rating)}</span>` : ''}
                    <img src="${escapeMediaHtml(item.poster || '')}" alt="${escapeMediaHtml(item.title)}" loading="lazy">
                </div>
                <div class="browse-poster-body">
                    <h4>${escapeMediaHtml(item.title)}</h4>
                    <div><span>${escapeMediaHtml(item.year || '')}</span><span class="discover-dot"></span><span>${type === 'movie' ? 'Film' : 'Série'}</span></div>
                </div>
            `;
            card.querySelector('img').addEventListener('error', event => { event.target.style.display = 'none'; });
            card.addEventListener('click', () => openBrowseItem(item));
            grid.appendChild(card);
        });
    }

    const hasPendingSources = browseSourceStates.some(state => !state.done);
    button.style.display = (browseVisible < browseFilteredItems.length || hasPendingSources) ? 'inline-flex' : 'none';
}

async function loadMoreBrowseItems() {
    if (browseVisible < browseFilteredItems.length) {
        browseVisible += 12;
        renderBrowsePosters();
        return;
    }

    if (browseSourceStates.some(state => !state.done)) {
        await loadBrowseItems(false);
        browseVisible += 12;
        renderBrowsePosters();
    }
}

async function openBrowseItem(item) {
    const type = browseItemType(item);

    if (item.tmdb_id && type) {
        openMediaDetail({
            id: item.tmdb_id,
            type: type,
            title: item.title,
            year: item.year,
            poster: item.poster,
            backdrop: item.backdrop,
            overview: item.overview,
            rating: item.rating
        });
        return;
    }

    try {
        const response = await fetch("{{ path('media_resolve_item') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                tmdb_id: item.tmdb_id || 0,
                imdb_id: item.imdb_id || (String(item.id || '').startsWith('tt') ? item.id : ''),
                type: type || item.type,
                title: item.title,
                year: item.year
            })
        });
        const data = await response.json();
        if (!response.ok || data.success === false || !data.details) {
            throw new Error(data.message || 'Could not resolve this item.');
        }
        openMediaDetail(data.details);
    } catch (error) {
        window.notify('error', error.message);
    }
}

function setNuvioImportStatus(message, type) {
    const status = document.getElementById('nuvioImportStatus');
    status.style.display = 'block';
    if (type === 'error') {
        status.style.background = 'rgba(220,53,69,.1)';
        status.style.color = 'var(--danger)';
        status.style.border = '1px solid rgba(220,53,69,.35)';
    } else if (type === 'success') {
        status.style.background = 'rgba(40,167,69,.1)';
        status.style.color = 'var(--success)';
        status.style.border = '1px solid rgba(40,167,69,.35)';
    } else {
        status.style.background = 'rgba(255,255,255,.05)';
        status.style.color = 'var(--text-secondary)';
        status.style.border = '1px solid var(--border)';
    }
    status.textContent = message;
}

async function importNuvioCollections() {
    const fileInput = document.getElementById('nuvioCollectionsFile');
    const textarea = document.getElementById('nuvioCollectionsJson');
    const button = document.getElementById('nuvioImportButton');
    let json = textarea.value.trim();

    if (fileInput.files && fileInput.files[0]) {
        json = await fileInput.files[0].text();
    }

    if (!json) {
        setNuvioImportStatus('Sélectionne un fichier ou colle le JSON Nuvio.', 'error');
        return;
    }

    button.disabled = true;
    button.textContent = 'Importing...';
    setNuvioImportStatus('Import en cours...', 'info');

    try {
        const response = await fetch("{{ path('media_collections_import') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ json: json })
        });
        const data = await response.json();
        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'Import failed.');
        }

        const report = data.report || {};
        const pendingNames = Object.keys(report.unmatched_addons || {}).map(addonLabel);
        let message = `Import OK · ${report.collections || 0} collections · ${report.folders || 0} dossiers · ${report.matched || 0}/${report.sources || 0} sources actives`;
        if (report.pending) message += ` · ${report.pending} en attente${pendingNames.length ? ' (' + pendingNames.join(', ') + ')' : ''}`;
        if (report.skipped) message += ` · ${report.skipped} ignorées`;
        setNuvioImportStatus(message, report.pending ? 'error' : 'success');
        setTimeout(() => window.location.reload(), report.pending ? 2600 : 1000);
    } catch (error) {
        setNuvioImportStatus(error.message, 'error');
    } finally {
        button.disabled = false;
        button.textContent = 'Import collections';
    }
}

async function clearNuvioCollections() {
    if (!confirm('Supprimer les collections Nuvio importées ?')) return;
    try {
        const response = await fetch("{{ path('media_collections_clear') }}", { method: 'POST' });
        const data = await response.json();
        if (!response.ok || data.success === false) throw new Error(data.message || 'Could not clear collections.');
        setNuvioImportStatus('Collections supprimées. Rechargement...', 'success');
        setTimeout(() => window.location.reload(), 800);
    } catch (error) {
        setNuvioImportStatus(error.message, 'error');
    }
}

renderMediaCards();
renderAddonsList();
renderDiscoverStatus();
setDiscoveryMode(nuvioCollections.length > 0 ? 'browse' : 'search');

const browsePreviewParams = new URLSearchParams(location.search);
if (browsePreviewParams.has('folder') && nuvioCollections.length > 0) {
    const previewCollectionIndex = parseInt(browsePreviewParams.get('collection') || '0', 10) || 0;
    const previewFolderIndex = parseInt(browsePreviewParams.get('folder') || '0', 10) || 0;
    const previewCollection = nuvioCollections[previewCollectionIndex] || nuvioCollections[0];
    const previewFolder = previewCollection ? (previewCollection.folders || [])[previewFolderIndex] : null;
    if (previewFolder) {
        browseCollectionIndex = nuvioCollections.indexOf(previewCollection);
        setDiscoveryMode('browse');
        setTimeout(() => openBrowseFolder(previewFolder), 100);
    }
}

if (new URLSearchParams(location.search).get('addons') === '1') {
    openAddonsDrawer();
}
</script>
{% endblock %}
