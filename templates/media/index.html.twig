function setAddonStatus(message, type) {
    const status = document.getElementById('mediaAddonStatus');
    status.style.display = 'block';
    if (type === 'error') {
        status.style.background = 'rgba(220,53,69,.1)';
        status.style.color = 'var(--danger)';
        status.style.border = '1px solid rgba(220,53,69,.35)';
    } else if (type === 'success') {
        status.style.background = 'rgba(40,167,69,.1)';
        status.style.color = 'var(--success)';
        status.style.border = '1px solid rgba(40,167,69,.35)';
    } else {
        status.style.background = 'rgba(255,255,255,.05)';
        status.style.color = 'var(--text-secondary)';
        status.style.border = '1px solid var(--border)';
    }
    status.textContent = message;
}

async function validateMediaAddon() {
    const url = document.getElementById('mediaAddonUrl').value.trim();
    if (!url) {
        setAddonStatus('Enter a manifest URL first.', 'error');
        return null;
    }

    const button = document.getElementById('mediaValidateAddonButton');
    button.disabled = true;
    setAddonStatus('Validating manifest...', 'info');

    try {
        const response = await fetch("{{ path('media_addons_validate') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url })
        });
        const data = await response.json();
        if (!response.ok || data.success === false) {
            throw new Error(data.message || 'Invalid manifest.');
        }

        pendingAddon = {
            id: data.manifest.id || url,
            name: data.manifest.name || 'Unnamed addon',
            manifest_url: data.manifest_url,
            enabled: true,
            priority: 100,
            timeout: 10
        };
        setAddonStatus(`Valid manifest: ${pendingAddon.name}`, 'success');
        return pendingAddon;
    } catch (error) {
        pendingAddon = null;
        setAddonStatus(error.message, 'error');
        return null;
    } finally {
        button.disabled = false;
    }
}

async function addMediaAddon() {
    if (!pendingAddon || document.getElementById('mediaAddonUrl').value.trim() !== pendingAddon.manifest_url) {
        const validated = await validateMediaAddon();
        if (!validated) return;
    }

    if (addonsState.some(addon => addon.manifest_url === pendingAddon.manifest_url)) {
        setAddonStatus('This addon is already configured.', 'error');
        return;
    }

    addonsState.push({ ...pendingAddon });
    pendingAddon = null;
    document.getElementById('mediaAddonUrl').value = '';
    renderAddonsList();
    setAddonStatus('Addon added. Save settings to persist it.', 'success');
}

async function saveMediaSettings() {
    const button = document.getElementById('mediaSaveSettingsButton');
    button.disabled = true;
    button.textContent = 'Saving...';
    setAddonStatus('Saving TMDB and addon settings...', 'info');

    try {
        const settingsResponse = await fetch("{{ path('media_settings') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                tmdb_api_key: document.getElementById('tmdbApiKey').value.trim(),
                clear_tmdb_api_key: document.getElementById('tmdbApiKeyClear')?.checked || false,
                tmdb_language: document.getElementById('tmdbLanguage').value
            })
        });
        const settingsData = await settingsResponse.json();
        if (!settingsResponse.ok || settingsData.success === false) {
            throw new Error(settingsData.message || 'Could not save TMDB settings.');
        }

        const addonsResponse = await fetch("{{ path('media_addons_save') }}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ addons: addonsState })
        });
        const addonsData = await addonsResponse.json();
        if (!addonsResponse.ok || addonsData.success === false) {
            throw new Error(addonsData.message || 'Could not save addons.');
        }

        if (Array.isArray(addonsData.addons)) {
            addonsState = addonsData.addons;
            renderAddonsList();
        }
        setAddonStatus('Settings saved. Reloading...', 'success');
        setTimeout(() => window.location.reload(), 900);
    } catch (error) {
        setAddonStatus(error.message, 'error');
    } finally {
        button.disabled = false;
        button.textContent = 'Save settings';
    }
}

