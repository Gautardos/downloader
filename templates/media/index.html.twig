{% extends 'base.html.twig' %}

{% block title %}Discover - Downloader{% endblock %}

{% block body %}
<div class="discover-page">
    {% embed '_partials/page_header.html.twig' with {
        title: 'Discover',
        subtitle: 'Search movies and series with TMDB, then pick a torrent source and send it to Alldebrid. Stremio/Nuvio stream manifests are used only for sources.',
        icon: 'compass'
    } %}
        {% block actions %}
            <button class="btn btn-secondary" onclick="openAddonsDrawer()" style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                Media addons
            </button>
        {% endblock %}
    {% endembed %}

    {% if not tmdb_configured %}
    <div class="discover-notice">
        <div>
            <strong>TMDB is not configured.</strong>
            <span>Add a TMDB API key in Media addons to enable search and metadata.</span>
        </div>
        <button class="btn btn-primary" onclick="openAddonsDrawer()">Configure</button>
    </div>
    {% endif %}

    <datalist id="mediaRecentPaths">
        {% for path in recent_paths %}
        <option value="{{ path|e('html_attr') }}"></option>
        {% endfor %}
    </datalist>

    <div class="discover-mode-row">
        <div class="discover-mode-switch">
            <button type="button" id="mode-search-btn" onclick="setDiscoveryMode('search')">Search</button>
            <button type="button" id="mode-browse-btn" onclick="setDiscoveryMode('browse')">Browse</button>
        </div>
        <div class="discover-status" id="discoverStatus"></div>
    </div>

    <div id="searchMode">
    <section class="discover-toolbar">
        <div class="discover-search">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <input id="mediaSearchInput" type="text" placeholder="Search a movie or a series..." oninput="debouncedMediaSearch()">
        </div>
        <div class="discover-filters" id="mediaTypeFilters">
            <button class="active" data-type="all" onclick="setMediaType('all', this)">All</button>
            <button data-type="movie" onclick="setMediaType('movie', this)">Movies</button>
            <button data-type="series" onclick="setMediaType('series', this)">Series</button>
        </div>
    </section>

    <div class="discover-results-head">
        <h2 id="mediaResultsTitle">Popular picks</h2>
        <span id="mediaResultsCount"></span>
    </div>

    <section class="discover-grid" id="mediaGrid"></section>
    <div class="discover-empty" id="mediaEmptyState">No title matches your search.</div>
    </div>

    <div id="browseMode" style="display:none;">
        <div id="browseEmpty" class="discover-empty" style="display:none; padding:2.5rem 1rem;">
            <div style="font-weight:700; color:var(--text-primary); margin-bottom:0.4rem;">Aucune collection Nuvio importée.</div>
            <div style="margin-bottom:1rem;">Importe ton JSON Nuvio pour retrouver tes collections AIOMetadata.</div>
            <button class="btn btn-primary" onclick="openAddonsDrawer()">Import collections</button>
        </div>

        <div id="browseContent" style="display:none;">
            <div class="browse-collection-tabs" id="browseCollectionTabs"></div>

            <div class="browse-hero" id="browseHero">
                <div class="browse-hero-copy">
                    <div class="browse-eyebrow">Nuvio collection</div>
                    <h2 id="browseCollectionTitle"></h2>
                    <p id="browseCollectionDescription"></p>
                    <div class="browse-hero-stats" id="browseCollectionStats"></div>
                    <div class="browse-hero-actions">
                        <button class="btn btn-secondary browse-danger-btn" onclick="deleteCurrentBrowseCollection()">Supprimer la collection</button>
                    </div>
                </div>
            </div>

            <div class="browse-folder-toolbar">
                <div>
                    <h3>Dossiers</h3>
                    <small id="browseFolderSubtitle"></small>
                </div>
                <label class="browse-folder-search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
                    <input id="browseFolderSearch" type="text" placeholder="Filtrer les dossiers..." oninput="renderBrowseFolders()">
                </label>
            </div>

            <section class="browse-folder-grid" id="browseFolderGrid"></section>
        </div>

        <div class="browse-folder-view" id="browseFolderView">
            <div class="browse-folder-hero" id="browseFolderHero">
                <div class="browse-folder-copy">
                    <div style="display:flex; gap:.5rem; flex-wrap:wrap; margin-bottom:0.75rem;">
                        <button class="btn btn-secondary" onclick="closeBrowseFolder()">&larr; Retour aux dossiers</button>
                        <button class="btn btn-secondary browse-danger-btn" id="browseFolderDeleteBtn" onclick="deleteCurrentBrowseFolder()">Supprimer le dossier</button>
                    </div>
                    <div id="browseFolderLogoWrap"></div>
                    <h2 id="browseFolderTitle"></h2>
                    <p id="browseFolderSubtitle2"></p>
                    <div class="browse-hero-stats" id="browseFolderStats"></div>
                </div>
            </div>

            <div class="browse-folder-view-actions">
                <div class="discover-filters" id="browseTypeFilters">
                    <button class="active" data-type="all" onclick="setBrowseType('all', this)">Tous</button>
                    <button data-type="movie" onclick="setBrowseType('movie', this)">Films</button>
                    <button data-type="series" onclick="setBrowseType('series', this)">Séries</button>
                </div>
                <span class="browse-source-summary" id="browseSourceSummary"></span>
            </div>

            <section class="browse-poster-grid" id="browsePosterGrid"></section>
            <div class="browse-load-more">
                <button class="btn btn-secondary" id="browseLoadMoreBtn" onclick="loadMoreBrowseItems()">Load more</button>
            </div>
        </div>
    </div>

<div class="discover-modal-backdrop" id="mediaDetailBackdrop" onclick="closeMediaDetail(event)">
    <div class="discover-detail" role="dialog" aria-modal="true">
        <button class="discover-close" onclick="closeMediaDetail()">×</button>
        <div class="discover-detail-hero" id="mediaDetailHero">
            <div class="discover-detail-hero-content">
                <img class="discover-detail-poster" id="mediaDetailPoster" alt="">
                <div class="discover-detail-copy">
                    <h2 id="mediaDetailTitle"></h2>
                    <div class="discover-meta" id="mediaDetailMeta"></div>
                    <p class="discover-overview" id="mediaDetailOverview"></p>
                </div>
            </div>
        </div>
        <div class="discover-detail-body">
            <div class="discover-section-head">
                <div>
                    <h3>Sources</h3>
                    <small id="mediaSourceSubtitle">Find torrent sources from your configured addons.</small>
                </div>
                <button class="btn btn-primary" id="mediaFindSourcesBtn" onclick="findMediaSources()">Find sources</button>
            </div>

            <div class="discover-destination">
                <label for="mediaDestinationPath">Download destination</label>
                <div class="discover-filename-row">
                    <input id="mediaDestinationPath" list="mediaRecentPaths" value="{{ default_path|e('html_attr') }}">
                    <button class="btn btn-secondary" id="mediaAiPathButton" onclick="suggestMediaDestination(this)" title="AI Rename path">AI Path</button>
                </div>
                <small>Container path. Recent folders are suggested.</small>
            </div>

            <div class="discover-episode-row" id="mediaEpisodeRow" style="display:none;">
                <label class="discover-select">Season
                    <select id="mediaSeasonSelect" onchange="loadSelectedSeason()"></select>
                </label>
                <label class="discover-select">Episode
                    <select id="mediaEpisodeSelect" onchange="updateMediaSourceSubtitle()"></select>
                </label>
            </div>

            <div class="discover-loading" id="mediaStreamLoading">
                <div class="discover-spinner"></div>
                Querying configured stream addons...
            </div>

            <div class="discover-source-list" id="mediaSourceList"></div>
        </div>
    </div>
</div>

<div class="discover-modal-backdrop" id="mediaConfirmBackdrop" onclick="closeMediaConfirm(event)">
    <div class="discover-confirm" role="dialog" aria-modal="true">
        <h3>Send to Debrid</h3>
        <p id="mediaConfirmDescription"></p>
        <div class="discover-confirm-file" id="mediaConfirmFile"></div>
        <div class="discover-field">
            <label for="mediaConfirmFilename">File name</label>
            <div class="discover-filename-row">
                <input id="mediaConfirmFilename" placeholder="Keep source filename">
                <button class="btn btn-secondary" id="mediaAiRenameButton" onclick="suggestMediaFilename(this)" title="AI Rename">AI Rename</button>
            </div>
            <small>Leave empty to keep the source filename, or let AI suggest a clean name.</small>
        </div>
        <div class="discover-field">
            <label for="mediaConfirmPath">Destination path</label>
            <div class="discover-filename-row">
                <input id="mediaConfirmPath" list="mediaRecentPaths" value="{{ default_path|e('html_attr') }}">
                <button class="btn btn-secondary" onclick="suggestMediaDestination(this)" title="AI Rename path">AI Path</button>
            </div>
            <small>This path is a container path, like the existing Debrid download flow.</small>
            <div class="discover-recent-paths" id="mediaRecentPathChips"></div>
        </div>
        <div id="mediaConfirmStatus" class="discover-inline-status" style="display:none;"></div>
        <div class="discover-confirm-actions">
            <button class="btn btn-secondary" onclick="closeMediaConfirm()">Cancel</button>
            <button class="btn btn-primary" id="mediaConfirmButton" onclick="confirmMediaDebrid()">Add to queue</button>
        </div>
    </div>
</div>

<div class="addons-backdrop" id="addonsBackdrop" onclick="closeAddonsDrawer()"></div>
<aside class="addons-drawer" id="addonsDrawer" aria-label="Media addons settings">
    <div class="addons-head">
        <h2>Media addons</h2>
        <button class="btn btn-secondary" onclick="closeAddonsDrawer()">Close</button>
    </div>
    <div class="addons-body">
        <div class="addon-field">
            <label for="tmdbApiKey">TMDB API key</label>
            <input type="password" id="tmdbApiKey" value="" placeholder="{{ tmdb_key_saved ? 'Saved — leave blank to keep' : 'TMDB API key or v4 read token' }}" autocomplete="new-password">
            <small>Used for search, metadata, seasons and IMDb ID resolution.</small>
            <label style="display:inline-flex;align-items:center;gap:0.35rem;margin-top:0.35rem;color:var(--text-secondary);font-size:0.8rem;">
                <input type="checkbox" id="tmdbApiKeyClear"> Clear saved key
            </label>
        </div>
        <div class="addon-field">
            <label for="tmdbLanguage">Metadata language</label>
            <select id="tmdbLanguage">
                {% for code, label in {'fr-FR': 'Français (fr-FR)', 'en-US': 'English (en-US)', 'en-GB': 'English (en-GB)', 'es-ES': 'Español (es-ES)', 'de-DE': 'Deutsch (de-DE)', 'it-IT': 'Italiano (it-IT)', 'pt-BR': 'Português (pt-BR)'} %}
                <option value="{{ code }}" {{ tmdb_language == code ? 'selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="discover-section-head" style="margin-top:1.4rem;">
            <div>
                <h3>Stream manifests</h3>
                <small>HTTPS public URLs only. Lower priority numbers appear first.</small>
            </div>
        </div>

        <div class="addon-list" id="mediaAddonList"></div>

        <div class="addon-field" style="margin-top:1rem;">
            <label for="mediaAddonUrl">Add manifest URL</label>
            <input id="mediaAddonUrl" placeholder="https://addon.example/manifest.json" autocomplete="off">
            <small>Accepts a manifest URL or a configured addon URL that serves manifest JSON.</small>
        </div>
        <div class="addons-actions">
            <button class="btn btn-secondary" id="mediaValidateAddonButton" onclick="validateMediaAddon()">Validate</button>
            <button class="btn btn-primary" onclick="addMediaAddon()">Add addon</button>
        </div>
        <div id="mediaAddonStatus" class="discover-inline-status" style="display:none;"></div>

        <div class="discover-section-head" style="margin-top:1.6rem;">
            <div>
                <h3>Nuvio collections</h3>
                <small>Import a Nuvio collections JSON export.</small>
            </div>
        </div>
        <div class="addon-field">
            <label for="nuvioCollectionsFile">Collections JSON file</label>
            <input type="file" id="nuvioCollectionsFile" accept=".json,application/json" style="padding:0.5rem;">
            <small>Export from Nuvio → Collections. Sources from unconfigured addons stay pending and activate after the addon is added above.</small>
        </div>
        <div class="addon-field">
            <label for="nuvioCollectionsJson">Or paste JSON</label>
            <textarea id="nuvioCollectionsJson" rows="5" placeholder='[{"title":"Plateformes","folders":[...]}]' style="width:100%; padding:0.7rem; border-radius:9px; border:1px solid var(--border); background:rgba(15,23,42,0.8); color:var(--text-primary); font-family:monospace; font-size:0.72rem; resize:vertical;"></textarea>
        </div>
        <div class="addons-actions">
            <button class="btn btn-primary" id="nuvioImportButton" onclick="importNuvioCollections()">Import collections</button>
            <button class="btn btn-secondary" onclick="clearNuvioCollections()">Clear</button>
        </div>
        <div id="nuvioImportStatus" class="discover-inline-status" style="display:none;"></div>

        <div class="addons-save-row">
            <button class="btn btn-primary btn-full" id="mediaSaveSettingsButton" onclick="saveMediaSettings()">Save settings</button>
        </div>
    </div>
</aside>

<style>
    .discover-page { position: relative; }
    .discover-notice { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding:.9rem 1rem; margin-bottom:1rem; border:1px solid rgba(245,158,11,.25); background:rgba(245,158,11,.08); border-radius:12px; color:#fbbf24; font-size:.85rem; }
    .discover-notice strong { display:block; color:#fbbf24; margin-bottom:.15rem; }
    .discover-notice span { color:var(--text-secondary); }
    .discover-toolbar { display:flex; gap:.8rem; flex-wrap:wrap; align-items:center; background:var(--panel); border:1px solid var(--border); border-radius:16px; padding:.9rem; margin-bottom:1.5rem; backdrop-filter:blur(10px); }
    .discover-search { position:relative; flex:1; min-width:260px; }
    .discover-search svg { position:absolute; left:.95rem; top:50%; transform:translateY(-50%); opacity:.55; }
    .discover-search input { width:100%; padding:.85rem 1rem .85rem 2.8rem; border-radius:11px; border:1px solid var(--border); background:rgba(15,23,42,.8); color:var(--text-primary); outline:none; }
    .discover-filters { display:flex; gap:.3rem; padding:.25rem; background:rgba(15,23,42,.75); border:1px solid var(--border); border-radius:11px; }
    .discover-filters button { background:transparent; border:none; color:var(--text-secondary); padding:.55rem .9rem; border-radius:8px; font-size:.82rem; font-weight:650; cursor:pointer; }
    .discover-filters button.active { background:rgba(56,189,248,.15); color:var(--accent); }
    .discover-results-head { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:1rem; }
    .discover-results-head h2 { margin:0; font-size:1rem; }
    .discover-results-head span { color:var(--text-secondary); font-size:.82rem; }
    .discover-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(165px,1fr)); gap:1rem; }
    .media-card { position:relative; border-radius:14px; overflow:hidden; background:var(--panel-solid); border:1px solid var(--border); cursor:pointer; transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease; }
    .media-card:hover { transform:translateY(-4px); border-color:rgba(56,189,248,.35); box-shadow:0 18px 40px rgba(0,0,0,.35); }
    .media-poster-wrap { position:relative; aspect-ratio:2/3; background:linear-gradient(135deg,rgba(56,189,248,.12),rgba(129,140,248,.12)); }
    .media-poster-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
    .media-poster-wrap::after { content:""; position:absolute; inset:0; background:linear-gradient(to top,rgba(15,23,42,.95),transparent 45%); }
    .media-type-badge { position:absolute; top:.6rem; left:.6rem; z-index:2; font-size:.62rem; font-weight:800; letter-spacing:.06em; padding:.28rem .45rem; border-radius:6px; background:rgba(15,23,42,.82); border:1px solid rgba(255,255,255,.12); backdrop-filter:blur(8px); }
    .media-rating { position:absolute; right:.6rem; top:.6rem; z-index:2; font-size:.68rem; font-weight:800; color:#fbbf24; background:rgba(15,23,42,.82); border:1px solid rgba(251,191,36,.18); border-radius:6px; padding:.25rem .4rem; }
    .media-card-body { padding:.8rem .85rem .95rem; }
    .media-card-title { font-weight:750; font-size:.9rem; line-height:1.25; margin:0 0 .35rem; }
    .media-card-meta { color:var(--text-secondary); font-size:.75rem; display:flex; gap:.45rem; align-items:center; }
    .discover-dot { width:3px; height:3px; border-radius:50%; background:var(--text-secondary); }
    .discover-empty { display:none; padding:3rem 1rem; text-align:center; color:var(--text-secondary); border:1px dashed var(--border); border-radius:16px; }
    .discover-modal-backdrop { position:fixed; inset:0; z-index:2000; display:none; align-items:center; justify-content:center; padding:1.5rem; background:rgba(2,6,23,.78); backdrop-filter:blur(12px); }
    .discover-modal-backdrop.open { display:flex; }
    .discover-detail { width:min(980px,100%); max-height:92vh; overflow:auto; border-radius:20px; border:1px solid rgba(255,255,255,.1); background:var(--panel-solid); box-shadow:0 30px 90px rgba(0,0,0,.65); position:relative; }
    .discover-detail-hero { min-height:340px; position:relative; display:flex; align-items:flex-end; padding:2rem; background-size:cover; background-position:center; }
    .discover-detail-hero::before { content:""; position:absolute; inset:0; background:linear-gradient(to top,rgba(30,41,59,1) 4%,rgba(30,41,59,.75) 35%,rgba(15,23,42,.35) 100%),linear-gradient(to right,rgba(15,23,42,.7),transparent 60%); }
    .discover-detail-hero-content { position:relative; z-index:2; display:flex; gap:1.5rem; align-items:flex-end; width:100%; }
    .discover-detail-poster { width:150px; aspect-ratio:2/3; border-radius:12px; object-fit:cover; box-shadow:0 16px 42px rgba(0,0,0,.55); border:1px solid rgba(255,255,255,.12); flex-shrink:0; }
    .discover-detail-copy { flex:1; min-width:0; }
    .discover-detail-copy h2 { margin:0 0 .35rem; font-size:clamp(1.5rem,3vw,2.2rem); letter-spacing:-.03em; }
    .discover-meta { display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; color:var(--text-secondary); font-size:.85rem; margin-bottom:.8rem; }
    .discover-pill { display:inline-flex; align-items:center; gap:.35rem; border-radius:999px; padding:.28rem .55rem; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.08); font-size:.72rem; color:var(--text-primary); }
    .discover-overview { margin:0; color:#cbd5e1; line-height:1.55; font-size:.9rem; max-width:720px; }
    .discover-close { position:absolute; top:1rem; right:1rem; z-index:5; width:38px; height:38px; border-radius:10px; border:1px solid rgba(255,255,255,.1); background:rgba(15,23,42,.8); color:var(--text-primary); font-size:1.5rem; line-height:1; cursor:pointer; }
    .discover-detail-body { padding:1.5rem 2rem 2rem; }
    .discover-section-head { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:.85rem; }
    .discover-section-head h3 { margin:0; font-size:1rem; }
    .discover-section-head small { color:var(--text-secondary); }
    .discover-episode-row { display:flex; gap:.75rem; flex-wrap:wrap; align-items:center; margin-bottom:1rem; }
    .discover-select { display:flex; align-items:center; gap:.5rem; background:rgba(15,23,42,.7); border:1px solid var(--border); border-radius:10px; padding:.35rem .5rem; color:var(--text-secondary); font-size:.8rem; }
    .discover-select select { border:none; background:transparent; color:var(--text-primary); outline:none; padding:.35rem; }
    .discover-source-list { display:grid; gap:.65rem; }
    .discover-source { display:flex; gap:1rem; align-items:center; justify-content:space-between; background:rgba(15,23,42,.55); border:1px solid var(--border); border-radius:12px; padding:.85rem 1rem; transition:border-color .15s ease,background .15s ease; }
    .discover-source:hover { border-color:rgba(56,189,248,.3); background:rgba(15,23,42,.8); }
    .discover-source-main { min-width:0; }
    .discover-source-top { display:flex; gap:.45rem; align-items:center; flex-wrap:wrap; margin-bottom:.25rem; }
    .discover-source-addon { font-size:.68rem; font-weight:800; text-transform:uppercase; letter-spacing:.06em; color:var(--accent); }
    .discover-source-quality { font-weight:800; font-size:.82rem; }
    .discover-source-title { color:var(--text-secondary); font-size:.78rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:560px; }
    .discover-source-meta { display:flex; gap:.65rem; flex-wrap:wrap; margin-top:.45rem; font-size:.72rem; color:var(--text-secondary); }
    .discover-seeders { color:var(--success); font-weight:700; }
    .discover-loading { display:none; padding:2rem; border:1px dashed var(--border); border-radius:12px; text-align:center; color:var(--text-secondary); }
    .discover-spinner { width:24px; height:24px; border:3px solid rgba(255,255,255,.08); border-top-color:var(--accent); border-radius:50%; animation:discover-spin .9s linear infinite; margin:0 auto .75rem; }
    @keyframes discover-spin { to { transform:rotate(360deg); } }
    .addons-backdrop { position:fixed; inset:0; background:rgba(2,6,23,.65); backdrop-filter:blur(8px); z-index:3000; display:none; }
    .addons-backdrop.open { display:block; }
    .addons-drawer { position:fixed; top:0; right:0; bottom:0; width:min(520px,100%); z-index:3100; background:var(--panel-solid); border-left:1px solid var(--border); transform:translateX(102%); transition:transform .25s ease; display:flex; flex-direction:column; }
    .addons-drawer.open { transform:translateX(0); }
    .addons-head { padding:1.25rem 1.4rem; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:1rem; }
    .addons-head h2 { margin:0; font-size:1.05rem; }
    .addons-body { padding:1.25rem 1.4rem 2rem; overflow-y:auto; }
    .addon-field { margin-bottom:1.1rem; }
    .addon-field label { display:block; font-size:.78rem; color:var(--text-secondary); margin-bottom:.45rem; }
    .addon-field input, .addon-field select { width:100%; padding:.7rem .8rem; border-radius:9px; border:1px solid var(--border); background:rgba(15,23,42,.8); color:var(--text-primary); outline:none; }
    .addon-field small { display:block; color:var(--text-secondary); font-size:.7rem; margin-top:.4rem; line-height:1.4; }
    .addon-list { display:grid; gap:.65rem; margin-bottom:1rem; }
    .addon-row { display:flex; align-items:center; gap:.8rem; padding:.8rem; border-radius:11px; border:1px solid var(--border); background:rgba(15,23,42,.45); width:100%; min-width:0; overflow:hidden; }
    .addon-status { width:9px; height:9px; border-radius:50%; background:var(--success); box-shadow:0 0 10px rgba(34,197,94,.6); flex-shrink:0; }
    .addon-status.off { background:var(--text-secondary); box-shadow:none; }
    .addon-status.pending { background:#fbbf24; box-shadow:0 0 10px rgba(251,191,36,.6); }
