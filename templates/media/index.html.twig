<script>
const initialMedia = {{ trending|json_encode|raw }};
const mediaLanguage = {{ tmdb_language|json_encode|raw }};
const tmdbConfigured = {{ tmdb_configured ? 'true' : 'false' }};
const defaultMediaPath = {{ default_path|json_encode|raw }};
const recentMediaPaths = {{ recent_paths|json_encode|raw }};
let mediaResults = initialMedia;
let destinationAutoValue = '';
let activeMedia = null;
let activeMediaDetails = null;
let activeType = 'all';
let mediaSearchTimer = null;
let mediaStreams = [];
let activeEpisodes = [];
let pendingStream = null;
let pendingAddon = null;
let addonsState = {{ media_addons|json_encode|raw }};
const nuvioCollections = {{ nuvio_collections|json_encode|raw }};
const nuvioMeta = {{ nuvio_meta|json_encode|raw }};
const mediaDetailsRoute = "{{ path('media_details', {type: 'TYPE', id: 0}) }}";
const mediaSeasonRoute = "{{ path('media_season', {id: 0, season: 0}) }}";

if (!Array.isArray(addonsState)) addonsState = [];

let discoveryMode = 'search';
let browseCollectionIndex = 0;
let browseFolder = null;
let browseType = 'all';
let browseVisible = 12;
let browseSourceStates = [];
let browseMergedItems = [];
let browseFilteredItems = [];

function escapeMediaHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
    }[char]));
}

function renderMediaCards() {
    const grid = document.getElementById('mediaGrid');
    const empty = document.getElementById('mediaEmptyState');
    grid.innerHTML = '';

    mediaResults.forEach(item => {
        const card = document.createElement('article');
        card.className = 'media-card';
        const poster = item.poster
            ? `<img src="${escapeMediaHtml(item.poster)}" alt="${escapeMediaHtml(item.title)}" loading="lazy">`
            : '';
        card.innerHTML = `
            <div class="media-poster-wrap">
                <span class="media-type-badge">${item.type === 'movie' ? 'MOVIE' : 'SERIES'}</span>
                ${item.rating ? `<span class="media-rating">${escapeMediaHtml(item.rating)}</span>` : ''}
                ${poster}
            </div>
            <div class="media-card-body">
                <h3 class="media-card-title">${escapeMediaHtml(item.title)}</h3>
                <div class="media-card-meta">
                    <span>${escapeMediaHtml(item.year || '—')}</span>
                    <span class="discover-dot"></span>
                    <span>${item.type === 'movie' ? 'Movie' : 'Series'}</span>
                </div>
            </div>
        `;
        card.addEventListener('click', () => openMediaDetail(item));
        grid.appendChild(card);
    });

    empty.style.display = mediaResults.length === 0 ? 'block' : 'none';
    document.getElementById('mediaResultsCount').textContent = mediaResults.length + ' title' + (mediaResults.length === 1 ? '' : 's');
    document.getElementById('mediaResultsTitle').textContent = document.getElementById('mediaSearchInput').value.trim() ? 'Search results' : 'Popular picks';
}

function setMediaType(type, button) {
    activeType = type;
    document.querySelectorAll('#mediaTypeFilters button').forEach(btn => btn.classList.toggle('active', btn === button));
    performMediaSearch();
}

function debouncedMediaSearch() {
    clearTimeout(mediaSearchTimer);
    mediaSearchTimer = setTimeout(performMediaSearch, 350);
}

async function performMediaSearch() {
    const query = document.getElementById('mediaSearchInput').value.trim();
    if (!query) {
        mediaResults = activeType === 'all' ? initialMedia : initialMedia.filter(item => item.type === activeType);
        renderMediaCards();
        return;
    }

    try {
        const response = await fetch(`{{ path('media_search') }}?q=${encodeURIComponent(query)}&type=${encodeURIComponent(activeType)}`);
        const data = await response.json();
        mediaResults = Array.isArray(data.results) ? data.results : [];
    } catch (error) {
        mediaResults = [];
    }
    renderMediaCards();
}

async function openMediaDetail(item) {
    activeMedia = item;
    activeMediaDetails = null;
    activeEpisodes = [];
    mediaStreams = [];
    document.getElementById('mediaDetailHero').style.backgroundImage = item.backdrop ? `url("${item.backdrop}")` : '';
    document.getElementById('mediaDetailPoster').src = item.poster || '';
    document.getElementById('mediaDetailPoster').alt = item.title;
    document.getElementById('mediaDetailTitle').textContent = item.title;
    document.getElementById('mediaDetailOverview').textContent = item.overview || '';
    document.getElementById('mediaDetailMeta').innerHTML = `
        <span class="discover-pill">${item.type === 'movie' ? 'Movie' : 'Series'}</span>
        <span>${escapeMediaHtml(item.year || '')}</span>
        ${item.rating ? `<span class="discover-dot"></span><span>IMDb ${escapeMediaHtml(item.rating)}</span>` : ''}
    `;
    document.getElementById('mediaEpisodeRow').style.display = item.type === 'series' ? 'flex' : 'none';
    document.getElementById('mediaSourceList').innerHTML = '';
    document.getElementById('mediaStreamLoading').style.display = 'none';
    document.getElementById('mediaFindSourcesBtn').style.display = 'inline-flex';
    document.getElementById('mediaFindSourcesBtn').disabled = false;
    document.getElementById('mediaFindSourcesBtn').textContent = 'Find sources';
    document.getElementById('mediaSourceSubtitle').textContent = 'Find torrent sources from your configured addons.';
    document.getElementById('mediaDestinationPath').value = buildMediaDestination(item.type, item.title, item.year, 1);
    destinationAutoValue = document.getElementById('mediaDestinationPath').value;
    document.getElementById('mediaDetailBackdrop').classList.add('open');
    document.body.style.overflow = 'hidden';

    try {
        const response = await fetch(mediaDetailsRoute.replace('TYPE', item.type).replace(/\/0$/, '/' + item.id));
        const data = await response.json();
        if (!data.success || !data.details) return;

        activeMediaDetails = data.details;
        document.getElementById('mediaDetailHero').style.backgroundImage = activeMediaDetails.backdrop ? `url("${activeMediaDetails.backdrop}")` : '';
        document.getElementById('mediaDetailPoster').src = activeMediaDetails.poster || item.poster || '';
        document.getElementById('mediaDetailTitle').textContent = activeMediaDetails.title;
        document.getElementById('mediaDetailOverview').textContent = activeMediaDetails.overview || '';
        document.getElementById('mediaDetailMeta').innerHTML = `
            <span class="discover-pill">${activeMediaDetails.type === 'movie' ? 'Movie' : 'Series'}</span>
