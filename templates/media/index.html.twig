            ${(activeMediaDetails.genres || []).map(genre => `<span class="discover-pill">${escapeMediaHtml(genre)}</span>`).join('')}
        `;

        if (activeMediaDetails.type === 'series') {
            const seasons = (activeMediaDetails.seasons || []).filter(season => season.episode_count > 0 && season.season_number > 0);
            const seasonSelect = document.getElementById('mediaSeasonSelect');
            seasonSelect.innerHTML = seasons.map(season => `<option value="${season.season_number}">${escapeMediaHtml(season.name)}</option>`).join('');
