    if (!pendingStream) return;
    const season = activeMediaDetails.type === 'series' ? document.getElementById('mediaSeasonSelect').value : null;
    document.getElementById('mediaConfirmDescription').textContent = pendingStream.kind === 'direct'
        ? 'This direct video source will be added to the download queue.'
        : 'The torrent will be added to Alldebrid, then the selected file will be queued for download.';
    document.getElementById('mediaConfirmFile').textContent = mediaStreamFilename(pendingStream);
    const jellyfinFilename = buildMediaFilename(pendingStream);
    document.getElementById('mediaConfirmFilename').value = jellyfinFilename || pendingStream.filename || '';
    const destinationInput = document.getElementById('mediaDestinationPath');
    document.getElementById('mediaConfirmPath').value = destinationInput.value.trim()
        || buildMediaDestination(activeMediaDetails.type, activeMediaDetails.title, activeMediaDetails.year, season);
    document.getElementById('mediaConfirmStatus').style.display = 'none';
    renderRecentPathChips();
    document.getElementById('mediaConfirmButton').disabled = false;
    document.getElementById('mediaConfirmButton').textContent = 'Add to queue';
    document.getElementById('mediaConfirmBackdrop').classList.add('open');
}

function closeMediaConfirm(event) {
