function joinMediaPath(base, relative) {
    const cleanBase = String(base || '').replace(/\/+$/, '');
    const cleanRelative = String(relative || '').replace(/^\/+/, '');
    if (!cleanRelative) return cleanBase;
    return cleanBase + '/' + cleanRelative;
}

function withVideoExtension(name, stream) {
    const value = String(name || '').trim();
    if (!value || stream.kind !== 'direct') return value;
    if (/\.(mkv|mp4|avi|mov|m4v|webm|wmv|ts|m2ts|mpg|mpeg)$/i.test(value)) return value;
    return value + '.mkv';
}

function mediaStreamFilename(stream) {
    if (!stream) return 'Selected file';

    const explicit = String(stream.filename || '').trim();
    if (explicit) return withVideoExtension(explicit, stream);

    const lines = String(stream.title || '')
        .split('\n')
        .map(line => line.trim())
        .filter(Boolean);

    for (const line of lines) {
        const folderMatch = line.match(/(?:📁|📂)\s*([^\n]+)/u);
        if (folderMatch && folderMatch[1].trim()) {
            const folderName = folderMatch[1].replace(/[^\p{L}\p{N}\u0029\u005D._-]+$/u, '').trim();
            return withVideoExtension(folderName, stream);
        }
    }

    const videoLine = [...lines].reverse().find(line => /\.(mkv|mp4|avi|mov|m4v|webm|ts|m2ts)$/i.test(line));
    if (videoLine) return videoLine;

    if (stream.kind === 'direct' && lines.length > 0) {
        const lastLine = lines[lines.length - 1];
        if (lastLine) return withVideoExtension(lastLine, stream);
    }

    try {
        if (!stream.url) throw new Error('No URL');
        const path = new URL(stream.url).pathname;
        const base = decodeURIComponent(path.split('/').filter(Boolean).pop() || '');
        if (base) return withVideoExtension(base, stream);
    } catch (error) {
    }

    return stream.kind === 'direct' ? withVideoExtension('Direct video source', stream) : 'Selected torrent file';
}

function getMediaAiContext() {
    const season = activeMediaDetails && activeMediaDetails.type === 'series'
        ? document.getElementById('mediaSeasonSelect').value
        : null;
    const episode = activeMediaDetails && activeMediaDetails.type === 'series'
        ? document.getElementById('mediaEpisodeSelect').value
        : null;
    const suffix = season && episode
        ? ` S${String(season).padStart(2, '0')}E${String(episode).padStart(2, '0')}`
        : '';
    const packName = activeMediaDetails.title
        + (activeMediaDetails.year ? ' (' + activeMediaDetails.year + ')' : '')
        + suffix;
    const sourceName = (pendingStream && mediaStreamFilename(pendingStream))
        || (activeMediaDetails.title + (activeMediaDetails.year ? ' (' + activeMediaDetails.year + ')' : '') + suffix + '.mkv');

    return { packName, sourceName };
}

async function requestMediaAiSuggestion(button) {
    const context = getMediaAiContext();
    const originalText = button.innerHTML;
    button.disabled = true;
    button.textContent = 'AI...';

    try {
        const formData = new FormData();
        formData.append('packName', context.packName);
        formData.append('files[]', context.sourceName);

        const response = await fetch("{{ path('post_rename_ai') }}", {
            method: 'POST',
            body: formData
        });
        const data = await response.json();
        const suggestions = data.suggestions || {};
        return suggestions[context.sourceName] || Object.values(suggestions)[0] || null;
    } catch (error) {
        window.notify('error', 'AI rename failed: ' + error.message);
        return null;
    } finally {
        button.disabled = false;
        button.innerHTML = originalText;
    }
}

function applyMediaAiPath(suggestion) {
    if (!suggestion || !suggestion.path) return false;
    const destination = joinMediaPath(defaultMediaPath, suggestion.path);
    document.getElementById('mediaDestinationPath').value = destination;
    destinationAutoValue = destination;
    const confirmPath = document.getElementById('mediaConfirmPath');
    if (confirmPath) confirmPath.value = destination;
    return true;
}

async function suggestMediaDestination(button) {
    if (!activeMediaDetails) return;
    const suggestion = await requestMediaAiSuggestion(button);
    if (!suggestion) {
        window.notify('info', 'AI did not return a path suggestion.');
        return;
    }
    if (!applyMediaAiPath(suggestion)) {
        window.notify('info', 'AI did not return a path suggestion.');
    }
}

async function suggestMediaFilename(button) {
    if (!pendingStream || !activeMediaDetails) return;

    const suggestion = await requestMediaAiSuggestion(button);
    if (!suggestion || !suggestion.filename) {
        window.notify('info', 'AI did not return a filename suggestion.');
        return;
    }

    document.getElementById('mediaConfirmFilename').value = suggestion.filename;
    if (suggestion.path) {
        applyMediaAiPath(suggestion);
    }
}

function sanitizeMediaFilenamePart(value) {
    return String(value || '')
        .replace(/[\\/:*?"<>|]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
}

function getSelectedEpisode() {
    if (!activeMediaDetails || activeMediaDetails.type !== 'series') return null;
    const season = Number(document.getElementById('mediaSeasonSelect').value);
    const episode = Number(document.getElementById('mediaEpisodeSelect').value);
    if (!season || !episode) return null;
    const match = activeEpisodes.find(entry => Number(entry.episode_number) === episode);
    return { season, episode, title: match ? match.name : '' };
}

function videoExtensionFor(stream) {
    const source = mediaStreamFilename(stream);
    const match = String(source || '').match(/\.(mkv|mp4|avi|mov|m4v|webm|wmv|ts|m2ts|mpg|mpeg)$/i);
    return match ? match[0] : '.mkv';
}

function buildMediaFilename(stream) {
    if (!activeMediaDetails) return '';
    const title = sanitizeMediaFilenamePart(activeMediaDetails.title);
    if (!title) return '';
    const year = activeMediaDetails.year ? ' (' + activeMediaDetails.year + ')' : '';
    const extension = videoExtensionFor(stream);

    if (activeMediaDetails.type === 'series') {
        const selected = getSelectedEpisode();
        if (!selected) return '';
        const code = 'S'
            + String(selected.season).padStart(2, '0')
            + 'E'
            + String(selected.episode).padStart(2, '0');
        const episodeTitle = selected.title ? ' - ' + sanitizeMediaFilenamePart(selected.title) : '';
        return `${title}${year} - ${code}${episodeTitle}${extension}`;
    }

    return `${title}${year}${extension}`;
}

function buildMediaDestination(type, title, year, season) {
    const base = defaultMediaPath ? defaultMediaPath.replace(/\/+$/, '') : '/nas';
    const safeTitle = String(title || '').replace(/[/\\]/g, '-');
    if (type === 'series') {
        const folder = safeTitle + (year ? ' (' + year + ')' : '');
        const seasonNumber = String(Number(season) || 1).padStart(2, '0');
        return `${base}/Video/TV Shows/${folder}/Season ${seasonNumber}/`;
    }
    return `${base}/Video/Movies/${safeTitle}${year ? ' (' + year + ')' : ''}/`;
}

function openMediaConfirm(index) {
