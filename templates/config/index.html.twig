                        <div style="display: flex; gap: 0.5rem;">
                            <input type="file" id="config_zip_import" accept=".zip" style="display: none;" onchange="handleConfigImport(this)">
                            <button type="button" class="btn btn-warning" onclick="document.getElementById('config_zip_import').click()" style="width: 100%;">
