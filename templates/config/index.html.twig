{% block javascripts %}
<script>
const aiModelsRoute = "{{ path('config_ai_models') }}";
const aiTestRoute = "{{ path('config_ai_test') }}";
const aiUsageLabels = {
    default: 'Default model',
    renaming: 'Media renaming',
    music_genre: 'Music genre'
};
let aiModelCatalog = [];
let aiModelsLoaded = false;

function getAiProvider() {
    return document.getElementById('ai_provider')?.value || 'openrouter';
}

function getAiInputValue(id) {
    return document.getElementById(id)?.value?.trim() || '';
}

function setAiModelsStatus(message, type) {
    const el = document.getElementById('ai-models-status');
    if (!el) return;
    el.style.display = 'block';
    if (type === 'error') {
        el.style.background = 'rgba(220, 53, 69, 0.1)';
        el.style.color = 'var(--danger)';
        el.style.border = '1px solid var(--danger)';
    } else if (type === 'success') {
        el.style.background = 'rgba(40, 167, 69, 0.1)';
        el.style.color = 'var(--success)';
        el.style.border = '1px solid var(--success)';
    } else {
        el.style.background = 'rgba(255,255,255,0.05)';
        el.style.color = 'var(--text-secondary)';
        el.style.border = '1px solid rgba(255,255,255,0.1)';
    }
    el.textContent = message;
}

function formatAiPrice(value) {
    const parsed = parseFloat(value);
    if (!Number.isFinite(parsed)) return '?';
    if (parsed === 0) return 'free';
    const perMillion = parsed * 1000000;
    return '$' + perMillion.toFixed(perMillion < 0.01 ? 4 : 2);
}

async function loadAiModels(force = false) {
    if (aiModelsLoaded && !force) return;

    setAiModelsStatus('Loading OpenRouter model catalog...', 'info');

    try {
        const response = await fetch(aiModelsRoute, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ api_key: getAiInputValue('openrouter_api_key') })
        });
        const data = await response.json();

        if (!data.success) {
            setAiModelsStatus('❌ ' + (data.error || 'Could not load the OpenRouter catalog.'), 'error');
            return;
        }

        aiModelCatalog = data.models || [];
        aiModelsLoaded = true;
        setAiModelsStatus('✅ ' + aiModelCatalog.length + ' OpenRouter models loaded.', 'success');
        renderAllAiModelLists();
    } catch (e) {
        setAiModelsStatus('❌ ' + e.message, 'error');
    }
}

function renderAllAiModelLists() {
    ['default', 'renaming', 'music_genre'].forEach(renderAiModelList);
}

function renderAiModelList(usage) {
    const list = document.getElementById('ai-model-list-' + usage);
    if (!list) return;

    list.innerHTML = '';

    if (aiModelCatalog.length === 0) {
        const empty = document.createElement('div');
        empty.style.padding = '0.75rem';
        empty.style.color = 'var(--text-secondary)';
        empty.style.fontSize = '0.85rem';
        empty.textContent = 'No catalog loaded. You can still type a model ID manually.';
        list.appendChild(empty);
        return;
    }

    const search = (document.getElementById('ai-model-search-' + usage)?.value || '').toLowerCase();
    const selected = getAiInputValue('ai_model_' + usage);
    const matches = aiModelCatalog
        .filter(model => !search || model.id.toLowerCase().includes(search) || model.name.toLowerCase().includes(search))
        .slice(0, 200);

    if (matches.length === 0) {
        const empty = document.createElement('div');
        empty.style.padding = '0.75rem';
        empty.style.color = 'var(--text-secondary)';
        empty.textContent = 'No matching models.';
        list.appendChild(empty);
        return;
    }

    matches.forEach(model => {
        const row = document.createElement('button');
        row.type = 'button';
        row.style.display = 'block';
        row.style.width = '100%';
        row.style.textAlign = 'left';
        row.style.padding = '0.6rem';
        row.style.marginBottom = '0.25rem';
        row.style.background = model.id === selected ? 'rgba(56, 189, 248, 0.15)' : 'transparent';
        row.style.border = '1px solid transparent';
        row.style.borderRadius = '6px';
        row.style.color = 'var(--text-primary)';
        row.style.cursor = 'pointer';

        const name = document.createElement('div');
        name.style.fontWeight = '600';
        name.textContent = model.name;

        const meta = document.createElement('div');
        meta.style.fontSize = '0.75rem';
        meta.style.color = 'var(--text-secondary)';
        const context = model.context_length ? model.context_length.toLocaleString() + ' ctx' : 'ctx ?';
        meta.textContent = model.id + ' · ' + context + ' · ' + formatAiPrice(model.pricing?.prompt) + ' in / ' + formatAiPrice(model.pricing?.completion) + ' out' + (model.supports_json ? ' · JSON' : '');

        row.appendChild(name);
        row.appendChild(meta);
        row.addEventListener('click', () => {
            const input = document.getElementById('ai_model_' + usage);
            if (input) input.value = model.id;
            const browser = document.getElementById('ai-model-browser-' + usage);
            if (browser) browser.style.display = 'none';
            const status = document.getElementById('ai-model-status-' + usage);
            if (status) {
                status.style.display = 'block';
                status.style.color = 'var(--success)';
                status.textContent = 'Selected: ' + model.name + ' (' + model.id + ')';
            }
            renderAiModelList(usage);
        });

        list.appendChild(row);
    });
}

function toggleAiModelBrowser(usage) {
    const browser = document.getElementById('ai-model-browser-' + usage);
    if (!browser) return;

    const willOpen = browser.style.display === 'none' || browser.style.display === '';
    browser.style.display = willOpen ? 'block' : 'none';

    if (willOpen) {
        if (!aiModelsLoaded) loadAiModels(false);
        const search = document.getElementById('ai-model-search-' + usage);
        if (search) search.focus();
    }
}

async function testAiUsage(usage, btn) {
    const provider = getAiProvider();
    const keyInput = provider === 'xai' ? 'grok_api_key' : 'openrouter_api_key';
    const modelInput = provider === 'xai'
        ? (usage === 'music_genre' ? 'music_genre_grok_model' : 'grok_model')
        : 'ai_model_' + usage;
    const status = document.getElementById('ai-model-status-' + usage);
    const originalText = btn.textContent;

    if (status) {
        status.style.display = 'block';
        status.style.color = 'var(--text-secondary)';
        status.textContent = 'Testing ' + (aiUsageLabels[usage] || usage) + '...';
    }

    btn.disabled = true;
    btn.textContent = '⌛';

    try {
        const response = await fetch(aiTestRoute, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                usage: usage,
                provider: provider,
                api_key: getAiInputValue(keyInput),
                model: getAiInputValue(modelInput)
            })
        });
        const data = await response.json();

        if (status) {
            status.style.display = 'block';
            status.style.color = data.success ? 'var(--success)' : 'var(--danger)';
            status.textContent = data.success
                ? '✅ ' + (aiUsageLabels[usage] || usage) + ' OK · ' + data.provider + ' · ' + data.model + ' · ' + data.latency_ms + ' ms'
                : '❌ ' + (data.error || 'Test failed.');
        }
    } catch (e) {
        if (status) {
            status.style.display = 'block';
            status.style.color = 'var(--danger)';
            status.textContent = '❌ ' + e.message;
        }
    } finally {
        btn.disabled = false;
        btn.textContent = originalText;
    }
}

document.addEventListener('DOMContentLoaded', () => {
    if (getAiProvider() === 'openrouter' && getAiInputValue('openrouter_api_key') !== '') {
        loadAiModels(false);
    }
});

document.getElementById('btn-generate-auth').addEventListener('click', async function() {
    const btn = this;
    const btnText = document.getElementById('auth-btn-text');
    const btnSpinner = document.getElementById('auth-btn-spinner');
    const statusDiv = document.getElementById('auth-status');

    if (!confirm('This will execute the librespot-auth command. You might need to check the logs or external browser to complete authentication. Continue?')) {
        return;
    }

    btn.disabled = true;
    btnText.style.display = 'none';
    btnSpinner.style.display = 'inline';
    statusDiv.style.display = 'block';
    statusDiv.style.color = 'var(--accent)';
    
    // Generate a temporary device name to show while loading (matches PHP logic)
    const tempName = "Speaker xxx";
    const deviceClass = document.getElementById('music_librespot_auth_class')?.value || 'computer';
    statusDiv.innerHTML = `
        <div style="background: rgba(23, 162, 184, 0.1); padding: 1rem; border-radius: 8px; border: 1px solid #17a2b8; margin-bottom: 1rem;">
            <p style="margin: 0 0 0.5rem 0; font-weight: bold; color: #17a2b8;">🎧 Action Required: Spotify Connect Login</p>
            <p style="margin: 0; font-size: 0.9rem;">
                Please open your Spotify app on your phone or computer (on the same network).<br>
                Select the device named <strong>"${tempName}"</strong> (type: <strong>${deviceClass}</strong>) from the available devices list to complete the authentication.
            </p>
        </div>
        <p style="text-align: center; color: var(--text-secondary); font-size: 0.8rem;">⌛ Waiting for connection from Spotify...</p>
    `;

    try {
        const response = await fetch("{{ path('config_spotify_auth') }}", {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const result = await response.json();
        
        if (result.success) {
            statusDiv.style.color = 'var(--success)';
            statusDiv.innerText = '✅ ' + result.message;
            // Hide the button since file now exists
            btn.style.display = 'none';
            // Update the path field
            const credsInput = document.getElementById('music_creds');
            if (credsInput) {
                credsInput.value = result.path;
            }
        } else {
            statusDiv.style.color = 'var(--danger)';
            let errHtml = '❌ ' + result.message;
            
            if (result.debug) {
                errHtml += '<div style="margin-top:0.5rem; font-family:monospace; font-size:0.75rem; background:rgba(0,0,0,0.3); padding:0.5rem; border-radius:4px; border:1px solid var(--accent);">';
                errHtml += '<strong>Environment:</strong><br>';
                errHtml += 'User: ' + result.debug.user + '<br>';
                errHtml += 'PHP CWD: ' + (result.debug.php_cwd || 'unknown') + '<br>';
                errHtml += 'Home Writable: ' + result.debug.home_writable + '<br>';
                errHtml += 'Binary Executable: ' + result.debug.binary_executable + '<br>';
                errHtml += 'Binary Path: ' + result.debug.binary_path + '<br>';
                errHtml += 'Expected File: ' + result.debug.expected_file + '</div>';
            }

            if (result.command) {
                errHtml += '<div style="margin-top:0.5rem; font-family:monospace; font-size:0.75rem; background:rgba(0,0,0,0.3); padding:0.5rem; border-radius:4px; border:1px solid var(--danger);">';
                errHtml += '<strong>Command:</strong><br>' + result.command + '<br><br>';
                errHtml += '<strong>Output:</strong><br>' + (result.output || '(no output)') + '</div>';
            }
            statusDiv.innerHTML = errHtml;
        }
    } catch (e) {
        statusDiv.style.color = 'var(--danger)';
        statusDiv.innerText = '❌ Error: ' + e.message;
    } finally {
        btn.disabled = false;
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
    }
});

document.getElementById('btn-update-hash-db').addEventListener('click', async function() {
    const btn = this;
    const btnText = document.getElementById('update-db-text');
    const btnSpinner = document.getElementById('update-db-spinner');
    const statusDiv = document.getElementById('update-db-status');

    if (!confirm('This will trigger a composer update for the torrent database. It might take a while and could potentially slow down the app. Continue?')) {
        return;
    }

    btn.disabled = true;
    btnText.style.display = 'none';
    btnSpinner.style.display = 'inline';
    statusDiv.style.display = 'block';
    statusDiv.style.background = 'rgba(255,255,255,0.05)';
    statusDiv.style.color = 'var(--text-secondary)';
    statusDiv.innerText = 'Starting update... please wait.';

    try {
        const response = await fetch("{{ path('config_update_hash_db') }}", {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const raw = await response.text();
        let result;
        try {
            result = JSON.parse(raw);
        } catch (parseError) {
            statusDiv.style.background = 'rgba(220, 53, 69, 0.1)';
            statusDiv.style.color = 'var(--danger)';
            statusDiv.style.border = '1px solid var(--danger)';
            statusDiv.innerText = '❌ The server returned a non-JSON response (HTTP ' + response.status + ').\n'
                + 'The update may have completed anyway — reload and check the database, then retry safely (already imported hashes are skipped).\n\n'
                + 'Server response:\n' + raw.slice(0, 500);
            return;
        }

        if (result.success) {
            statusDiv.style.background = 'rgba(40, 167, 69, 0.1)';
            statusDiv.style.color = 'var(--success)';
            statusDiv.style.border = '1px solid var(--success)';
            statusDiv.innerText = '✅ ' + result.message + '\n\n' + (result.output || '');
        } else {
            statusDiv.style.background = 'rgba(220, 53, 69, 0.1)';
            statusDiv.style.color = 'var(--danger)';
            statusDiv.style.border = '1px solid var(--danger)';
            statusDiv.innerText = '❌ ' + result.message + '\n\n' + (result.details || '');
        }
    } catch (e) {
        statusDiv.style.background = 'rgba(220, 53, 69, 0.1)';
        statusDiv.style.color = 'var(--danger)';
        statusDiv.style.border = '1px solid var(--danger)';
        statusDiv.innerText = '❌ Error: ' + e.message;
    } finally {
        btn.disabled = false;
        btnText.style.display = 'inline';
        btnSpinner.style.display = 'none';
    }
});

async function handleConfigImport(input) {
    if (!input.files || input.files.length === 0) return;
    
    const file = input.files[0];
    if (!confirm(`Are you sure you want to import ${file.name}? This will immediately overwrite your current settings.`)) {
        input.value = '';
        return;
    }

    const statusDiv = document.getElementById('import-status');
    statusDiv.style.display = 'block';
    statusDiv.style.color = 'var(--text-secondary)';
    statusDiv.innerText = 'Uploading and extracting...';

    const formData = new FormData();
    formData.append('config_zip', file);

    try {
        const response = await fetch("{{ path('config_import') }}", {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        
        const result = await response.json();
        
        if (result.success) {
            statusDiv.style.color = 'var(--success)';
            statusDiv.innerText = '✅ ' + result.message + ' Reloading page...';
            setTimeout(() => location.reload(), 1500);
        } else {
            statusDiv.style.color = 'var(--danger)';
            statusDiv.innerText = '❌ ' + result.message;
        }
    } catch (e) {
        statusDiv.style.color = 'var(--danger)';
        statusDiv.innerText = '❌ Network error during import: ' + e.message;
    } finally {
        input.value = ''; // Reset input so the same file could be selected again if needed
    }
}

function updateMusicQualityNote() {
    const select = document.getElementById('music_quality');
    const note = document.getElementById('music-quality-note');
    if (!select || !note) return;

    const notes = {
        auto: { text: 'Auto: 320 kbps with Premium, 160 kbps with a Free account.', color: 'var(--success)' },
        high: { text: 'High: 160 kbps — works with Free and Premium accounts.', color: 'var(--success)' },
        normal: { text: 'Normal: 96 kbps — works with Free and Premium accounts.', color: 'var(--text-secondary)' },
        very_high: { text: 'Very High: 320 kbps — Premium only. A Free account will fail with "Audio key error".', color: 'var(--warning)' }
    };

    const info = notes[select.value] || notes.auto;
    note.textContent = info.text;
    note.style.color = info.color;
}

const musicQualitySelect = document.getElementById('music_quality');
if (musicQualitySelect) {
    musicQualitySelect.addEventListener('change', updateMusicQualityNote);
    updateMusicQualityNote();
}

const pwaRoutes = {
    status: "{{ path('pwa_status') }}",
    vapid: "{{ path('pwa_vapid_public_key') }}",
    subscribe: "{{ path('pwa_subscribe') }}",
    unsubscribe: "{{ path('pwa_unsubscribe') }}",
    test: "{{ path('pwa_test') }}",
    preferences: "{{ path('pwa_preferences') }}"
};
const pwaState = { status: null, subscription: null };

function pwaSupported() {
    return 'serviceWorker' in navigator && 'PushManager' in window && typeof Notification !== 'undefined';
}

function pwaStandalone() {
    return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
}

function pwaMessage(text, type) {
    const el = document.getElementById('pwa-card-message');
    if (!el) return;
    el.style.display = 'block';
    el.innerText = text;
    if (type === 'error') {
        el.style.color = 'var(--danger)';
        el.style.background = 'rgba(239, 68, 68, 0.1)';
        el.style.border = '1px solid rgba(239, 68, 68, 0.35)';
    } else if (type === 'success') {
        el.style.color = 'var(--success)';
        el.style.background = 'rgba(34, 197, 94, 0.1)';
        el.style.border = '1px solid rgba(34, 197, 94, 0.35)';
    } else {
        el.style.color = 'var(--text-secondary)';
        el.style.background = 'rgba(255,255,255,0.04)';
        el.style.border = '1px solid rgba(255,255,255,0.1)';
    }
}

function pwaClearMessage() {
    const el = document.getElementById('pwa-card-message');
    if (el) el.style.display = 'none';
}

function pwaUrlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - (base64String.length % 4)) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = window.atob(base64);
    const output = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i++) {
        output[i] = raw.charCodeAt(i);
    }
    return output;
}

async function pwaFetchJson(url, options) {
    const response = await fetch(url, options);
    let data = null;
    try {
        data = await response.json();
    } catch (e) {
        data = null;
    }
    if (!response.ok || !data || data.success === false) {
        throw new Error((data && data.message) ? data.message : 'Request failed.');
    }
    return data;
}

async function pwaGetRegistration() {
    if (!window.isSecureContext) {
        throw new Error('PWA requires HTTPS.');
    }
    if (typeof window.pwaRegisterServiceWorker === 'function') {
        const registration = await window.pwaRegisterServiceWorker();
        if (registration) return registration;
    }
    if (!('serviceWorker' in navigator)) {
        throw new Error('Service workers are not supported in this browser.');
    }
    return navigator.serviceWorker.register('/service-worker.js', { scope: '/' });
}

function pwaUpdateButtons() {
    const subscribeBtn = document.getElementById('pwa-subscribe-btn');
    const unsubscribeBtn = document.getElementById('pwa-unsubscribe-btn');
    const testBtn = document.getElementById('pwa-test-btn');
    if (!subscribeBtn || !unsubscribeBtn || !testBtn) return;

    const supported = pwaSupported();
    const vapidConfigured = !!(pwaState.status && pwaState.status.vapidConfigured);
    const permission = typeof Notification !== 'undefined' ? Notification.permission : 'unsupported';
    const hasSubscription = !!pwaState.subscription || !!(pwaState.status && pwaState.status.subscribed);
    const count = pwaState.status ? Number(pwaState.status.enabledSubscriptionCount || 0) : 0;

    subscribeBtn.disabled = !supported || !vapidConfigured || permission === 'denied' || hasSubscription;
    unsubscribeBtn.disabled = !supported || !hasSubscription;
    testBtn.disabled = !supported || !vapidConfigured || count === 0;
}

function pwaRenderStatus() {
    const status = pwaState.status || {};
    const permission = typeof Notification !== 'undefined' ? Notification.permission : 'unsupported';
    const installState = document.getElementById('pwa-install-state');
    const installability = document.getElementById('pwa-installability');
    const permissionEl = document.getElementById('pwa-permission');
    const vapidEl = document.getElementById('pwa-vapid-state');
    const subCount = document.getElementById('pwa-sub-count');
    const vapidMissing = document.getElementById('pwa-vapid-missing');

    if (installState) installState.innerText = pwaStandalone() ? 'Standalone' : 'Browser';
    if (installability) installability.innerText = pwaStandalone() ? 'Installed' : 'Browser';
    if (permissionEl) permissionEl.innerText = permission === 'default' ? 'not requested' : permission;
    if (vapidEl) vapidEl.innerText = status.vapidConfigured ? 'Configured' : 'Missing';
    if (subCount) subCount.innerText = String(status.subscriptionCount || 0);
    if (vapidMissing) vapidMissing.hidden = !!status.vapidConfigured;

    document.querySelectorAll('[data-pwa-preference]').forEach(function (input) {
        const key = input.getAttribute('data-pwa-preference');
        if (status.preferences && Object.prototype.hasOwnProperty.call(status.preferences, key)) {
            input.checked = status.preferences[key] === true;
        }
    });

    pwaUpdateButtons();
}

async function pwaRefreshStatus() {
    try {
        pwaState.status = await pwaFetchJson(pwaRoutes.status, { headers: { 'Accept': 'application/json' } });
    } catch (e) {
        pwaState.status = null;
    }

    try {
        if (pwaSupported() && window.isSecureContext) {
            const registration = await navigator.serviceWorker.getRegistration('/');
            if (registration) {
                pwaState.subscription = await registration.pushManager.getSubscription();
            }
        }
    } catch (e) {
        pwaState.subscription = null;
    }

    pwaRenderStatus();
}

async function pwaSubscribe() {
    pwaClearMessage();
    if (!pwaSupported()) {
        pwaMessage('Push notifications are not supported in this browser.', 'error');
        return;
    }
    if (!pwaState.status || !pwaState.status.vapidConfigured) {
        pwaMessage('VAPID keys are missing. Run php bin/console app:pwa:vapid on the server.', 'error');
        return;
    }

    const button = document.getElementById('pwa-subscribe-btn');
    const previousLabel = button ? button.innerText : 'Subscribe';
    if (button) {
        button.disabled = true;
        button.innerText = 'Subscribing...';
    }

    try {
        const permission = Notification.permission === 'granted'
            ? 'granted'
            : await Notification.requestPermission();
        if (permission !== 'granted') {
            throw new Error('Notification permission was not granted.');
        }

        const vapid = await pwaFetchJson(pwaRoutes.vapid, { headers: { 'Accept': 'application/json' } });
        if (!vapid.configured || !vapid.publicKey) {
            throw new Error('VAPID public key is not configured.');
        }

        const registration = await pwaGetRegistration();
        await navigator.serviceWorker.ready;
        let subscription = await registration.pushManager.getSubscription();
        if (!subscription) {
            subscription = await registration.pushManager.subscribe({
                userVisibleOnly: true,
                applicationServerKey: pwaUrlBase64ToUint8Array(vapid.publicKey)
            });
        }

        await pwaFetchJson(pwaRoutes.subscribe, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription: subscription.toJSON() })
        });

        pwaState.subscription = subscription;
        pwaMessage('Push notifications enabled for this browser.', 'success');
        await pwaRefreshStatus();
    } catch (e) {
        pwaMessage(e.message || 'Unable to subscribe to push notifications.', 'error');
    } finally {
        if (button) {
            button.disabled = false;
            button.innerText = previousLabel;
        }
        pwaUpdateButtons();
    }
}

async function pwaUnsubscribe() {
    pwaClearMessage();
    const button = document.getElementById('pwa-unsubscribe-btn');
    const previousLabel = button ? button.innerText : 'Unsubscribe';
    if (button) {
        button.disabled = true;
        button.innerText = 'Removing...';
    }

    try {
        const registration = await navigator.serviceWorker.getRegistration('/');
        const subscription = registration ? await registration.pushManager.getSubscription() : null;
        if (!subscription) {
            pwaMessage('No active push subscription was found for this browser.', 'info');
            pwaState.subscription = null;
            await pwaRefreshStatus();
            return;
        }

        await pwaFetchJson(pwaRoutes.unsubscribe, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ endpoint: subscription.endpoint })
        });
        await subscription.unsubscribe();
        pwaState.subscription = null;
        pwaMessage('Push notifications disabled for this browser.', 'success');
        await pwaRefreshStatus();
    } catch (e) {
        pwaMessage(e.message || 'Unable to unsubscribe.', 'error');
    } finally {
        if (button) {
            button.disabled = false;
            button.innerText = previousLabel;
        }
        pwaUpdateButtons();
    }
}

async function pwaSendTest() {
    pwaClearMessage();
    const button = document.getElementById('pwa-test-btn');
    const previousLabel = button ? button.innerText : 'Send test notification';
    if (button) {
        button.disabled = true;
        button.innerText = 'Sending...';
    }

    try {
        const result = await pwaFetchJson(pwaRoutes.test, { method: 'POST' });
        pwaMessage(result.message || 'Test notification sent.', 'success');
    } catch (e) {
        pwaMessage(e.message || 'Unable to send a test notification.', 'error');
    } finally {
        if (button) {
            button.disabled = false;
            button.innerText = previousLabel;
        }
        pwaUpdateButtons();
    }
}

async function pwaSavePreferences() {
    const preferences = {};
    document.querySelectorAll('[data-pwa-preference]').forEach(function (input) {
        preferences[input.getAttribute('data-pwa-preference')] = input.checked;
    });

    try {
        const result = await pwaFetchJson(pwaRoutes.preferences, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ preferences: preferences })
        });
        if (pwaState.status) {
            pwaState.status.preferences = result.preferences;
        }
        pwaMessage('Notification preferences saved.', 'success');
    } catch (e) {
        pwaMessage(e.message || 'Unable to save notification preferences.', 'error');
    }
}

document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-pwa-preference]').forEach(function (input) {
        input.addEventListener('change', pwaSavePreferences);
    });

    const subscribeBtn = document.getElementById('pwa-subscribe-btn');
    const unsubscribeBtn = document.getElementById('pwa-unsubscribe-btn');
    const testBtn = document.getElementById('pwa-test-btn');
    if (subscribeBtn) subscribeBtn.addEventListener('click', pwaSubscribe);
    if (unsubscribeBtn) unsubscribeBtn.addEventListener('click', pwaUnsubscribe);
    if (testBtn) testBtn.addEventListener('click', pwaSendTest);

    if (!pwaSupported()) {
        pwaMessage('Push notifications are not supported in this browser.', 'info');
    }

    pwaRefreshStatus();
});
</script>
{% endblock %}
