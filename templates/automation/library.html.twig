    async function searchMatch(query) {
        const state = document.getElementById('match-state');
        const results = document.getElementById('match-results');
        if (state) {
            state.style.display = 'block';
            state.textContent = 'Searching TMDB…';
        }
        if (results) results.innerHTML = '';
        try {
            const data = await matchRequest(libraryMatchSearchRoute, {
                group: matchGroup,
                query: query || ''
            });
            renderMatchCandidates(data.candidates || []);
        } catch (error) {
            if (state) state.textContent = error.message;
            if (window.notify) window.notify('error', error.message);
        }
    }

    function renderMatchCandidates(candidates) {
        const state = document.getElementById('match-state');
        const results = document.getElementById('match-results');
        if (!results) return;
        results.innerHTML = '';
        if (!candidates.length) {
            if (state) {
                state.style.display = 'block';
                state.textContent = 'No TMDB candidate found. Try another search.';
            }
            return;
        }
        if (state) state.style.display = 'none';
        candidates.forEach((candidate, index) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'match-candidate';
            const poster = candidate.poster
                ? '<img class="match-candidate-poster" src="' + escapeLibraryHtml(candidate.poster) + '" alt="">'
                : '<span class="match-candidate-poster"></span>';
            const meta = [candidate.original_title, candidate.year ? '(' + candidate.year + ')' : null, candidate.rating ? candidate.rating + '/10' : null]
                .filter(Boolean)
                .map(escapeLibraryHtml)
                .join(' · ');
            button.innerHTML = poster +
                '<span class="match-candidate-main">' +
                    '<span class="match-candidate-title">' + escapeLibraryHtml(candidate.title) + '</span>' +
                    '<span class="match-candidate-meta">' + meta + '</span>' +
                '</span>';
            button.addEventListener('click', () => {
                results.querySelectorAll('.match-candidate').forEach(item => item.classList.remove('is-selected'));
                button.classList.add('is-selected');
                matchSelected = candidate;
                const apply = document.getElementById('match-apply');
                if (apply) apply.disabled = false;
            });
            results.appendChild(button);
        });
    }

    async function applyMatch() {
        if (!matchGroup || !matchSelected) return;
        const apply = document.getElementById('match-apply');
        if (apply) apply.disabled = true;
        try {
            await matchRequest(attentionResolveRoute, {
                group: matchGroup,
                tmdb_id: matchSelected.id,
                type: matchSelected.type
            });
