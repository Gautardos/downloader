                    Browse the NAS by folder. Select a folder to see its subfolders and files.
                </p>
            </div>
            <span class="badge badge-info">{{ counts.matched }} matched</span>
        </div>

        {% if folder_tree is empty %}
            <div class="library-empty">No folder matches these filters.</div>
        {% else %}
            <div class="folder-browser-layout">
                <aside class="folder-tree-panel">
                    <div class="folder-tree-head">Folders</div>
                    {% import 'automation/_folder_tree.html.twig' as folderTree %}
                    {{ folderTree.tree(folder_tree, selected_root_key, selected_folder_path) }}
                </aside>
                <div class="folder-content-panel">
                    <div id="folder-breadcrumb" class="folder-breadcrumb"></div>
                    <div id="folder-content"
                         data-root-key="{{ selected_root_key }}"
                         data-folder-path="{{ selected_folder_path }}">
                        <div class="folder-loading">Loading folder…</div>
                    </div>
                </div>
            </div>
        {% endif %}
    </section>
{% elseif view == 'discovery' %}
    <section class="card" style="margin-bottom:1rem;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem;">
            <div>
                <h2 class="activity-card-title" style="margin:0;font-size:1rem;">Discovery</h2>
                <p style="margin:.35rem 0 0;color:var(--text-secondary);font-size:.8rem;">
                    {{ element_total }} element{{ element_total == 1 ? '' : 's' }} · page {{ element_page }} / {{ element_pages }}
                </p>
            </div>
            <span class="badge badge-info">{{ counts.matched }} matched</span>
        </div>

        <div class="library-tabs" style="margin-bottom:1rem;">
            {% for key, label in {all: 'All types', movie: 'Movies', series: 'Series', anime: 'Anime'} %}
                <a class="library-tab {{ filters.type == key ? 'active' : '' }}"
                   href="{{ path('automation_library', {status: filters.status, type: key, q: filters.q, view: 'discovery'}) }}">{{ label }}</a>
            {% endfor %}
        </div>

        {% if discovery_elements is empty %}
            <div class="library-empty">No element matches these filters.</div>
        {% else %}
            <div class="discovery-grid">
                {% for element in discovery_elements %}
                    <article class="discovery-card" data-discovery-card
                                 data-discovery-open
                                 data-discovery-group="{{ element.match_group|json_encode|e('html_attr') }}"
                                 data-discovery-tmdb-id="{{ element.tmdb_id ?: '' }}"
                                 data-discovery-title="{{ element.title|e('html_attr') }}"
                                 data-discovery-type="{{ element.match_type }}">
                                <div class="discovery-poster-wrap">
                                    {% if element.poster|default(null) %}
                                        <img class="discovery-poster" src="{{ element.poster }}" alt="" loading="lazy">
                                    {% else %}
                                        <div class="discovery-poster discovery-poster--empty">{{ element.title|slice(0, 1)|upper }}</div>
                                    {% endif %}
                                    <span class="discovery-type-badge">{{ element.media_type|capitalize }}</span>
                                    {% if element.rating|default(null) %}<span class="discovery-rating">{{ element.rating }}</span>{% endif %}
                                    {% if element.missing %}<span class="discovery-flag discovery-flag--danger">{{ element.missing }} missing</span>{% endif %}
                                    <div class="discovery-poster-overlay"></div>
                                </div>
                                <div class="discovery-card-body">
                                    <h3 class="discovery-card-title">{{ element.title }}{% if element.year %} <span>({{ element.year }})</span>{% endif %}</h3>
                                    <div class="discovery-card-sub">
                                        {% if element.media_type != 'movie' and element.show_folder %}
                                            {{ element.show_folder }}
                                        {% elseif element.tmdb_id %}
                                            TMDB {{ element.tmdb_id }}
                                        {% elseif element.folder_path %}
                                            {{ element.folder_path }}
                                        {% else %}
                                            &nbsp;
                                        {% endif %}
                                    </div>
                                    <div class="discovery-card-stats">
                                        <span>{{ element.files }} file{{ element.files == 1 ? '' : 's' }}</span>
                                        {% if element.seasons %}<span class="discover-dot"></span><span>{{ element.seasons }} season{{ element.seasons == 1 ? '' : 's' }}</span>{% endif %}
                                    </div>
                                    <div class="discovery-card-chips">
                                        {% if element.naming.conform %}<span class="badge badge-success">{{ element.naming.conform }} conform</span>{% endif %}
                                        {% if element.naming.rename %}<span class="badge badge-info">{{ element.naming.rename }} to rename</span>{% endif %}
                                        {% if element.naming.conflict %}<span class="badge badge-danger">{{ element.naming.conflict }} conflicts</span>{% endif %}
                                    </div>
                                    <div class="discovery-card-actions">
                                        <span class="discovery-view-link">View details</span>
                                        <button class="btn btn-secondary btn-sm" type="button"
                                                data-match-action="open"
                                                data-match-group="{{ element.match_group|json_encode|e('html_attr') }}"
                                                data-match-type="{{ element.match_type }}"
                                                data-match-id="{{ element.tmdb_id ?: '' }}"
                                                data-match-title="{{ element.title|e('html_attr') }}">{{ element.tmdb_id ? 'Fix' : 'Match' }}</button>
                                    </div>
                                </div>
                            </article>
                {% endfor %}
            </div>

            {% if element_pages > 1 %}
                <div class="library-pagination">
                    <span>Showing {{ element_offset + 1 }}–{{ element_offset + discovery_elements|length }} of {{ element_total }}</span>
                    <div style="display:flex;gap:.4rem;">
                        {% if element_page > 1 %}
                            <a href="{{ path('automation_library', {status: filters.status, type: filters.type, q: filters.q, view: 'discovery', page: element_page - 1}) }}">Previous</a>
                        {% endif %}
                        {% if element_page < element_pages %}
                            <a href="{{ path('automation_library', {status: filters.status, type: filters.type, q: filters.q, view: 'discovery', page: element_page + 1}) }}">Next</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </section>

    <dialog class="library-dialog" id="discovery-dialog">
        <div class="library-dialog-header">
            <div>
                <h2 class="library-dialog-title" id="discovery-dialog-title">Element</h2>
                <p class="library-dialog-subtitle" id="discovery-dialog-subtitle"></p>
            </div>
            <button class="btn btn-ghost btn-sm" type="button" id="discovery-dialog-close">Close</button>
        </div>
        <div class="library-dialog-body">
            <div id="discovery-details" class="discovery-details"></div>
            <div id="discovery-files" class="discovery-files"></div>
        </div>
        <div class="library-dialog-actions">
            <button class="btn btn-secondary" type="button" id="discovery-dialog-cancel">Close</button>
        </div>
    </dialog>
{% else %}
    <section class="card" style="margin-bottom:1rem;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem;">
            <div>
                <h2 class="activity-card-title" style="margin:0;font-size:1rem;">Indexed entries</h2>
                <p style="margin:.35rem 0 0;color:var(--text-secondary);font-size:.8rem;">
                    {{ total }} entr{{ total == 1 ? 'y' : 'ies' }} · page {{ page }} / {{ pages }}
                </p>
            </div>
            <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;">
                <span class="badge badge-info">{{ counts.matched }} matched</span>
                {% if filters.status == 'missing' and counts.missing > 0 %}
                    <button class="btn btn-danger btn-sm" type="button" onclick="purgeMissingEntries()">Purge missing</button>
                {% endif %}
            </div>
        </div>

        {% if entries is empty %}
            <div class="library-empty">No entry matches these filters.</div>
        {% else %}
            {{ libraryTable.table(entries, naming_map) }}

            {% if pages > 1 %}
                <div class="library-pagination">
                    <span>Showing {{ offset + 1 }}–{{ offset + entries|length }} of {{ total }}</span>
                    <div style="display:flex;gap:.4rem;">
                        {% if page > 1 %}
                            <a href="{{ path('automation_library', {status: filters.status, type: filters.type, q: filters.q, view: 'flat', page: page - 1}) }}">Previous</a>
                        {% endif %}
                        {% if page < pages %}
                            <a href="{{ path('automation_library', {status: filters.status, type: filters.type, q: filters.q, view: 'flat', page: page + 1}) }}">Next</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </section>
{% endif %}

{% include 'automation/_attention.html.twig' %}

