    async function pollTitleRefreshStatus() {
        try {
            const response = await fetch(titleRefreshStatusRoute);
            const data = await response.json();
            const state = data.title_refresh || {};
            const status = String(state.status || '');
            if (status === 'requested' || status === 'running') {
                titleRefreshWasActive = true;
                const total = Number(state.total || 0);
                const processed = Number(state.processed || 0);
                const startedAt = Date.parse(String(state.started_at || '').replace(' ', 'T'));
                const waited = startedAt ? Math.round((Date.now() - startedAt) / 1000) : 0;
                if (status === 'requested' && waited >= 120) {
                    setTitleRefreshState('English title refresh not started', 'Requested ' + waited + 's ago. Check automation_title_refresh.log or retry.', 'stale');
                    document.querySelectorAll('button[onclick*="startTitleRefresh"]').forEach(button => { button.disabled = false; });
                    setTimeout(pollTitleRefreshStatus, 5000);
                    return;
                }
                setTitleRefreshState(
                    status === 'running' ? 'English title refresh in progress' : 'English title refresh requested',
                    total > 0
                        ? processed + ' / ' + total + ' TMDB movies · ' + Number(state.updated || 0) + ' entries updated'
                        : 'Refreshing movie titles to ' + String(state.language || 'en-US') + '. Use Rename matched afterwards to preview file moves.',
                    status === 'requested' ? 'waiting' : ''
                );
                setTimeout(pollTitleRefreshStatus, 1500);
                return;
            }
            if (titleRefreshWasActive) {
                window.location.reload();
            }
        } catch (error) {
            setTimeout(pollTitleRefreshStatus, 5000);
        }
    }

    async function openRenamePreview() {
        const dialog = document.getElementById('rename-dialog');
        const loading = document.getElementById('rename-loading');
        const summary = document.getElementById('rename-summary');
        const list = document.getElementById('rename-list');
        const apply = document.getElementById('rename-apply');

        if (loading) { loading.style.display = 'block'; loading.textContent = 'Building rename plan…'; }
        if (summary) { summary.style.display = 'none'; summary.innerHTML = ''; }
        if (list) list.innerHTML = '';
        if (apply) apply.disabled = true;
        if (dialog && typeof dialog.showModal === 'function') dialog.showModal();

        try {
            const response = await fetch(libraryPreviewRoute, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ csrf: libraryCsrfToken, filters: libraryFilters, limit: 500 })
            });
            const data = await response.json();
            if (!response.ok || data.success === false) {
                throw new Error(data.message || 'Could not build rename plan.');
            }
            libraryPreviewCounts = data.counts || {ok: 0, conform: 0, skip: 0, conflict: 0};
            if (loading) loading.style.display = 'none';
            if (summary) {
                summary.style.display = 'flex';
                summary.innerHTML =
                    '<span class="badge badge-success">' + libraryPreviewCounts.ok + ' ready</span>' +
                    '<span class="badge badge-success">' + (libraryPreviewCounts.conform || 0) + ' conform</span>' +
                    '<span class="badge badge-warning">' + libraryPreviewCounts.skip + ' skipped</span>' +
                    '<span class="badge badge-danger">' + libraryPreviewCounts.conflict + ' conflicts</span>' +
                    '<span class="badge badge-neutral">' + (data.entries_seen || 0) + ' seen</span>';
            }
            if (apply) {
                apply.disabled = !libraryPreviewCounts.ok;
                apply.textContent = 'Apply ' + libraryPreviewCounts.ok + ' rename' + (libraryPreviewCounts.ok === 1 ? '' : 's');
            }
            if (list) {
                if (!data.items || data.items.length === 0) {
                    list.innerHTML = '<div class="library-empty">No matched entry to rename.</div>';
                } else {
                    list.innerHTML = data.items.map(item => {
                        const cls = item.status === 'ok' ? 'is-ok' : (item.status === 'conflict' ? 'is-conflict' : (item.status === 'conform' ? 'is-ok' : 'is-skip'));
                        const label = item.status === 'ok' ? 'Ready' : (item.status === 'conflict' ? 'Conflict' : (item.status === 'conform' ? 'Conform' : 'Skip'));
                        const badge = item.status === 'ok' ? 'badge-success' : (item.status === 'conflict' ? 'badge-danger' : (item.status === 'conform' ? 'badge-success' : 'badge-warning'));
                        const target = item.new_path ? '<div class="rename-path"><span class="rename-arrow">→</span> ' + escapeLibraryHtml(item.new_path) + '</div>' : '';
                        const reason = item.reason ? '<div class="rename-reason">' + escapeLibraryHtml(item.reason) + '</div>' : '';
                        const sidecars = item.sidecars ? '<div class="rename-reason">' + item.sidecars + ' sidecar file(s)</div>' : '';
                        return '<div class="rename-item ' + cls + '">' +
                            '<div><span class="badge ' + badge + '">' + label + '</span></div>' +
                            '<div class="rename-paths">' +
                                '<div class="rename-path">' + escapeLibraryHtml(item.old_path) + '</div>' +
                                target + reason + sidecars +
                            '</div>' +
                        '</div>';
                    }).join('');
                }
            }
        } catch (error) {
            if (loading) loading.textContent = error.message;
            if (window.notify) window.notify('error', error.message);
        }
    }

    async function applyRenames() {
        if (!libraryPreviewCounts.ok) return;
        if (!window.confirm('Rename ' + libraryPreviewCounts.ok + ' matched file(s)?')) return;
        const apply = document.getElementById('rename-apply');
