        const year = details && details.year ? details.year : (group.year || '');
        const imdbId = details && details.imdb_id ? details.imdb_id : '';
        const tmdbId = details && details.id ? details.id : (group.tmdb_id || button.getAttribute('data-discovery-tmdb-id') || '');
        const overview = details && details.overview ? details.overview : 'No TMDB metadata available for this element.';
