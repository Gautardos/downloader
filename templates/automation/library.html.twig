{% block javascripts %}
<script>
    const libraryPreviewRoute = "{{ path('automation_library_rename_preview') }}";
    const libraryApplyRoute = "{{ path('automation_library_rename_apply') }}";
    const libraryMatchSearchRoute = "{{ path('automation_library_match_search') }}";
    const libraryMatchDetailsRoute = "{{ path('automation_library_match_details') }}";
    const libraryFolderEntriesRoute = "{{ path('automation_library_folder_entries') }}";
    const libraryFolderContentsRoute = "{{ path('automation_library_folder_contents') }}";
    const libraryElementRoute = "{{ path('automation_library_element') }}";
    const libraryRemoveRoute = "{{ path('automation_library_remove') }}";
    const libraryPurgeMissingRoute = "{{ path('automation_library_purge_missing') }}";
    const automationScanRoute = "{{ path('automation_scan') }}";
    const automationResolveRoute = "{{ path('automation_resolve') }}";
    const automationStatusRoute = "{{ path('automation_status') }}";
    const titleRefreshRoute = "{{ path('automation_library_title_refresh') }}";
    const titleRefreshStatusRoute = "{{ path('automation_library_title_refresh_status') }}";
    const libraryCsrfToken = "{{ csrf_token|e('js') }}";
    const initialTitleRefreshActive = {{ title_refresh.status in ['requested', 'running'] ? 'true' : 'false' }};
    let titleRefreshWasActive = initialTitleRefreshActive;
    let metadataResolutionRequested = false;
    const initialResolutionRequested = {{ resolve_requested ? 'true' : 'false' }};
    const initialScanRunning = {{ scan_running ? 'true' : 'false' }};
    const initialScanRequested = {{ scan_requested ? 'true' : 'false' }};
    const initialScanRequestedAt = {{ scan_requested_at|default(0) }} * 1000;
    const initialScanId = {{ last_scan.id|default(0) }};
    let libraryScanRequestedAt = initialScanRequestedAt > 0 ? initialScanRequestedAt : (initialScanRequested ? Date.now() : 0);
    let observedScanRunning = initialScanRunning;
    const libraryFilters = {{ filters|json_encode|raw }};
    let libraryPreviewCounts = {ok: 0, conform: 0, skip: 0, conflict: 0};
    let matchGroup = null;
    let matchType = 'series';
    let matchSelected = null;

    function escapeLibraryHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, char => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
        }[char]));
    }

    function setLibraryScanState(title, meta, state = '') {
        const panel = document.getElementById('library-scan-state');
        if (!panel) return;
        panel.hidden = false;
        panel.classList.remove('is-waiting', 'is-stale');
        if (state) panel.classList.add('is-' + state);
        const titleElement = document.getElementById('library-scan-title');
        const metaElement = document.getElementById('library-scan-meta');
        if (titleElement) titleElement.textContent = title;
