    function formatLibraryScanWait(seconds) {
        if (seconds < 60) return seconds + 's';
        const minutes = Math.floor(seconds / 60);
        const remainder = seconds % 60;
        return minutes + 'm' + (remainder ? ' ' + remainder + 's' : '');
    }

    async function pollLibraryScanStatus() {
        try {
            const response = await fetch(automationStatusRoute);
            const data = await response.json();
            if (data.scan_lock_error) {
                setLibraryScanState('Scanner lock error', data.scan_lock_error, 'stale');
                return;
            }
            if (data.scan_running) {
                observedScanRunning = true;
                const run = data.running_scan || {};
                setLibraryScanState(
                    'Library scan in progress',
                    (Number(run.files_seen || 0)) + ' seen · ' + Number(run.files_indexed || 0) + ' new · ' + Number(run.files_updated || 0) + ' updated · ' + Number(run.files_missing || 0) + ' missing'
                );
                setTimeout(pollLibraryScanStatus, 1500);
                return;
            }

            const lastScanId = data.last_scan ? Number(data.last_scan.id || 0) : 0;
            if (observedScanRunning || lastScanId > initialScanId) {
                window.location.reload();
                return;
            }

            const scanRequestedAtMs = Number(data.scan_requested_at || 0) * 1000;
            const lastScanAtMs = data.last_scan ? Date.parse(String(data.last_scan.finished_at || data.last_scan.started_at || '').replace(' ', 'T')) : 0;
            const scanActive = !!data.scan_requested && (!scanRequestedAtMs || lastScanAtMs < scanRequestedAtMs);
            const requestedRecently = libraryScanRequestedAt > 0 && (Date.now() - libraryScanRequestedAt) < 5000;

            if (!scanActive && !requestedRecently) {
                const panel = document.getElementById('library-scan-state');
                if (panel) panel.hidden = true;
                return;
            }

            if (scanActive || requestedRecently) {
                const startedAt = libraryScanRequestedAt || scanRequestedAtMs || Date.now();
                const waited = Math.max(0, Math.round((Date.now() - startedAt) / 1000));
                if (data.worker_online === false) {
                    setLibraryScanState('Scan queued — worker offline', 'The automation worker is not sending heartbeats. Start it, then the scan will run.', 'stale');
                    setTimeout(pollLibraryScanStatus, 5000);
                    return;
                }
                if (waited >= 15) {
                    setLibraryScanState(
                        'Scan not started',
                        'Requested ' + formatLibraryScanWait(waited) + ' ago. The automation worker may be offline — check Activity, then retry.',
                        'stale'
                    );
                    return;
                }
                setLibraryScanState('Library scan queued', 'Waiting for the automation worker…' + (waited > 0 ? ' (' + formatLibraryScanWait(waited) + ')' : ''), 'waiting');
                setTimeout(pollLibraryScanStatus, 1500);
            }
        } catch (error) {
            setTimeout(pollLibraryScanStatus, 5000);
        }
    }

    async function startLibraryScan() {
        try {
            const response = await fetch(automationScanRoute, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ csrf: libraryCsrfToken })
            });
            const data = await response.json();
            if (!response.ok || data.success === false) {
                throw new Error(data.message || 'Could not start the scan.');
            }
            if (window.notify) window.notify('success', data.message || 'Library scan requested.');
            libraryScanRequestedAt = Date.now();
            setTimeout(pollLibraryScanStatus, 1200);
        } catch (error) {
            if (window.notify) window.notify('error', error.message);
        }
    }

    async function startMetadataResolution() {
