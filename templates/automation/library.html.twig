    function pad2(value) {
        return String(value).padStart(2, '0');
    }

    function renderFolderEntries(body, entries) {
        if (!entries.length) {
            body.innerHTML = '<div class="library-empty">No files in this folder.</div>';
            return;
        }

        const rows = entries.map(entry => {
            const matchGroupJson = escapeLibraryHtml(JSON.stringify(entry.match_group || {}));
            const hasMatch = entry.tmdb_id || entry.imdb_id;
            const matchLabel = hasMatch ? 'Fix' : 'Match';
            const matchBadge = entry.tmdb_id ? 'TMDB ' + entry.tmdb_id : (entry.imdb_id ? 'IMDb ' + entry.imdb_id : 'Unmatched');
            const matchBadgeClass = hasMatch ? 'badge-success' : 'badge-warning';
            const naming = entry.naming || { label: 'Skipped', badge: 'badge-neutral', reason: '' };
            const confidence = Math.round((entry.confidence || 0) * 100);
            let identity = escapeLibraryHtml(entry.title || '') + (entry.year ? ' (' + entry.year + ')' : '');
            if (entry.season !== null && entry.episode !== null) {
                identity += ' · S' + pad2(entry.season) + 'E' + pad2(entry.episode);
            }
            let statusHtml = '<span class="badge badge-success">Active</span>';
            if (entry.status === 'missing') {
                statusHtml = '<span class="badge badge-danger">Missing</span> <button class="btn btn-ghost btn-sm" type="button" data-remove-entry="' + entry.id + '">Remove</button>';
            } else if (entry.ignored) {
                statusHtml = '<span class="badge badge-neutral">Ignored</span>';
            }

            return '<tr>' +
                '<td><div class="library-row-title">' + escapeLibraryHtml(entry.filename) + '</div><div class="library-row-sub">' + escapeLibraryHtml(entry.relative_path) + '</div></td>' +
                '<td>' + escapeLibraryHtml(entry.media_type) + '</td>' +
                '<td><div class="library-identity">' + identity + '</div></td>' +
                '<td><div style="display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;">' +
                    '<span class="badge ' + matchBadgeClass + '">' + escapeLibraryHtml(matchBadge) + '</span>' +
                    '<button class="btn btn-ghost btn-sm" type="button" data-match-action="open" data-match-group="' + matchGroupJson + '" data-match-type="' + escapeLibraryHtml(entry.match_type || 'series') + '" data-match-id="' + (entry.match_id || '') + '" data-match-title="' + escapeLibraryHtml(entry.match_title || '') + '">' + matchLabel + '</button>' +
                '</div></td>' +
                '<td><span class="badge ' + escapeLibraryHtml(naming.badge) + '" title="' + escapeLibraryHtml(naming.reason || '') + '">' + escapeLibraryHtml(naming.label) + '</span></td>' +
                '<td><span class="badge ' + (confidence >= 80 ? 'badge-success' : 'badge-warning') + '">' + confidence + '%</span></td>' +
                '<td><div style="display:flex;align-items:center;gap:.35rem;flex-wrap:wrap;">' + statusHtml + '</div></td>' +
            '</tr>';
        }).join('');

        body.innerHTML = '<div class="library-table-wrap"><table class="library-table"><thead><tr>' +
            '<th>File</th><th>Type</th><th>Identity</th><th>Match</th><th>Naming</th><th>Confidence</th><th>Status</th>' +
            '</tr></thead><tbody>' + rows + '</tbody></table></div>';
    }

