    async function pollResolutionStatus() {
        try {
            const response = await fetch(automationStatusRoute);
            const data = await response.json();
            const resolveRequestedAtMs = Number(data.resolve_requested_at || 0) * 1000;
            const lastResolution = data.last_resolution || null;
            const lastResolutionAtMs = lastResolution && lastResolution.finished_at
                ? Date.parse(String(lastResolution.finished_at).replace(' ', 'T'))
                : 0;
            const resolveActive = !!data.resolve_requested && (!resolveRequestedAtMs || lastResolutionAtMs < resolveRequestedAtMs);

            if (!resolveActive) {
                if (metadataResolutionRequested || initialResolutionRequested) {
                    window.location.reload();
                } else {
                    const panel = document.getElementById('library-resolution-state');
                    if (panel) panel.hidden = true;
                }
                return;
            }

            if (data.worker_online === false) {
                setLibraryResolutionState('Metadata resolution queued — worker offline', 'The automation worker is not sending heartbeats. Start it, then resolution will run.', 'stale');
            } else {
                setLibraryResolutionState('Metadata resolution in progress', 'Waiting for the automation worker to finish the TMDB lookups…');
            }
            setTimeout(pollResolutionStatus, 1500);
        } catch (error) {
            setTimeout(pollResolutionStatus, 5000);
        }
    }

