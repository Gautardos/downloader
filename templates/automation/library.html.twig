            if (!response.ok || data.success === false) {
                throw new Error(data.message || 'Could not start metadata resolution.');
            }
            if (window.notify) window.notify('success', data.message || 'Metadata resolution requested.');
            metadataResolutionRequested = true;
            setLibraryResolutionState('Metadata resolution queued', 'Waiting for the automation worker…', 'waiting');
            setTimeout(pollResolutionStatus, 1200);
        } catch (error) {
            if (window.notify) window.notify('error', error.message);
            buttons.forEach(button => { button.disabled = false; });
