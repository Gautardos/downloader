{% extends 'base.html.twig' %}

{% block title %}Library Browser - Downloader{% endblock %}

{% block body %}
<style>
    .library-filter-card {
        margin-bottom: 1rem;
        padding: 1rem;
    }
    .library-filter-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .library-filter-row + .library-filter-row {
        margin-top: .8rem;
        padding-top: .8rem;
        border-top: 1px solid rgba(148, 163, 184, .1);
    }
    .library-filter-group,
    .library-naming {
        display: flex;
        align-items: center;
        gap: .55rem;
        flex-wrap: wrap;
    }
    .library-filter-label {
        color: var(--text-secondary);
        font-size: .66rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .library-filter-card .naming-summary { margin-bottom: 0; }
    .library-filter-row .library-search { flex: 1 1 100%; }
    .library-search .library-filter-label { margin-right: .1rem; }
    .library-search input,
    .library-search select,
    .library-search .btn {
        height: 42px;
        margin: 0;
        box-sizing: border-box;
    }
    .library-search input[type="text"] {
        flex: 1;
        width: auto;
        min-width: 220px;
    }
    .library-search select { padding-right: 2rem; }
    .library-search .btn { flex: 0 0 auto; }
    .library-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .library-tabs {
        display: flex;
        gap: .3rem;
        flex-wrap: wrap;
        padding: .3rem;
        border: 1px solid rgba(148, 163, 184, .16);
        border-radius: 11px;
        background: rgba(15, 23, 42, .42);
    }
    .library-tab {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .48rem .7rem;
        border-radius: 8px;
        color: var(--text-secondary);
        font-size: .76rem;
        font-weight: 700;
        text-decoration: none;
    }
    .library-tab:hover { color: var(--text-primary); background: rgba(255, 255, 255, .05); }
    .library-tab.active { color: var(--text-primary); background: rgba(56, 189, 248, .12); }
    .library-tab .count { color: var(--text-muted, #64748b); font-size: .68rem; }
    .library-tab.active .count { color: var(--accent); }
    .library-search {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }
    .library-search input,
    .library-search select {
        padding: .62rem .7rem;
        border: 1px solid rgba(148, 163, 184, .28);
        border-radius: 9px;
        background: rgba(15, 23, 42, .72);
        color: var(--text-primary);
        font: inherit;
        font-size: .8rem;
    }
    .library-table-wrap {
        overflow-x: auto;
        border: 1px solid rgba(148, 163, 184, .16);
        border-radius: 12px;
    }
    .library-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .79rem;
    }
    .library-table th {
        padding: .7rem .8rem;
        color: var(--text-secondary);
        font-size: .65rem;
        font-weight: 800;
        letter-spacing: .07em;
        text-align: left;
        text-transform: uppercase;
        background: rgba(15, 23, 42, .42);
        border-bottom: 1px solid rgba(148, 163, 184, .16);
        white-space: nowrap;
    }
    .library-table td {
        padding: .7rem .8rem;
        border-bottom: 1px solid rgba(148, 163, 184, .08);
        vertical-align: top;
    }
    .library-table tr:last-child td { border-bottom: 0; }
    .library-row-title { font-weight: 700; }
    .library-row-sub {
        margin-top: .2rem;
        color: var(--text-secondary);
        font-size: .7rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        word-break: break-all;
    }
    .library-identity {
        font-weight: 700;
        white-space: nowrap;
    }
    .library-identity-sub {
        margin-top: .2rem;
        color: var(--text-secondary);
        font-size: .7rem;
    }
    .library-empty {
        padding: 1.4rem;
        border: 1px dashed rgba(148, 163, 184, .28);
        border-radius: 12px;
        color: var(--text-secondary);
        font-size: .8rem;
        text-align: center;
    }
    .library-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: .9rem;
        color: var(--text-secondary);
        font-size: .78rem;
        flex-wrap: wrap;
    }
    .library-pagination a {
        color: var(--text-primary);
        text-decoration: none;
        padding: .35rem .55rem;
        border: 1px solid rgba(148, 163, 184, .2);
        border-radius: 7px;
    }
    .library-pagination a:hover { border-color: var(--accent); }
    .library-dialog {
        width: min(1000px, calc(100% - 2rem));
        padding: 0;
        border: 1px solid rgba(148, 163, 184, .28);
        border-radius: 16px;
        color: var(--text-primary);
        background: var(--bg-secondary);
        box-shadow: 0 30px 80px rgba(2, 6, 23, .6);
    }
    .library-dialog::backdrop { background: rgba(2, 6, 23, .72); backdrop-filter: blur(4px); }
    .library-dialog-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.2rem;
        border-bottom: 1px solid rgba(148, 163, 184, .16);
    }
    .library-dialog-title { margin: 0; font-size: 1rem; }
    .library-dialog-subtitle { margin: .3rem 0 0; color: var(--text-secondary); font-size: .78rem; }
    .library-dialog-body { max-height: 65vh; overflow: auto; padding: 1rem 1.2rem; }
    .library-dialog-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .5rem;
        padding: .85rem 1.2rem;
        border-top: 1px solid rgba(148, 163, 184, .16);
        flex-wrap: wrap;
    }
    .rename-summary {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        margin-bottom: .85rem;
    }
    .rename-list { display: grid; gap: .45rem; }
    .rename-item {
        display: grid;
        grid-template-columns: 110px minmax(0, 1fr);
        gap: .7rem;
        padding: .6rem .7rem;
        border: 1px solid rgba(148, 163, 184, .14);
        border-radius: 9px;
        background: rgba(15, 23, 42, .35);
        font-size: .76rem;
    }
    .rename-item.is-conflict { border-color: rgba(239, 68, 68, .36); }
    .rename-item.is-skip { border-color: rgba(245, 158, 11, .28); }
    .rename-item.is-ok { border-color: rgba(34, 197, 94, .28); }
    .rename-paths { min-width: 0; }
    .rename-path {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: .7rem;
        word-break: break-all;
    }
    .rename-arrow { color: var(--text-secondary); }
    .rename-reason { margin-top: .2rem; color: var(--text-secondary); font-size: .7rem; }
    .naming-summary {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
        margin-bottom: .85rem;
    }
    .match-current {
        display: flex;
        gap: .85rem;
        padding: .8rem;
        margin-bottom: .9rem;
        border: 1px solid rgba(56, 189, 248, .28);
        border-radius: 11px;
        background: rgba(56, 189, 248, .07);
    }
    .match-current-poster {
        width: 54px;
        height: 78px;
        flex: 0 0 auto;
        border-radius: 8px;
        object-fit: cover;
        background: rgba(148, 163, 184, .15);
    }
    .match-current-main { min-width: 0; }
    .match-current-title { font-weight: 800; font-size: .88rem; }
    .match-current-meta { margin-top: .2rem; color: var(--text-secondary); font-size: .73rem; }
    .match-current-overview {
        margin-top: .4rem;
        color: var(--text-secondary);
        font-size: .74rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .match-candidate {
        display: flex;
        align-items: center;
        gap: .7rem;
        width: 100%;
        padding: .6rem .7rem;
        border: 1px solid rgba(148, 163, 184, .16);
        border-radius: 9px;
        background: rgba(15, 23, 42, .4);
        color: var(--text-primary);
        text-align: left;
        cursor: pointer;
        font: inherit;
    }
    .match-candidate + .match-candidate { margin-top: .45rem; }
    .match-candidate:hover { border-color: rgba(56, 189, 248, .45); }
    .match-candidate.is-selected { border-color: var(--accent); background: rgba(56, 189, 248, .12); }
    .match-candidate-poster {
        width: 36px;
        height: 52px;
        flex: 0 0 auto;
        border-radius: 6px;
        object-fit: cover;
        background: rgba(148, 163, 184, .15);
    }
    .match-candidate-main { min-width: 0; }
    .match-candidate-title { display: block; font-weight: 750; font-size: .82rem; }
    .match-candidate-meta {
        display: block;
        margin-top: .2rem;
        color: var(--text-secondary);
        font-size: .71rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .folder-groups { display: grid; gap: .6rem; }
    .folder-group {
        border: 1px solid rgba(148, 163, 184, .16);
        border-radius: 12px;
        background: rgba(15, 23, 42, .32);
        overflow: hidden;
    }
    .folder-group-header {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .7rem .85rem;
    }
    .folder-toggle {
        width: 32px;
        height: 32px;
        flex: 0 0 auto;
        border: 1px solid rgba(148, 163, 184, .2);
        border-radius: 8px;
        background: rgba(255, 255, 255, .04);
        color: var(--text-primary);
        cursor: pointer;
        font: inherit;
    }
    .folder-chevron {
        display: inline-block;
        transition: transform .18s ease;
    }
    .folder-group.is-open .folder-chevron { transform: rotate(90deg); }
    .folder-group-main { flex: 1; min-width: 0; }
    .folder-group-title { font-weight: 800; font-size: .9rem; }
    .folder-group-path {
        margin-top: .15rem;
        color: var(--text-secondary);
        font-size: .71rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        word-break: break-all;
    }
    .folder-group-meta {
        display: flex;
        align-items: center;
        gap: .35rem;
        flex-wrap: wrap;
        margin-top: .4rem;
    }
    .folder-group-actions { display: flex; gap: .35rem; flex-wrap: wrap; }
    .folder-group-body {
        display: none;
        padding: .7rem;
        border-top: 1px solid rgba(148, 163, 184, .12);
    }
    .folder-group-body .library-table-wrap { border: 0; }
    .folder-loading {
        padding: .9rem;
        color: var(--text-secondary);
        font-size: .78rem;
        text-align: center;
    }
    .discovery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1rem;
    }
    .discovery-card {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 14px;
        border: 1px solid rgba(148, 163, 184, .16);
        background: var(--panel-solid, #1e293b);
        cursor: pointer;
        transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    }
    .discovery-card:hover {
        transform: translateY(-4px);
        border-color: rgba(56, 189, 248, .35);
        box-shadow: 0 18px 40px rgba(0, 0, 0, .35);
    }
    .discovery-poster-wrap {
        position: relative;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(56, 189, 248, .12), rgba(129, 140, 248, .12));
    }
    .discovery-poster { width: 100%; height: 100%; object-fit: cover; display: block; }
    .discovery-poster--empty {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        font-weight: 900;
        color: rgba(255, 255, 255, .45);
    }
    .discovery-poster-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15, 23, 42, .95), transparent 48%);
        pointer-events: none;
    }
    .discovery-type-badge {
        position: absolute;
        top: .55rem;
        left: .55rem;
        z-index: 2;
        padding: .25rem .45rem;
        border-radius: 6px;
        color: #e2e8f0;
        background: rgba(15, 23, 42, .82);
        border: 1px solid rgba(255, 255, 255, .12);
        backdrop-filter: blur(8px);
        font-size: .6rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
    }
    .discovery-rating {
        position: absolute;
        top: .55rem;
        right: .55rem;
        z-index: 2;
        padding: .22rem .38rem;
        border-radius: 6px;
        color: #fbbf24;
        background: rgba(15, 23, 42, .82);
        border: 1px solid rgba(251, 191, 36, .18);
        font-size: .66rem;
        font-weight: 800;
    }
    .discovery-flag {
        position: absolute;
        left: .55rem;
        bottom: .55rem;
        z-index: 2;
        padding: .22rem .4rem;
        border-radius: 6px;
        font-size: .6rem;
        font-weight: 750;
    }
    .discovery-flag--danger {
        color: #fca5a5;
        background: rgba(239, 68, 68, .18);
        border: 1px solid rgba(239, 68, 68, .3);
    }
    .discovery-card-body {
        display: flex;
        flex-direction: column;
        gap: .32rem;
        flex: 1;
        padding: .8rem .85rem .9rem;
    }
    .discovery-card-title {
        margin: 0;
        font-size: .86rem;
        font-weight: 750;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .discovery-card-title span { color: var(--text-secondary); font-weight: 600; }
    .discovery-card-sub {
        min-height: 1em;
        color: var(--text-secondary);
        font-size: .69rem;
        word-break: break-all;
    }
    .discovery-card-stats {
        display: flex;
        align-items: center;
        gap: .38rem;
        color: var(--text-secondary);
        font-size: .71rem;
    }
    .discover-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text-secondary); }
    .discovery-card-chips { display: flex; gap: .28rem; flex-wrap: wrap; }
    .discovery-card-actions {
        margin-top: auto;
        padding-top: .45rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
    }
    .discovery-view-link { color: var(--accent); font-size: .73rem; font-weight: 700; }
    .discovery-card:hover .discovery-view-link { text-decoration: underline; }
    .discovery-hero {
        position: relative;
        display: flex;
        align-items: flex-end;
        gap: 1rem;
        min-height: 220px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        border-radius: 14px;
        overflow: hidden;
        background-size: cover;
        background-position: center;
        background-color: rgba(15, 23, 42, .7);
    }
    .discovery-hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(to top, rgba(30, 41, 59, 1) 3%, rgba(30, 41, 59, .72) 40%, rgba(15, 23, 42, .2) 100%),
            linear-gradient(to right, rgba(15, 23, 42, .8), transparent 65%);
    }
    .discovery-hero-poster {
        position: relative;
        z-index: 1;
        width: 110px;
        flex: 0 0 auto;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, .12);
        box-shadow: 0 16px 36px rgba(0, 0, 0, .5);
    }
    .discovery-hero-poster--empty {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(56, 189, 248, .25), rgba(129, 140, 248, .25));
        font-size: 1.8rem;
        font-weight: 900;
        color: rgba(255, 255, 255, .6);
    }
    .discovery-hero-copy { position: relative; z-index: 1; min-width: 0; }
    .discovery-hero-title { margin: 0; font-size: clamp(1.3rem, 3vw, 1.9rem); letter-spacing: -.035em; }
    .discovery-hero-meta {
        display: flex;
        align-items: center;
        gap: .4rem;
        flex-wrap: wrap;
        margin-top: .35rem;
        color: #cbd5e1;
        font-size: .8rem;
    }
    .discovery-hero-overview {
        margin: .55rem 0 0;
        max-width: 760px;
        color: #cbd5e1;
        font-size: .82rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .discovery-hero-actions {
        display: flex;
        align-items: center;
        gap: .4rem;
        flex-wrap: wrap;
        margin-top: .65rem;
    }
    .folder-browser-layout {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
    }
    .folder-tree-panel {
        max-height: 72vh;
        overflow: auto;
        padding-right: .9rem;
        border-right: 1px solid rgba(148, 163, 184, .14);
    }
    .folder-tree-head {
        margin-bottom: .55rem;
        color: var(--text-secondary);
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .folder-tree-list { list-style: none; margin: 0; padding: 0; }
    .folder-tree-list .folder-tree-list {
        margin-left: .45rem;
        padding-left: .75rem;
        border-left: 1px solid rgba(148, 163, 184, .12);
    }
    .folder-tree-row {
        display: flex;
        align-items: center;
        gap: .22rem;
        padding: .22rem .28rem;
        border-radius: 6px;
    }
    .folder-tree-item.is-active > .folder-tree-row { background: rgba(56, 189, 248, .12); }
    .folder-tree-toggle {
        width: 18px;
        height: 18px;
        flex: 0 0 auto;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        font-size: .7rem;
        transition: transform .15s ease;
    }
    .folder-tree-item.is-open > .folder-tree-row .folder-tree-toggle { transform: rotate(90deg); }
    .folder-tree-spacer { width: 18px; height: 18px; flex: 0 0 auto; }
    .folder-tree-label {
        flex: 1;
        min-width: 0;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-secondary);
        font: inherit;
        font-size: .76rem;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }
    .folder-tree-label:hover { color: var(--text-primary); }
    .folder-tree-item.is-active > .folder-tree-row .folder-tree-label {
        color: var(--text-primary);
        font-weight: 700;
    }
    .folder-tree-count { flex: 0 0 auto; color: var(--text-muted, #64748b); font-size: .64rem; }
    .folder-tree-children { display: none; }
    .folder-tree-item.is-open > .folder-tree-children { display: block; }
    .folder-content-panel { min-width: 0; }
    .folder-breadcrumb {
        display: flex;
        align-items: center;
        gap: .3rem;
        flex-wrap: wrap;
        margin-bottom: .8rem;
        font-size: .76rem;
    }
    .folder-breadcrumb button {
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--accent);
        font: inherit;
        cursor: pointer;
    }
    .folder-breadcrumb button:hover { text-decoration: underline; }
    .folder-breadcrumb .sep { color: var(--text-muted, #64748b); }
    .folder-content-head { margin-bottom: .85rem; }
    .folder-content-title { font-size: 1.05rem; font-weight: 800; letter-spacing: -.02em; }
    .folder-content-meta { margin-top: .22rem; color: var(--text-secondary); font-size: .75rem; }
    .folder-section-title {
        margin: .15rem 0 .55rem;
        color: var(--text-secondary);
        font-size: .67rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .folder-subfolders {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: .65rem;
        margin-bottom: 1.1rem;
    }
    .folder-subfolder {
        display: flex;
        align-items: center;
        gap: .7rem;
        min-height: 68px;
        padding: .7rem .8rem;
        border: 1px solid rgba(148, 163, 184, .16);
        border-radius: 10px;
        background: rgba(15, 23, 42, .35);
        color: var(--text-primary);
        font: inherit;
        text-align: left;
        cursor: pointer;
        min-width: 0;
    }
    .folder-subfolder:hover { border-color: rgba(56, 189, 248, .4); background: rgba(15, 23, 42, .55); }
    .folder-subfolder-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        border-radius: 9px;
        color: var(--accent);
        background: rgba(56, 189, 248, .12);
    }
    .folder-subfolder-main {
        display: flex;
        flex-direction: column;
        gap: .18rem;
        flex: 1;
        min-width: 0;
    }
    .folder-subfolder-title {
        display: block;
        font-size: .8rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .folder-subfolder-meta { display: block; color: var(--text-secondary); font-size: .7rem; }
    .folder-files-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: .5rem;
    }
    .folder-files-title {
        color: var(--text-secondary);
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .07em;
        text-transform: uppercase;
    }
    .folder-loading {
        padding: 1.5rem;
        border: 1px dashed rgba(148, 163, 184, .24);
        border-radius: 12px;
        color: var(--text-secondary);
        font-size: .78rem;
        text-align: center;
    }
    @media (max-width: 760px) {
        .folder-browser-layout { grid-template-columns: 1fr; }
        .folder-tree-panel {
            max-height: 300px;
            padding-right: 0;
            padding-bottom: .75rem;
            border-right: 0;
            border-bottom: 1px solid rgba(148, 163, 184, .14);
        }
        .rename-item { grid-template-columns: 1fr; }
        .library-search { width: 100%; }
        .library-search input { flex: 1; min-width: 160px; }
    }
    .library-scan-state[hidden] {
        display: none;
    }
    .library-scan-state {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding: .85rem 1rem;
        margin-bottom: 1rem;
        border: 1px solid rgba(56, 189, 248, .24);
        border-left: 4px solid var(--accent);
        border-radius: 11px;
        background: rgba(56, 189, 248, .07);
        font-size: .8rem;
    }
    .library-scan-state.is-waiting {
        border-color: rgba(245, 158, 11, .28);
        border-left-color: var(--warning);
        background: rgba(245, 158, 11, .08);
    }
    .library-scan-state.is-stale {
        border-color: rgba(239, 68, 68, .3);
        border-left-color: #ef4444;
        background: rgba(239, 68, 68, .08);
    }
    .library-scan-spinner {
        width: 16px;
        height: 16px;
        flex: 0 0 auto;
        margin-top: .16rem;
        border-radius: 50%;
        border: 2px solid rgba(56, 189, 248, .25);
        border-top-color: var(--accent);
        animation: library-scan-spin .8s linear infinite;
    }
    .library-scan-state.is-waiting .library-scan-spinner,
    .library-scan-state.is-stale .library-scan-spinner {
        border-top-color: var(--warning);
    }
    @keyframes library-scan-spin { to { transform: rotate(360deg); } }
    .library-scan-meta { margin-top: .2rem; color: var(--text-secondary); font-size: .73rem; }
</style>

{% embed '_partials/page_header.html.twig' with {
    title: 'Library Browser',
    subtitle: 'Browse matched and unmatched NAS entries, then rename matched files to the current Jellyfin-friendly convention.',
    icon: 'automation'
} %}
    {% block actions %}
        <button class="btn btn-secondary" type="button" onclick="startLibraryScan()">Scan now</button>
        <button class="btn btn-secondary" type="button" onclick="startMetadataResolution()" {{ (resolve_requested or not tmdb_configured) ? 'disabled' : '' }} title="{{ tmdb_configured ? '' : 'Configure a TMDB API key in Discover first.' }}">Resolve metadata</button>
        <button class="btn btn-secondary" type="button" onclick="startTitleRefresh()" {{ (not tmdb_configured or title_refresh.status in ['requested', 'running']) ? 'disabled' : '' }} title="{{ tmdb_configured ? 'Refresh movie titles from TMDB. Then use Rename matched.' : 'Configure a TMDB API key in Discover first.' }}">Refresh English titles</button>
        <button class="btn btn-primary" type="button" onclick="openRenamePreview()">Rename matched</button>
    {% endblock %}
{% endembed %}

{% include 'automation/_nav.html.twig' %}

<div class="library-scan-state {{ scan_running ? '' : 'is-waiting' }}" id="library-scan-state" data-requested="{{ scan_requested ? '1' : '0' }}" {% if not scan_running and not scan_requested and not scan_lock_error %}hidden{% endif %}>
    <span class="library-scan-spinner" aria-hidden="true"></span>
    <div>
        <strong id="library-scan-title">{{ scan_running ? 'Library scan in progress' : 'Library scan queued' }}</strong>
        <div class="library-scan-meta" id="library-scan-meta">
            {% if scan_lock_error %}
                {{ scan_lock_error }}
            {% elseif running_scan and running_scan.files_seen > 0 %}
                {{ running_scan.files_seen }} seen · {{ running_scan.files_indexed }} new · {{ running_scan.files_updated }} updated · {{ running_scan.files_missing }} missing
            {% elseif scan_requested and scan_requested_at > 0 %}
                Requested {{ scan_requested_at|date('Y-m-d H:i:s') }} · waiting for the automation worker
            {% elseif last_scan %}
                Last scan {{ last_scan.finished_at ?: last_scan.started_at }} · {{ last_scan.status }}
            {% else %}
                Waiting for the automation worker…
            {% endif %}
        </div>
    </div>
</div>

<div class="library-scan-state {{ resolve_requested ? '' : 'is-waiting' }}" id="library-resolution-state" {% if not resolve_requested %}hidden{% endif %}>
    <span class="library-scan-spinner" aria-hidden="true"></span>
    <div>
        <strong id="library-resolution-title">{{ resolve_requested ? 'Metadata resolution in progress' : 'Metadata resolution queued' }}</strong>
        <div class="library-scan-meta" id="library-resolution-meta">
            {% if last_resolution %}
                Last run {{ last_resolution.finished_at|default('—') }} · {{ last_resolution.groups_resolved|default(0) }} groups resolved · {{ last_resolution.entries_resolved|default(0) }} entries updated
            {% else %}
                Resolve series and movies to TMDB.
            {% endif %}
        </div>
    </div>
</div>

<div class="library-scan-state {{ title_refresh.status == 'running' ? '' : 'is-waiting' }}" id="library-title-refresh-state" {% if title_refresh.status not in ['requested', 'running'] %}hidden{% endif %}>
    <span class="library-scan-spinner" aria-hidden="true"></span>
    <div>
        <strong id="library-title-refresh-title">{{ title_refresh.status == 'running' ? 'English title refresh in progress' : 'English title refresh requested' }}</strong>
        <div class="library-scan-meta" id="library-title-refresh-meta">
            {% if title_refresh.total > 0 %}
                {{ title_refresh.processed }} / {{ title_refresh.total }} TMDB movie{{ title_refresh.total == 1 ? '' : 's' }} · {{ title_refresh.updated }} entr{{ title_refresh.updated == 1 ? 'y' : 'ies' }} updated
            {% else %}
                Refreshing movie titles to {{ title_refresh.language|default('en-US') }}. Use Rename matched afterwards to preview file moves.
            {% endif %}
        </div>
    </div>
</div>

{% import 'automation/_library_table.html.twig' as libraryTable %}

<section class="card library-filter-card">
    <div class="library-filter-row">
        <div class="library-filter-group">
            <span class="library-filter-label">Status</span>
            <div class="library-tabs">
                {% set statuses = {
                    all: {label: 'All', count: counts.all},
                    matched: {label: 'Matched', count: counts.matched},
                    unmatched: {label: 'Unmatched', count: counts.unmatched},
                    ignored: {label: 'Ignored', count: counts.ignored},
                    missing: {label: 'Missing', count: counts.missing}
                } %}
                {% for key, item in statuses %}
                    <a class="library-tab {{ filters.status == key ? 'active' : '' }}"
                       href="{{ path('automation_library', {status: key, type: filters.type, q: filters.q, view: view}) }}">
                        {{ item.label }} <span class="count">{{ item.count }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>

        <div class="library-filter-group">
            <span class="library-filter-label">View</span>
            <div class="library-tabs">
                <a class="library-tab {{ view == 'flat' ? 'active' : '' }}"
                   href="{{ path('automation_library', {status: filters.status, type: filters.type, q: filters.q, view: 'flat'}) }}">Flat</a>
                <a class="library-tab {{ view == 'folder' ? 'active' : '' }}"
                   href="{{ path('automation_library', {status: filters.status, type: filters.type, q: filters.q, view: 'folder'}) }}">Folders</a>
                <a class="library-tab {{ view == 'discovery' ? 'active' : '' }}"
                   href="{{ path('automation_library', {status: filters.status, type: filters.type, q: filters.q, view: 'discovery'}) }}">Discovery</a>
            </div>
        </div>
    </div>

    <div class="library-filter-row">
        <form class="library-search" method="get" action="{{ path('automation_library') }}">
            <span class="library-filter-label">Search</span>
            <input type="hidden" name="status" value="{{ filters.status }}">
            <input type="hidden" name="view" value="{{ view }}">
            <select name="type">
                <option value="all" {{ filters.type == 'all' ? 'selected' : '' }}>All types</option>
                <option value="movie" {{ filters.type == 'movie' ? 'selected' : '' }}>Movies</option>
                <option value="series" {{ filters.type == 'series' ? 'selected' : '' }}>Series</option>
                <option value="anime" {{ filters.type == 'anime' ? 'selected' : '' }}>Anime</option>
            </select>
            <input type="text" name="q" value="{{ filters.q }}" placeholder="Title, path, TMDB ID...">
            <button class="btn btn-secondary btn-sm" type="submit">Apply</button>
        </form>

    </div>

    <div class="library-filter-row">
        <div class="library-naming">
            <span class="library-filter-label">Naming</span>
            <div class="naming-summary">
                <span class="badge badge-success">{{ naming_summary.conform }} conform</span>
                <span class="badge badge-info">{{ naming_summary.rename }} to rename</span>
                <span class="badge badge-danger">{{ naming_summary.conflict }} conflicts</span>
                <span class="badge badge-neutral">{{ naming_summary.skip }} skipped</span>
            </div>
        </div>
    </div>
</section>

{% if view == 'folder' %}
    <section class="card" style="margin-bottom:1rem;">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem;">
            <div>
                <h2 class="activity-card-title" style="margin:0;font-size:1rem;">Folder browser</h2>
