            ? '<img class="discovery-hero-poster" src="' + escapeLibraryHtml(details.poster) + '" alt="">'
            : '<div class="discovery-hero-poster discovery-hero-poster--empty">' + escapeLibraryHtml(String(title).charAt(0).toUpperCase()) + '</div>';
        const backdrop = details && details.backdrop
            ? ' style="background-image:url(\'' + escapeLibraryHtml(details.backdrop) + '\')"'
            : '';
        const genres = details && Array.isArray(details.genres) && details.genres.length
            ? details.genres.map(escapeLibraryHtml).join(' · ')
            : '';
        const matchGroup = JSON.stringify(group);
        const files = (data.files || []).length;
        const meta = [originalTitle, year ? '(' + year + ')' : null, genres, details && details.rating ? details.rating + '/10' : null, imdbId]
            .filter(Boolean)
            .map(escapeLibraryHtml)
            .join(' · ');

        container.innerHTML = '<div class="discovery-hero"' + backdrop + '>' +
            poster +
            '<div class="discovery-hero-copy">' +
                '<h3 class="discovery-hero-title">' + escapeLibraryHtml(title) + '</h3>' +
                '<div class="discovery-hero-meta">' + meta + '</div>' +
                '<p class="discovery-hero-overview">' + escapeLibraryHtml(overview) + '</p>' +
                '<div class="discovery-hero-actions">' +
                    '<span class="badge badge-neutral">' + files + ' file' + (files === 1 ? '' : 's') + '</span>' +
                    (tmdbId ? '<span class="badge badge-success">TMDB ' + escapeLibraryHtml(tmdbId) + '</span>' : '<span class="badge badge-warning">Unmatched</span>') +
                    '<button class="btn btn-secondary btn-sm" type="button" data-match-action="open" data-match-group="' + escapeLibraryHtml(matchGroup) + '" data-match-type="' + escapeLibraryHtml(button.getAttribute('data-discovery-type') || 'series') + '" data-match-id="' + escapeLibraryHtml(tmdbId || '') + '" data-match-title="' + escapeLibraryHtml(title) + '">' + (tmdbId ? 'Fix match' : 'Match') + '</button>' +
                '</div>' +
            '</div>' +
        '</div>';
        container.style.display = 'block';
    }

    async function openDiscoveryElement(button) {
        const group = JSON.parse(button.getAttribute('data-discovery-group') || '{}');
        const tmdbId = button.getAttribute('data-discovery-tmdb-id') || '';
        const title = button.getAttribute('data-discovery-title') || group.title || '';
        const dialog = document.getElementById('discovery-dialog');
        const details = document.getElementById('discovery-details');
        const files = document.getElementById('discovery-files');
        const dialogTitle = document.getElementById('discovery-dialog-title');
        const subtitle = document.getElementById('discovery-dialog-subtitle');

        if (dialogTitle) dialogTitle.textContent = title;
        if (subtitle) subtitle.textContent = group.media_type === 'movie' ? 'Movie' : 'Series';
        if (details) {
            details.style.display = 'none';
            details.innerHTML = '';
        }
        if (files) files.innerHTML = '<div class="library-empty">Loading files…</div>';
        if (dialog && typeof dialog.showModal === 'function') dialog.showModal();

        try {
            const data = await matchRequest(libraryElementRoute, {
                group,
                tmdb_id: tmdbId
            });
            renderDiscoveryDetails(data, button);
            renderFolderEntries(files, data.files || []);
        } catch (error) {
            if (files) files.innerHTML = '<div class="library-empty">' + escapeLibraryHtml(error.message) + '</div>';
            if (window.notify) window.notify('error', error.message);
        }
    }

    function renderFolderBreadcrumb(items) {
        const container = document.getElementById('folder-breadcrumb');
        if (!container) return;
        container.innerHTML = '';
        items.forEach((item, index) => {
            if (index > 0) {
                const separator = document.createElement('span');
                separator.className = 'sep';
                separator.textContent = '/';
                container.appendChild(separator);
            }
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = item.label;
            button.setAttribute('data-folder-select', '');
            button.setAttribute('data-root-key', item.root_key || '');
            button.setAttribute('data-folder-path', item.path || '');
            container.appendChild(button);
        });
    }

    function renderFolderContents(data) {
        const content = document.getElementById('folder-content');
        if (!content) return;
        content.innerHTML = '';
        const subfolders = data.subfolders || [];
        const files = data.files || [];
        const rootKey = data.root_key || '';
        const breadcrumb = data.breadcrumb || [];
        const currentLabel = breadcrumb.length ? breadcrumb[breadcrumb.length - 1].label : '';

        const header = document.createElement('div');
        header.className = 'folder-content-head';
        header.innerHTML =
            '<div class="folder-content-title">' + escapeLibraryHtml(currentLabel) + '</div>' +
            '<div class="folder-content-meta">' + subfolders.length + ' folder' + (subfolders.length === 1 ? '' : 's') +
            ' · ' + files.length + ' file' + (files.length === 1 ? '' : 's') + '</div>';
        content.appendChild(header);

        if (!subfolders.length && !files.length) {
            const empty = document.createElement('div');
            empty.className = 'library-empty';
            empty.textContent = 'This folder is empty.';
            content.appendChild(empty);
            return;
        }

        if (subfolders.length) {
            const sectionTitle = document.createElement('div');
            sectionTitle.className = 'folder-section-title';
            sectionTitle.textContent = 'Folders';
            content.appendChild(sectionTitle);

            const grid = document.createElement('div');
            grid.className = 'folder-subfolders';
            subfolders.forEach(folder => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'folder-subfolder';
                button.setAttribute('data-folder-select', '');
                button.setAttribute('data-root-key', rootKey);
                button.setAttribute('data-folder-path', folder.path || '');
                const meta = [folder.files + ' file' + (folder.files === 1 ? '' : 's')];
                if (folder.missing) meta.push(folder.missing + ' missing');
                button.innerHTML =
                    '<span class="folder-subfolder-icon">' +
                        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h6l2 2h10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/></svg>' +
                    '</span>' +
                    '<span class="folder-subfolder-main">' +
                        '<span class="folder-subfolder-title">' + escapeLibraryHtml(folder.label) + '</span>' +
                        '<span class="folder-subfolder-meta">' + escapeLibraryHtml(meta.join(' · ')) + '</span>' +
                    '</span>';
                grid.appendChild(button);
            });
            content.appendChild(grid);
        }

        if (files.length) {
            const head = document.createElement('div');
            head.className = 'folder-files-head';
            head.innerHTML = '<span class="folder-files-title">Files</span><span class="muted-sm">' + files.length + ' file' + (files.length === 1 ? '' : 's') + '</span>';
            content.appendChild(head);
            const table = document.createElement('div');
            renderFolderEntries(table, files);
            content.appendChild(table);
        }
    }

    async function loadFolderContents(rootKey, folderPath) {
        const content = document.getElementById('folder-content');
        const breadcrumb = document.getElementById('folder-breadcrumb');
        if (!content) return;
        content.innerHTML = '<div class="folder-loading">Loading folder…</div>';
        if (breadcrumb) breadcrumb.innerHTML = '';
        try {
            const data = await matchRequest(libraryFolderContentsRoute, {
                root_key: rootKey,
                folder_path: folderPath,
                filters: libraryFilters
            });
            renderFolderBreadcrumb(data.breadcrumb || []);
            renderFolderContents(data);
        } catch (error) {
            content.innerHTML = '<div class="folder-loading">' + escapeLibraryHtml(error.message) + '</div>';
        }
    }

    function createTreeItem(folder, rootKey) {
        const hasChildren = !!folder.has_children;
        const item = document.createElement('li');
        item.className = 'folder-tree-item';

        const row = document.createElement('div');
        row.className = 'folder-tree-row';
        if (hasChildren) {
            const toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'folder-tree-toggle';
            toggle.setAttribute('data-tree-toggle', '');
            toggle.setAttribute('aria-label', 'Toggle folder');
            toggle.textContent = '▸';
            row.appendChild(toggle);
        } else {
            const spacer = document.createElement('span');
            spacer.className = 'folder-tree-spacer';
            row.appendChild(spacer);
        }

        const label = document.createElement('button');
        label.type = 'button';
        label.className = 'folder-tree-label';
        label.setAttribute('data-folder-select', '');
        label.setAttribute('data-root-key', rootKey);
        label.setAttribute('data-folder-path', folder.path || '');
        label.title = folder.label || '';
        label.textContent = folder.label || '';
        row.appendChild(label);

        const count = document.createElement('span');
        count.className = 'folder-tree-count';
        count.textContent = String(folder.files || 0);
        row.appendChild(count);
        item.appendChild(row);

        if (hasChildren) {
            const children = document.createElement('div');
            children.className = 'folder-tree-children';
            children.setAttribute('data-tree-children', '');
            children.setAttribute('data-loaded', '0');
            item.appendChild(children);
        }

        return item;
    }

    async function loadTreeChildren(treeItem) {
        const container = treeItem.querySelector(':scope > [data-tree-children]');
        if (!container || container.dataset.loaded === '1' || container.dataset.loaded === 'loading') {
            return;
        }
        const label = treeItem.querySelector(':scope > .folder-tree-row [data-folder-select]');
        if (!label) return;
        const rootKey = label.getAttribute('data-root-key') || '';
        const folderPath = label.getAttribute('data-folder-path') || '';

        container.dataset.loaded = 'loading';
        container.innerHTML = '<div class="folder-loading">Loading folders…</div>';
        try {
            const data = await matchRequest(libraryFolderContentsRoute, {
                root_key: rootKey,
                folder_path: folderPath,
                filters: libraryFilters
            });
            const list = document.createElement('ul');
            list.className = 'folder-tree-list';
            (data.subfolders || []).forEach(folder => {
                list.appendChild(createTreeItem(folder, rootKey));
            });
            container.innerHTML = '';
            container.appendChild(list);
            container.dataset.loaded = '1';
        } catch (error) {
            container.innerHTML = '<div class="folder-loading">' + escapeLibraryHtml(error.message) + '</div>';
            container.dataset.loaded = '0';
            throw error;
        }
    }

    function selectFolder(rootKey, folderPath, element) {
        document.querySelectorAll('.folder-tree-item.is-active').forEach(item => item.classList.remove('is-active'));
        const treeItem = element ? element.closest('.folder-tree-item') : null;
        if (treeItem) {
            treeItem.classList.add('is-active');
        }

        const params = new URLSearchParams(window.location.search);
        params.set('view', 'folder');
        params.set('root', rootKey);
        params.set('folder', folderPath);
        params.delete('page');
        window.history.replaceState(null, '', window.location.pathname + '?' + params.toString());

        loadFolderContents(rootKey, folderPath);
    }

    document.addEventListener('click', async function (event) {
        const collapsibleHead = event.target.closest('[data-collapsible-head]');
        if (collapsibleHead) {
            const section = collapsibleHead.closest('[data-collapsible-section]');
            if (section) {
                const collapsed = section.classList.toggle('is-collapsed');
                const icon = collapsibleHead.querySelector('.collapsible-chevron');
                if (icon) icon.textContent = collapsed ? '▼' : '▲';
            }
            return;
        }

        const treeToggle = event.target.closest('[data-tree-toggle]');
        if (treeToggle) {
            const treeItem = treeToggle.closest('.folder-tree-item');
            if (!treeItem) return;
            if (treeItem.classList.contains('is-open')) {
                treeItem.classList.remove('is-open');
                return;
            }
            try {
                await loadTreeChildren(treeItem);
                treeItem.classList.add('is-open');
            } catch (error) {
                if (window.notify) window.notify('error', error.message);
            }
            return;
        }

        const folderSelect = event.target.closest('[data-folder-select]');
        if (folderSelect) {
            const treeItem = folderSelect.closest('.folder-tree-item');
            if (treeItem) {
                try {
                    await loadTreeChildren(treeItem);
                    treeItem.classList.add('is-open');
                } catch (error) {
                    if (window.notify) window.notify('error', error.message);
                }
            }
            selectFolder(
                folderSelect.getAttribute('data-root-key') || '',
                folderSelect.getAttribute('data-folder-path') || '',
                folderSelect
            );
            return;
        }

        const folderToggle = event.target.closest('[data-folder-toggle]');
        if (folderToggle) {
            toggleFolderGroup(folderToggle);
            return;
        }

        const removeButton = event.target.closest('[data-remove-entry]');
        if (removeButton) {
            removeMissingEntry(removeButton.getAttribute('data-remove-entry'));
            return;
        }

        const matchButton = event.target.closest('[data-match-action="open"]');
        if (matchButton) {
            openMatchDialog(matchButton);
            return;
        }

        const discoveryButton = event.target.closest('[data-discovery-open]');
        if (discoveryButton) {
            openDiscoveryElement(discoveryButton);
        }
    });

    const discoveryDialog = document.getElementById('discovery-dialog');
    if (discoveryDialog) {
        const close = () => discoveryDialog.close();
        document.getElementById('discovery-dialog-close')?.addEventListener('click', close);
        document.getElementById('discovery-dialog-cancel')?.addEventListener('click', close);
        discoveryDialog.addEventListener('click', event => {
            if (event.target === discoveryDialog) discoveryDialog.close();
        });
    }

    const matchDialog = document.getElementById('match-dialog');
    if (matchDialog) {
        const close = () => matchDialog.close();
        document.getElementById('match-dialog-close')?.addEventListener('click', close);
        document.getElementById('match-cancel')?.addEventListener('click', close);
        document.getElementById('match-apply')?.addEventListener('click', applyMatch);
        document.getElementById('match-search-btn')?.addEventListener('click', () => {
            const input = document.getElementById('match-query');
            searchMatch(input ? input.value : '');
        });
        document.getElementById('match-query')?.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                searchMatch(event.target.value);
            }
        });
        matchDialog.addEventListener('click', event => {
            if (event.target === matchDialog) matchDialog.close();
        });
    }

    const renameDialog = document.getElementById('rename-dialog');
    if (renameDialog) {
        const close = () => renameDialog.close();
        document.getElementById('rename-dialog-close')?.addEventListener('click', close);
        document.getElementById('rename-cancel')?.addEventListener('click', close);
        document.getElementById('rename-apply')?.addEventListener('click', applyRenames);
        renameDialog.addEventListener('click', event => {
            if (event.target === renameDialog) renameDialog.close();
        });
    }

    const initialFolderContent = document.getElementById('folder-content');
    if (initialFolderContent) {
        const rootKey = initialFolderContent.getAttribute('data-root-key') || '';
        const folderPath = initialFolderContent.getAttribute('data-folder-path') || '';
        if (rootKey !== '') {
            loadFolderContents(rootKey, folderPath);
        }
    }

    if (initialScanRunning || initialScanRequested) {
        setTimeout(pollLibraryScanStatus, 1200);
    }
    if (initialResolutionRequested) {
        setTimeout(pollResolutionStatus, 1200);
    }
    if (initialTitleRefreshActive) {
        setTimeout(pollTitleRefreshStatus, 1200);
    }

{% include 'automation/_attention_script.html.twig' %}
</script>
{% endblock %}
