    .help-status.warn { border-color: rgba(245, 158, 11, .28); color: #fcd34d; background: rgba(245, 158, 11, .07); }
    .help-status.bad { border-color: rgba(239, 68, 68, .28); color: #fca5a5; background: rgba(239, 68, 68, .07); }
    .help-status-arrow {
        color: var(--text-muted, #64748b);
        font-size: .8rem;
    }
    .help-columns {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
