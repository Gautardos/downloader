    }
    @media (max-width: 1020px) {
        .help-layout {
            grid-template-columns: 1fr;
        }
        .help-toc {
            position: static;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .15rem;
        }
        .help-toc-title {
            grid-column: 1 / -1;
        }
        .help-grid,
        .help-grid.two {
