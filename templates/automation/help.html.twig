        width: 100%;
        height: auto;
        border: 1px solid rgba(148, 163, 184, .18);
        border-radius: 12px;
        background: rgba(15, 23, 42, .5);
        box-shadow: 0 18px 45px rgba(0, 0, 0, .18);
    }
    .help-figure figcaption {
        margin-top: .5rem;
        color: var(--text-secondary);
        font-size: .72rem;
        line-height: 1.5;
    }
    .help-status-flow {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .35rem;
        margin: .9rem 0;
    }
    .help-status {
        display: inline-flex;
        align-items: center;
        padding: .32rem .5rem;
        border: 1px solid rgba(148, 163, 184, .18);
        border-radius: 999px;
        color: var(--text-secondary);
        background: rgba(15, 23, 42, .45);
        font-size: .7rem;
        font-weight: 700;
