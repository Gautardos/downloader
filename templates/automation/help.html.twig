        color: #38bdf8;
        font-size: 1.1rem;
        line-height: 1;
    }
    .help-check-list {
        display: grid;
        gap: .55rem;
        margin: .8rem 0 1rem;
        padding: 1rem;
        border: 1px solid rgba(148, 163, 184, .14);
        border-radius: 12px;
        background: rgba(15, 23, 42, .32);
    }
    .help-check-item {
        display: flex;
        align-items: flex-start;
        gap: .55rem;
        color: var(--text-secondary);
        font-size: .8rem;
        line-height: 1.55;
    }
    .help-check-mark {
        display: inline-grid;
        place-items: center;
        width: 18px;
        height: 18px;
        flex: 0 0 auto;
        margin-top: .05rem;
        border-radius: 50%;
        background: rgba(34, 197, 94, .15);
        color: #86efac;
        font-size: .65rem;
        font-weight: 900;
