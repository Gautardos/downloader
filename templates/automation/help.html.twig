{% extends 'base.html.twig' %}

{% block title %}Guide Automations - Downloader{% endblock %}

{% block body %}
<style>
    .help-layout {
        display: grid;
        grid-template-columns: 245px minmax(0, 1fr);
        gap: 1.25rem;
        align-items: start;
    }
    .help-toc {
        position: sticky;
        top: 88px;
        padding: 1rem;
    }
    .help-toc-title {
        margin: 0 0 .65rem;
        color: var(--text-secondary);
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }
    .help-toc a {
        display: block;
        padding: .42rem .55rem;
        border-radius: 8px;
        color: var(--text-secondary);
        font-size: .78rem;
        line-height: 1.35;
        text-decoration: none;
    }
    .help-toc a:hover {
        color: var(--text-primary);
        background: rgba(255, 255, 255, .05);
    }
    .help-content {
        min-width: 0;
    }
    .help-section {
        scroll-margin-top: 92px;
        padding: 0 0 1.7rem;
        margin: 0 0 1.7rem;
        border-bottom: 1px solid rgba(148, 163, 184, .13);
    }
    .help-section:last-child {
        border-bottom: 0;
        margin-bottom: 0;
        padding-bottom: 0;
    }
    .help-section h2 {
        margin: 0 0 .55rem;
        font-size: 1.35rem;
        letter-spacing: -.03em;
    }
    .help-section h3 {
        margin: 1.25rem 0 .45rem;
        font-size: .98rem;
        letter-spacing: -.01em;
    }
    .help-lead {
        margin: 0 0 1rem;
        color: var(--text-secondary);
        font-size: .9rem;
        line-height: 1.7;
    }
    .help-text {
        color: var(--text-secondary);
        font-size: .83rem;
        line-height: 1.7;
    }
    .help-text strong,
    .help-lead strong {
        color: var(--text-primary);
    }
    .help-text a,
    .help-lead a {
        color: var(--accent);
    }
    .help-text code,
    .help-lead code,
    .help-table code,
    .help-callout code {
        padding: .1rem .3rem;
        border: 1px solid rgba(148, 163, 184, .2);
        border-radius: 5px;
        background: rgba(15, 23, 42, .7);
        color: #bae6fd;
        font-size: .92em;
    }
    .help-muted {
        color: var(--text-muted, #64748b);
    }
    .help-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .8rem;
        margin: 1rem 0;
    }
    .help-grid.two {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .help-card {
        padding: .9rem 1rem;
        border: 1px solid rgba(148, 163, 184, .15);
        border-radius: 12px;
        background: rgba(15, 23, 42, .38);
    }
    .help-card-title {
        display: flex;
        align-items: center;
        gap: .45rem;
        margin: 0 0 .35rem;
        font-size: .83rem;
        font-weight: 800;
    }
    .help-card p {
        margin: 0;
        color: var(--text-secondary);
        font-size: .76rem;
        line-height: 1.55;
    }
    .help-icon {
        display: inline-grid;
        place-items: center;
        width: 24px;
        height: 24px;
        flex: 0 0 auto;
        border-radius: 7px;
        background: rgba(56, 189, 248, .12);
        color: #7dd3fc;
        font-size: .7rem;
        font-weight: 900;
    }
    .help-pipeline {
        display: flex;
        align-items: stretch;
        gap: .4rem;
        margin: 1rem 0;
        overflow-x: auto;
        padding-bottom: .25rem;
    }
    .help-pipeline-step {
        flex: 1 0 120px;
        min-width: 0;
        padding: .72rem .7rem;
        border: 1px solid rgba(148, 163, 184, .16);
        border-radius: 10px;
        background: rgba(15, 23, 42, .52);
    }
    .help-pipeline-step b {
        display: block;
        color: var(--text-primary);
        font-size: .76rem;
    }
    .help-pipeline-step small {
        display: block;
        margin-top: .22rem;
        color: var(--text-secondary);
        font-size: .67rem;
        line-height: 1.35;
    }
    .help-pipeline-arrow {
