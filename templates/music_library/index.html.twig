{% block javascripts %}
<script>
(function () {
    const libraryRoots = {{ roots|json_encode|raw }};
    const defaultRoot = "{{ default_root|e('js') }}";
    const routes = {
        folder: "{{ path('music_library_folder') }}",
        tags: "{{ path('music_library_tags') }}",
        updateTags: "{{ path('music_library_update_tags') }}",
        audit: "{{ path('music_library_lyrics_audit') }}",
        fetchLyrics: "{{ path('music_library_fetch_lyrics') }}",
        updateGenres: "{{ path('music_update_genres') }}",
        moveToLibrary: "{{ path('move_to_library') }}",
        batchRecord: "{{ path('music_batch_record') }}",
        stream: "{{ path('music_stream') }}"
    };

    const fieldMap = {
        title: 'meta-title',
        artist: 'meta-artist',
        album: 'meta-album',
        albumartist: 'meta-albumartist',
        year: 'meta-year',
        genre: 'meta-genre',
        tracknumber: 'meta-tracknumber',
        discnumber: 'meta-discnumber',
        comment: 'meta-comment'
    };

    const issueLabels = {
        encoding: 'encoding',
        timestamps: 'timestamps',
        junk: 'junk',
        repetition: 'repetition',
        length: 'length',
        read_error: 'read error',
        missing: 'missing'
    };

    let currentRoot = defaultRoot;
    let currentFolder = '';
    let currentFolderData = null;
    let selectedPaths = new Set();
    let editorPaths = [];
    let editorRoot = defaultRoot;
    let editorAbsolutePath = '';
    let editorMulti = false;
    let originalLyrics = '';
    let originalTags = {};
    let rootNodes = {};
    let activeFilter = 'all';
    let playerPlaylist = [];
    let playerIndex = -1;
    let batchState = null;

    const treeElement = document.getElementById('folder-tree');
    const trackBody = document.getElementById('track-body');
    const selectionBar = document.getElementById('selection-bar');
    const selectionCount = document.getElementById('selection-count');
    const selectAll = document.getElementById('select-all');
    const metadataDialog = document.getElementById('metadata-dialog');
    const scanDialog = document.getElementById('scan-dialog');
    const reportDialog = document.getElementById('report-dialog');
    const batchDialog = document.getElementById('batch-dialog');
    const libraryPlayer = document.getElementById('library-player');
    const libraryAudio = document.getElementById('library-audio');

    function escapeHtml(value) {
        return String(value === null || value === undefined ? '' : value).replace(/[&<>"']/g, function (char) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
        });
    }

    function lyricsLookSynced(text) {
        return /(^|\n)\s*(?:\[\d{1,3}:\d{2}(?:[.:]\d{1,3})?\]|<\d{1,3}:\d{2}(?:[.:]\d{1,3})?>)/.test(text || '');
    }

    function formatSize(bytes) {
        const value = Number(bytes) || 0;
        if (value >= 1024 * 1024 * 1024) return (value / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
        if (value >= 1024 * 1024) return (value / (1024 * 1024)).toFixed(1) + ' MB';
        if (value >= 1024) return Math.round(value / 1024) + ' KB';
        return value + ' B';
    }

    function formatDate(timestamp) {
        if (!timestamp) return 'Never';
        const date = new Date(Number(timestamp) * 1000);
        if (Number.isNaN(date.getTime())) return 'Never';
        return date.toLocaleString([], { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    }

    function formatPlayerTime(seconds) {
        if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
        const minutes = Math.floor(seconds / 60);
        const remainder = Math.floor(seconds % 60);
        return minutes + ':' + String(remainder).padStart(2, '0');
    }

    function updateStickyOffsets() {
        const nav = document.querySelector('nav');
        const navHeight = nav ? Math.ceil(nav.getBoundingClientRect().height) : 0;
        const playerTop = navHeight + 12;
        document.documentElement.style.setProperty('--music-player-top', playerTop + 'px');

        const playerVisible = !libraryPlayer.hidden;
        const playerHeight = playerVisible ? Math.ceil(libraryPlayer.getBoundingClientRect().height) : 0;
        document.documentElement.style.setProperty(
            '--music-selection-top',
            (playerTop + (playerVisible ? playerHeight + 8 : 0)) + 'px'
        );
    }

    function playerTrack() {
        return playerIndex >= 0 ? playerPlaylist[playerIndex] : null;
    }

    function updatePlayerButton() {
        document.getElementById('player-toggle').textContent = libraryAudio.paused ? '▶' : '⏸';
    }

    function highlightPlayingTrack() {
        const track = playerTrack();
        trackBody.querySelectorAll('.music-track-row').forEach(function (row) {
            row.classList.toggle('is-playing', Boolean(track)
                && row.dataset.path === track.path
                && row.dataset.root === (track.root || currentRoot));
        });
    }

    function showPlayerTrack(track) {
        document.getElementById('player-title').textContent = track ? (track.title || track.name) : 'No track selected';
        document.getElementById('player-subtitle').textContent = track ? [track.artist, track.album].filter(Boolean).join(' · ') : '';
        document.getElementById('player-current').textContent = '0:00';
        document.getElementById('player-duration').textContent = '0:00';
        document.getElementById('player-seek').value = 0;
        libraryPlayer.hidden = false;
        highlightPlayingTrack();
        updateStickyOffsets();
    }

    function playPlayerIndex(index) {
        if (!playerPlaylist.length) return;
        if (index < 0) index = playerPlaylist.length - 1;
        if (index >= playerPlaylist.length) index = 0;
        playerIndex = index;
        const track = playerPlaylist[playerIndex];
        showPlayerTrack(track);
        libraryAudio.src = routes.stream
            + '?root=' + encodeURIComponent(track.root || currentRoot)
            + '&path=' + encodeURIComponent(track.path);
        libraryAudio.load();
        libraryAudio.play().catch(function (error) {
            notify('error', error.message || 'Playback failed.');
        });
    }

    function playTrack(path) {
        const files = (currentFolderData && currentFolderData.files) ? currentFolderData.files : [];
        const index = files.findIndex(function (file) { return file.path === path; });
        if (index === -1) return;
        playerPlaylist = files.slice();
        playPlayerIndex(index);
    }

    function playFolder() {
        const files = (currentFolderData && currentFolderData.files) ? currentFolderData.files : [];
        if (!files.length) {
            notify('info', 'No audio files in this folder.');
            return;
        }
        playerPlaylist = files.slice();
        playPlayerIndex(0);
    }

    function togglePlayerPlayback() {
        if (!libraryAudio.src) {
            if (playerPlaylist.length) {
                playPlayerIndex(Math.max(0, playerIndex));
            } else {
                playFolder();
            }
            return;
        }
        if (libraryAudio.paused) {
            libraryAudio.play().catch(function (error) { notify('error', error.message || 'Playback failed.'); });
        } else {
            libraryAudio.pause();
        }
    }

    function playNextPlayerTrack() {
        if (!playerPlaylist.length) return;
        playPlayerIndex(playerIndex + 1);
    }

    function playPreviousPlayerTrack() {
        if (!playerPlaylist.length) return;
        playPlayerIndex(playerIndex - 1);
    }

    function seekPlayer(value) {
        if (!Number.isFinite(libraryAudio.duration) || libraryAudio.duration <= 0) return;
        libraryAudio.currentTime = (Number(value) / 100) * libraryAudio.duration;
    }

    function closePlayer() {
        libraryAudio.pause();
        libraryAudio.removeAttribute('src');
        libraryAudio.load();
        libraryPlayer.hidden = true;
        playerPlaylist = [];
        playerIndex = -1;
        highlightPlayingTrack();
        updateStickyOffsets();
    }

    function folderUrl(rootKey, path) {
        return routes.folder
            + '?root=' + encodeURIComponent(rootKey || currentRoot)
            + '&path=' + encodeURIComponent(path || '')
            + '&_=' + Date.now();
    }

    async function requestJson(url, options) {
        const response = await fetch(url, options || {});
        let data = {};
        try {
            data = await response.json();
        } catch (error) {
            data = {};
        }
        if (!response.ok || data.success === false) {
            throw new Error(data.message || data.error || ('Request failed (HTTP ' + response.status + ')'));
        }
        return data;
    }

    function postJson(url, payload) {
        return requestJson(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
    }

    async function postJsonResult(url, payload) {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        let data = {};
        try {
            data = await response.json();
        } catch (error) {
            data = {};
        }
        if (!response.ok && data.message) {
            throw new Error(data.message);
        }
        return data;
    }

    function openDialog(dialog) {
        if (dialog && typeof dialog.showModal === 'function') {
            dialog.showModal();
        }
    }

    function notify(type, message) {
        if (window.notify) {
            window.notify(type, message);
        } else {
            console[type === 'error' ? 'error' : 'log'](message);
        }
    }

    function rootLabel(rootKey) {
        const root = libraryRoots.find(function (entry) { return entry.key === rootKey; });
        return root ? root.label : rootKey;
    }

    function findTreeNode(rootKey, path) {
        if (!treeElement) return null;
        return Array.from(treeElement.querySelectorAll('.music-tree-item'))
            .find(function (item) {
                return item.dataset.root === rootKey && item.dataset.path === path;
            }) || null;
    }

    function folderIcon() {
        return '<svg class="music-tree-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg>';
    }

    function createTreeItem(folder, rootKey) {
        const item = document.createElement('li');
        item.className = 'music-tree-item';
        item.dataset.root = rootKey;
        item.dataset.path = folder.path || '';
        item.dataset.loaded = folder.has_children ? '0' : '1';

        const row = document.createElement('div');
        row.className = 'music-tree-row';
        row.innerHTML =
            (folder.has_children
                ? '<button class="music-tree-toggle" type="button" data-tree-toggle aria-label="Toggle folder">▸</button>'
                : '<span class="music-tree-spacer"></span>') +
            folderIcon() +
            '<button class="music-tree-label" type="button" data-folder-select>' + escapeHtml(folder.label || '') + '</button>' +
            (folder.audit && folder.audit.counts && folder.audit.counts.flagged
                ? '<span class="music-tree-issue" title="' + escapeHtml(folder.audit.counts.flagged + ' flagged track(s)') + '">' + escapeHtml(folder.audit.counts.flagged) + '</span>'
                : '') +
            '<span class="music-tree-count">' + escapeHtml(folder.track_count || 0) + '</span>';
        item.appendChild(row);

        if (folder.has_children) {
            const children = document.createElement('div');
            children.className = 'music-tree-children';
            children.dataset.treeChildren = '';
            children.hidden = true;
            item.appendChild(children);
        }

        return item;
    }

    function fillTreeChildren(item, subfolders, rootKey) {
        if (!item) return;
        const container = item.querySelector(':scope > .music-tree-children');
        if (!container) return;
        container.innerHTML = '';
        const list = document.createElement('ul');
        (subfolders || []).forEach(function (folder) {
            list.appendChild(createTreeItem(folder, rootKey));
        });
        container.appendChild(list);
        item.dataset.loaded = '1';
    }

    async function loadTreeChildren(item) {
        if (!item || item.dataset.loaded === '1' || item.dataset.loaded === 'loading') return;
        item.dataset.loaded = 'loading';
        const rootKey = item.dataset.root || currentRoot;
        try {
            const data = await requestJson(folderUrl(rootKey, item.dataset.path || ''));
            fillTreeChildren(item, data.subfolders || [], rootKey);
        } catch (error) {
            item.dataset.loaded = '0';
            throw error;
        }
    }

    function setActiveTree(rootKey, path) {
        if (!treeElement) return;
        treeElement.querySelectorAll('.music-tree-item').forEach(function (item) {
            item.classList.toggle('is-active', item.dataset.root === rootKey && item.dataset.path === path);
        });
    }

    function updateTreeNodeAudit(rootKey, path, audit) {
        const item = findTreeNode(rootKey, path);
        const row = item ? item.querySelector(':scope > .music-tree-row') : null;
        if (!row) return;
        const flagged = audit && audit.counts ? (audit.counts.flagged || 0) : 0;
        let badge = row.querySelector('.music-tree-issue');
        if (flagged > 0) {
            if (!badge) {
                badge = document.createElement('span');
                badge.className = 'music-tree-issue';
                const count = row.querySelector('.music-tree-count');
                row.insertBefore(badge, count);
            }
            badge.textContent = flagged;
            badge.title = flagged + ' flagged track(s)';
        } else if (badge) {
            badge.remove();
        }
    }

    function initTree() {
        treeElement.innerHTML = '';
        rootNodes = {};
        libraryRoots.forEach(function (root) {
            const item = createTreeItem({
                label: root.label,
                path: '',
                has_children: true,
                track_count: 0
            }, root.key);
            rootNodes[root.key] = item;
            treeElement.appendChild(item);
        });
    }

    function renderBreadcrumb(items) {
        const container = document.getElementById('folder-breadcrumb');
        container.innerHTML = '';
        (items || []).forEach(function (item, index) {
            if (index > 0) {
                const separator = document.createElement('span');
                separator.className = 'sep';
                separator.textContent = '/';
                container.appendChild(separator);
            }
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = item.label;
            button.addEventListener('click', function () {
                const rootKey = item.root || currentRoot;
                selectFolder(rootKey, item.path || '', findTreeNode(rootKey, item.path || ''));
            });
            container.appendChild(button);
        });
    }

    function renderSummary(data) {
        const folder = data.folder || {};
        const breadcrumb = data.breadcrumb || [];
        const rootKey = folder.root || currentRoot;
        const title = breadcrumb.length ? breadcrumb[breadcrumb.length - 1].label : rootLabel(rootKey);
        const audit = folder.audit || null;
        document.getElementById('folder-title').textContent = title;
        document.getElementById('folder-path').textContent = folder.path
            ? (folder.root_label || rootLabel(rootKey)) + '/' + folder.path
            : (folder.root_label || rootLabel(rootKey)) + ' root';
        document.getElementById('stat-folders').textContent = folder.subfolder_count || 0;
        document.getElementById('stat-tracks').textContent = folder.track_count || 0;
        document.getElementById('stat-issues').textContent = audit && audit.counts ? (audit.counts.flagged || 0) : 0;
        document.getElementById('stat-last-audit').textContent = audit ? formatDate(audit.scanned_at) : 'Never';
        document.getElementById('btn-move-library').hidden = !(rootKey === 'downloads' && (folder.path || '') === '');
    }

    function renderSubfolders(subfolders) {
        const section = document.getElementById('subfolder-section');
        const list = document.getElementById('subfolder-list');
        list.innerHTML = '';
        if (!subfolders || !subfolders.length) {
            section.hidden = true;
            return;
        }

        section.hidden = false;
        subfolders.forEach(function (folder) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'music-subfolder';
            const flagged = folder.audit && folder.audit.counts ? (folder.audit.counts.flagged || 0) : 0;
            button.innerHTML =
                '<span class="music-subfolder-icon">' +
                    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7h6l2 2h10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/></svg>' +
                '</span>' +
                '<span class="music-subfolder-main">' +
                    '<span class="music-subfolder-title">' + escapeHtml(folder.label) + '</span>' +
                    '<span class="music-subfolder-meta">' + escapeHtml(folder.track_count || 0) + ' track' + (folder.track_count === 1 ? '' : 's') +
                        (flagged ? ' · ' + escapeHtml(flagged) + ' flagged' : '') + '</span>' +
                '</span>';
            button.addEventListener('click', function () {
                const rootKey = folder.root || currentRoot;
                selectFolder(rootKey, folder.path || '', findTreeNode(rootKey, folder.path || ''));
            });
            list.appendChild(button);
        });
    }

    function auditMessages(audit) {
        if (!audit || !Array.isArray(audit.issues)) return '';
        return audit.issues.map(function (issue) { return issue.message || issue.type || ''; }).filter(Boolean).join(' · ');
    }

    function trackStatus(file) {
        if (file.audit && (file.audit.severity === 'error' || file.audit.severity === 'warning')) {
            return 'issue';
        }
        if (!file.has_lyrics) return 'missing';
        return 'clean';
    }

    function lyricsMarkup(file) {
        if (!file.has_lyrics) {
            return '<span class="music-lyrics music-lyrics--missing"><span class="music-dot music-dot--muted"></span>Missing</span>';
        }
        if (file.audit && file.audit.severity === 'error') {
            return '<span class="music-lyrics music-lyrics--danger"><span class="music-dot music-dot--danger"></span>Broken</span>';
        }
        if (file.audit && file.audit.severity === 'warning') {
            return '<span class="music-lyrics music-lyrics--warn"><span class="music-dot music-dot--warn"></span>Check</span>';
        }
        if (file.lyrics_synced) {
            return '<span class="music-lyrics music-lyrics--ok"><span class="music-dot music-dot--ok"></span>Synced</span>';
        }
        return '<span class="music-lyrics music-lyrics--warn"><span class="music-dot music-dot--warn"></span>Unsynced</span>';
    }

    function issueChip(file) {
        if (!file.audit || !file.audit.issues || !file.audit.issues.length) return '';
        const types = file.audit.issues
            .filter(function (issue) { return issue.type !== 'missing'; })
            .map(function (issue) { return issueLabels[issue.type] || issue.type; })
            .filter(function (value, index, list) { return value && list.indexOf(value) === index; });
        if (!types.length) return '';
        const severity = file.audit.severity === 'error' ? 'error' : 'warning';
        return '<span class="music-issue-chip music-issue-chip--' + severity + '" title="' + escapeHtml(auditMessages(file.audit)) + '">' +
            escapeHtml(types.slice(0, 2).join(' · ')) + '</span>';
    }

    function renderTracks(files) {
        selectedPaths.clear();
        trackBody.innerHTML = '';
        if (!files || !files.length) {
            trackBody.innerHTML = '<tr><td colspan="9" class="music-empty">No audio files in this folder.</td></tr>';
            updateFilterCounts([]);
            updateSelection();
            return;
        }

        files.forEach(function (file) {
            const status = trackStatus(file);
            const row = document.createElement('tr');
            row.className = 'music-track-row';
            row.dataset.root = file.root || currentRoot;
            row.dataset.path = file.path;
            row.dataset.absolutePath = file.absolute_path || '';
            row.dataset.status = status;
            row.dataset.lyrics = file.has_lyrics ? (file.lyrics_synced ? 'synced' : 'unsynced') : 'missing';
            row.dataset.search = [file.title, file.artist, file.album, file.genre, file.name].join(' ').toLowerCase();
            row.innerHTML =
                '<td><input type="checkbox" class="music-track-check" value="' + escapeHtml(file.path) + '" aria-label="Select ' + escapeHtml(file.title || file.name) + '"></td>' +
                '<td>' +
                    '<div class="music-track-name">' + escapeHtml(file.title || file.name) + issueChip(file) + '</div>' +
                    '<div class="music-track-sub">' + escapeHtml(file.artist || 'Unknown artist') + (file.year ? ' · ' + escapeHtml(file.year) : '') + '</div>' +
                    '<div class="music-track-path">' + escapeHtml(file.path) + '</div>' +
                '</td>' +
                '<td class="music-hide-md">' + escapeHtml(file.album || '—') + '</td>' +
                '<td class="music-hide-md">' + escapeHtml(file.genre || '—') + '</td>' +
                '<td class="music-hide-sm"><span class="badge">' + escapeHtml(file.format || '—') + '</span></td>' +
                '<td>' + lyricsMarkup(file) + '</td>' +
                '<td class="music-hide-md">' + escapeHtml(formatSize(file.size)) + '</td>' +
                '<td class="music-hide-md">' + escapeHtml(formatDate(file.mtime)) + '</td>' +
                '<td><div class="music-row-actions">' +
                    '<button class="btn btn-ghost btn-sm" type="button" data-play-track="' + escapeHtml(file.path) + '" title="Play">▶</button>' +
                    '<button class="btn btn-ghost btn-sm" type="button" data-edit-track="' + escapeHtml(file.path) + '">Edit</button>' +
                '</div></td>';
            trackBody.appendChild(row);
        });

        updateFilterCounts(files);
        applyFilters();
        highlightPlayingTrack();
        updateSelection();
    }

    function updateFilterCounts(files) {
        const counts = { all: files.length, issue: 0, unsynced: 0, missing: 0, clean: 0 };
        files.forEach(function (file) {
            const status = trackStatus(file);
            if (Object.prototype.hasOwnProperty.call(counts, status)) counts[status]++;
            if (file.has_lyrics && !file.lyrics_synced) counts.unsynced++;
        });
        document.getElementById('filter-count-all').textContent = counts.all;
        document.getElementById('filter-count-issue').textContent = counts.issue;
        document.getElementById('filter-count-unsynced').textContent = counts.unsynced;
        document.getElementById('filter-count-missing').textContent = counts.missing;
        document.getElementById('filter-count-clean').textContent = counts.clean;
    }

    function applyFilters() {
        const search = (document.getElementById('track-search').value || '').trim().toLowerCase();
        trackBody.querySelectorAll('.music-track-row').forEach(function (row) {
            const matchesFilter = activeFilter === 'all'
                || (activeFilter === 'unsynced' ? row.dataset.lyrics === 'unsynced' : row.dataset.status === activeFilter);
            const matchesSearch = search === '' || (row.dataset.search || '').indexOf(search) !== -1;
            row.hidden = !(matchesFilter && matchesSearch);
        });
    }

    function clearSelection() {
        selectedPaths.clear();
        trackBody.querySelectorAll('.music-track-check').forEach(function (checkbox) {
            checkbox.checked = false;
        });
        selectAll.checked = false;
        selectAll.indeterminate = false;
        updateSelection();
    }

    function updateSelection() {
        const count = selectedPaths.size;
        selectionCount.textContent = count;
        selectionBar.hidden = count === 0;
        document.getElementById('selection-edit').disabled = count === 0;
        document.getElementById('selection-lyrics').disabled = count === 0;
        document.getElementById('selection-genre').disabled = count === 0;
        const visibleChecks = Array.from(trackBody.querySelectorAll('.music-track-check')).filter(function (checkbox) {
            return !checkbox.closest('.music-track-row').hidden;
        });
        selectAll.checked = visibleChecks.length > 0 && visibleChecks.every(function (checkbox) { return checkbox.checked; });
        selectAll.indeterminate = visibleChecks.some(function (checkbox) { return checkbox.checked; }) && !selectAll.checked;
    }

    async function selectFolder(rootKey, path, node) {
        try {
            await loadFolder(rootKey, path, node);
        } catch (error) {
            notify('error', error.message);
        }
    }

    async function loadFolder(rootKey, path, node) {
        const data = await requestJson(folderUrl(rootKey || currentRoot, path || ''));
        currentRoot = data.folder && data.folder.root ? data.folder.root : (rootKey || currentRoot);
        currentFolder = data.folder ? data.folder.path : '';
        currentFolderData = data;
        selectedPaths.clear();
        renderBreadcrumb(data.breadcrumb || []);
        renderSummary(data);
        renderSubfolders(data.subfolders || []);
        renderTracks(data.files || []);

        const countNode = node || findTreeNode(currentRoot, currentFolder);
        const countElement = countNode ? countNode.querySelector(':scope > .music-tree-row .music-tree-count') : null;
        if (countElement) countElement.textContent = data.folder ? (data.folder.track_count || 0) : 0;
        updateTreeNodeAudit(currentRoot, currentFolder, data.folder ? data.folder.audit : null);

        if (node) {
            if (node.dataset.loaded !== '1') fillTreeChildren(node, data.subfolders || [], currentRoot);
            node.classList.add('is-open');
            const children = node.querySelector(':scope > .music-tree-children');
            if (children) children.hidden = false;
            setActiveTree(currentRoot, currentFolder);
        } else {
            const target = findTreeNode(currentRoot, currentFolder);
            if (target) {
                target.classList.add('is-open');
                const children = target.querySelector(':scope > .music-tree-children');
                if (children) children.hidden = false;
            }
            setActiveTree(currentRoot, currentFolder);
        }

        const params = new URLSearchParams(window.location.search);
        params.set('root', currentRoot);
        if (currentFolder) params.set('folder', currentFolder);
        else params.delete('folder');
        window.history.replaceState(null, '', window.location.pathname + '?' + params.toString());
    }

    function closeDialog(dialog) {
        if (dialog && typeof dialog.close === 'function') dialog.close();
    }

    function resetMetadataFields() {
        Object.values(fieldMap).forEach(function (id) {
            const input = document.getElementById(id);
            input.value = '';
            input.placeholder = editorMulti ? 'Leave unchanged' : '';
        });
        document.getElementById('meta-lyrics').value = '';
        originalLyrics = '';
        originalTags = {};
    }

    function fillMetadataForm(tags) {
        originalTags = {};
        Object.entries(fieldMap).forEach(function ([key, id]) {
            const value = tags[key] || '';
            document.getElementById(id).value = value;
            originalTags[key] = value;
        });
        originalLyrics = tags.lyrics || '';
        document.getElementById('meta-lyrics').value = originalLyrics;
    }

    async function openMetadata(paths) {
        if (!paths.length) return;
        editorPaths = paths.slice();
        editorRoot = currentRoot;
        editorMulti = paths.length > 1;
        const editorFile = ((currentFolderData && currentFolderData.files) || []).find(function (file) {
            return file.path === paths[0];
        });
        editorAbsolutePath = editorFile ? (editorFile.absolute_path || '') : '';
        resetMetadataFields();
        document.getElementById('metadata-title').textContent = editorMulti ? 'Edit ' + paths.length + ' tracks' : 'Edit metadata';
        document.getElementById('metadata-subtitle').textContent = editorMulti
            ? 'Only the fields you fill will be written to all selected tracks. Blank fields keep their current value.'
            : 'Tags are written in place. Audio files are never moved or deleted.';
        document.getElementById('metadata-mode-note').textContent = editorMulti
            ? 'Bulk edit: shared metadata only. Select a single track to edit its lyrics.'
            : '';
        const lyricsWrap = document.getElementById('metadata-lyrics-wrap');
        lyricsWrap.hidden = editorMulti;
        const fetchButton = document.getElementById('metadata-fetch-lyrics');
        const clearLyricsButton = document.getElementById('metadata-clear-lyrics');
        const aiGenreButton = document.getElementById('metadata-ai-genre');
        fetchButton.hidden = editorMulti;
        clearLyricsButton.hidden = editorMulti;
        aiGenreButton.hidden = editorMulti;
        fetchButton.disabled = false;
        clearLyricsButton.disabled = false;
        aiGenreButton.disabled = false;
        fetchButton.textContent = 'Fetch lyrics';
        const saveButton = document.getElementById('metadata-save');
        saveButton.disabled = false;
        saveButton.textContent = 'Save changes';

        openDialog(metadataDialog);

        if (editorMulti) {
            return;
        }

        saveButton.disabled = true;
        fetchButton.disabled = true;
        saveButton.textContent = 'Loading…';
        try {
            const data = await postJson(routes.tags, { root: editorRoot, path: paths[0] });
            const tags = data.tags || {};
            fillMetadataForm(tags);
            const subtitleParts = [
                tags.title || (editorFile ? editorFile.title : ''),
                tags.artist || (editorFile ? editorFile.artist : ''),
                tags.album || (editorFile ? editorFile.album : '')
            ].filter(Boolean);
            document.getElementById('metadata-subtitle').textContent = subtitleParts.length
                ? subtitleParts.join(' · ')
                : 'Tags are written in place. Audio files are never moved or deleted.';
            lyricsWrap.open = Boolean(originalLyrics);
        } catch (error) {
            closeDialog(metadataDialog);
            notify('error', error.message);
            return;
        } finally {
            saveButton.disabled = false;
            fetchButton.disabled = false;
            saveButton.textContent = 'Save changes';
        }
    }

    async function fetchMetadataLyrics() {
        if (editorMulti || editorPaths.length !== 1) return;
        const button = document.getElementById('metadata-fetch-lyrics');
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Fetching…';
        try {
            const forceUnsynced = Boolean(originalLyrics && !lyricsLookSynced(originalLyrics));
            const data = await postJson(routes.fetchLyrics, {
                root: editorRoot,
                path: editorPaths[0],
                force_unsynced: forceUnsynced
            });
            const result = data.result || {};
            const tags = await postJson(routes.tags, { root: editorRoot, path: editorPaths[0] });
            fillMetadataForm(tags.tags || {});
            document.getElementById('metadata-lyrics-wrap').open = true;
            if (data.status === 'found') {
                notify('success', 'Lyrics found'
                    + (result.type ? ' (' + result.type + ')' : '')
                    + (result.provider ? ' via ' + result.provider : '')
                    + '.');
            } else if (data.status === 'skipped') {
                notify('info', result.reason || 'Lyrics already present.');
            } else {
                notify('info', result.reason || 'No lyrics found for this track.');
            }
            await loadFolder(editorRoot, currentFolder, findTreeNode(editorRoot, currentFolder));
        } catch (error) {
            notify('error', error.message);
        } finally {
            button.disabled = false;
            button.textContent = originalText;
        }
    }

    async function saveMetadata() {
        const saveButton = document.getElementById('metadata-save');
        const tags = {};
        Object.entries(fieldMap).forEach(function ([key, id]) {
            const value = document.getElementById(id).value.trim();
            if (editorMulti) {
                if (value !== '') tags[key] = value;
            } else if (value !== (originalTags[key] || '')) {
                tags[key] = value;
            }
        });

        if (!editorMulti) {
            const lyrics = document.getElementById('meta-lyrics').value;
            if (lyrics !== originalLyrics) tags.lyrics = lyrics;
        }

        if (Object.keys(tags).length === 0) {
            notify('info', editorMulti ? 'Fill at least one field to update the selection.' : 'Nothing to update.');
            return;
        }

        saveButton.disabled = true;
        saveButton.textContent = 'Saving…';
        try {
            const data = await postJsonResult(routes.updateTags, { root: editorRoot, paths: editorPaths, tags: tags });
            const failed = Number(data.failed || 0);
            const updated = Number(data.updated || 0);
            if (failed > 0) {
                const firstError = (data.results || []).find(function (result) { return !result.success; });
                notify('error', failed + ' track(s) could not be updated.' + (firstError ? ' ' + firstError.message : ''));
            } else if (updated > 0) {
                notify('success', updated + ' track(s) updated.');
            } else {
                notify('error', data.message || 'No track was updated.');
            }
            closeDialog(metadataDialog);
            await loadFolder(editorRoot, currentFolder, findTreeNode(editorRoot, currentFolder));
        } catch (error) {
            notify('error', error.message);
        } finally {
            saveButton.disabled = false;
            saveButton.textContent = 'Save changes';
        }
    }

    async function fetchMetadataGenre() {
        if (editorMulti || !editorAbsolutePath) return;
        const button = document.getElementById('metadata-ai-genre');
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'AI…';
        try {
            const data = await postJsonResult(routes.updateGenres, { path: editorAbsolutePath });
            const result = data.result || data;
            const genre = String(result.genre || '').trim();
            if (!genre || ['unknown', 'none'].includes(genre.toLowerCase())) {
                notify('info', result.error || 'AI could not determine a genre for this track.');
                return;
            }
            const tags = await postJson(routes.tags, { root: editorRoot, path: editorPaths[0] });
            fillMetadataForm(tags.tags || {});
            await loadFolder(editorRoot, currentFolder, findTreeNode(editorRoot, currentFolder));
            notify('success', 'AI genre: ' + genre);
        } catch (error) {
            notify('error', error.message);
        } finally {
            button.disabled = false;
            button.textContent = originalText;
        }
    }

    async function clearMetadataLyrics() {
        if (editorMulti || editorPaths.length !== 1) return;
        if (!confirm('Remove lyrics from this track?')) return;
        const button = document.getElementById('metadata-clear-lyrics');
        const originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Clearing…';
        try {
            const data = await postJsonResult(routes.updateTags, {
                root: editorRoot,
                paths: [editorPaths[0]],
                tags: { lyrics: '' }
            });
            if (Number(data.failed || 0) > 0) {
                const firstError = (data.results || []).find(function (result) { return !result.success; });
                notify('error', firstError ? firstError.message : 'Could not clear lyrics.');
                return;
            }
            const tags = await postJson(routes.tags, { root: editorRoot, path: editorPaths[0] });
            fillMetadataForm(tags.tags || {});
            document.getElementById('metadata-lyrics-wrap').open = false;
            await loadFolder(editorRoot, currentFolder, findTreeNode(editorRoot, currentFolder));
            notify('success', 'Lyrics cleared.');
        } catch (error) {
            notify('error', error.message);
        } finally {
            button.disabled = false;
            button.textContent = originalText;
        }
    }

    function selectedFiles() {
        const files = (currentFolderData && currentFolderData.files) ? currentFolderData.files : [];
        return Array.from(selectedPaths)
            .map(function (path) {
                return files.find(function (file) { return file.path === path; }) || null;
            })
            .filter(Boolean);
    }

    function batchStatusInfo(status) {
        const value = String(status || '').toLowerCase();
        if (['found', 'success', 'completed', 'complete', 'moved', 'updated', 'ok'].includes(value)) {
            return { key: 'success', label: 'Success' };
        }
        if (['warning', 'not_found', 'partial'].includes(value)) {
            return { key: 'warning', label: 'Warning' };
        }
        if (['skipped', 'skip'].includes(value)) {
            return { key: 'skipped', label: 'Skipped' };
        }
        if (['canceled', 'cancelled'].includes(value)) {
            return { key: 'canceled', label: 'Canceled' };
        }
        if (value === 'running') {
            return { key: 'running', label: 'Running' };
        }
        if (value === 'pending') {
            return { key: 'pending', label: 'Pending' };
        }
        return { key: 'error', label: 'Error' };
    }

    function batchResultStatus(data) {
        if (!data) return 'error';
        if (data.status) return data.status;
        if (data.result && data.result.status) return data.result.status;
        return data.success ? 'success' : 'error';
    }

    function batchResultMessage(action, data, item) {
        if (!data) return '';
        const result = data.result || {};
        if (data.message) return data.message;
        if (action === 'lyrics') {
            if (result.status === 'found') {
                return (result.title || 'Lyrics found')
                    + (result.type ? ' (' + result.type + ')' : '')
                    + (result.provider ? ' · ' + result.provider : '');
            }
            return result.reason || '';
        }
        if (action === 'genres') {
            return result.genre || result.error || '';
        }
        if (action === 'move') {
            return result.final_path || result.error || '';
        }
        return '';
    }

    function batchActionConfig(action) {
        if (action === 'lyrics') {
            return {
                title: 'Fetch lyrics',
                subtitle: 'Missing lyrics are fetched, unsynced lyrics are retried, synced lyrics are skipped.',
                recordAction: 'lyrics',
                items: function () {
                    return selectedFiles().map(function (file) {
                        if (file.has_lyrics && file.lyrics_synced) {
                            return Object.assign({}, file, { skip: true, skipReason: 'Synced lyrics already present' });
                        }
                        return Object.assign({}, file, {
                            forceUnsynced: Boolean(file.has_lyrics && !file.lyrics_synced)
                        });
                    });
                },
                request: function (item) {
                    return postJsonResult(routes.fetchLyrics, {
                        root: item.root || currentRoot,
                        path: item.path,
                        force_unsynced: Boolean(item.forceUnsynced)
                    });
                }
            };
        }
        if (action === 'genres') {
            return {
                title: 'Fetch genre',
                subtitle: 'Runs the existing genre detection on every selected track.',
                recordAction: 'genres',
                items: function () { return selectedFiles(); },
                request: function (item) {
                    return postJsonResult(routes.updateGenres, { path: item.absolute_path || '' });
                }
            };
        }
        return {
            title: 'Move to library',
            subtitle: 'Moves every file from the Downloads root into the configured library and keeps the existing naming rules.',
            recordAction: 'library_move',
            confirm: 'Move all files from Downloads to the library?',
            items: function () {
                return ((currentFolderData && currentFolderData.files) || []).slice();
            },
            request: function (item) {
                return postJsonResult(routes.moveToLibrary, { path: item.absolute_path || '' });
            }
        };
    }

    function buildBatchRows(items) {
        const list = document.getElementById('batch-list');
        list.innerHTML = '';
        items.forEach(function (item, index) {
            const row = document.createElement('div');
            row.className = 'music-batch-row';
            row.id = 'batch-row-' + index;
            row.innerHTML =
                '<span class="music-batch-row-main">' +
                    '<span class="music-batch-row-name">' + escapeHtml(item.title || item.name || item.path) + '</span>' +
                    '<span class="music-batch-row-artist">' + escapeHtml(item.artist || 'Unknown artist') + '</span>' +
                '</span>' +
                '<span class="music-batch-row-status is-pending">Pending</span>' +
                '<span class="music-batch-row-message"></span>';
            list.appendChild(row);
        });
    }

    function setBatchRow(index, status, message) {
        const row = document.getElementById('batch-row-' + index);
        if (!row) return;
        const info = batchStatusInfo(status);
        const statusEl = row.querySelector('.music-batch-row-status');
        statusEl.textContent = info.label;
        statusEl.className = 'music-batch-row-status is-' + info.key;
        row.querySelector('.music-batch-row-message').textContent = message || '';
    }

    function updateBatchProgress(total, completed) {
        const percent = total > 0 ? Math.round((completed / total) * 100) : 0;
        document.getElementById('batch-counter').textContent = completed + ' / ' + total;
        document.getElementById('batch-progress-bar').style.width = percent + '%';
    }

    async function recordBatch(recordAction, results) {
        try {
            await fetch(routes.batchRecord, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: recordAction, results: results })
            });
        } catch (error) {
            console.warn('Could not record batch results', error);
        }
    }

    function showBatchSummary(action, results) {
        const counts = { success: 0, warning: 0, error: 0, skipped: 0, canceled: 0 };
        results.forEach(function (result) {
            const info = batchStatusInfo(result.status);
            if (Object.prototype.hasOwnProperty.call(counts, info.key)) counts[info.key]++;
        });
        const summary = document.getElementById('batch-summary');
        summary.innerHTML =
            '<strong>' + escapeHtml(batchActionConfig(action).title) + ' complete</strong><br>' +
            'Success: ' + counts.success + ' · Warning: ' + counts.warning +
            ' · Error: ' + counts.error + ' · Skipped: ' + counts.skipped +
            ' · Canceled: ' + counts.canceled;
        summary.hidden = false;
        const type = counts.error > 0 ? 'error' : (counts.warning > 0 ? 'info' : 'success');
        notify(type, batchActionConfig(action).title + ': ' + counts.success + ' success, ' + counts.error + ' error.');
    }

    async function runBatch(action) {
        if (batchState && batchState.running) return;
        const config = batchActionConfig(action);
        if (config.confirm && !confirm(config.confirm)) return;
        const items = config.items();
        if (!items.length) {
            notify('info', action === 'move' ? 'No files to move.' : 'No track selected.');
            return;
        }

        batchState = { running: true, cancelRequested: false, action: action, items: items, results: [] };
        document.getElementById('batch-title').textContent = config.title;
        document.getElementById('batch-subtitle').textContent = config.subtitle;
        document.getElementById('batch-current').textContent = 'Preparing…';
        document.getElementById('batch-summary').hidden = true;
        document.getElementById('batch-summary').innerHTML = '';
        document.getElementById('batch-cancel').hidden = false;
        document.getElementById('batch-cancel').disabled = false;
        document.getElementById('batch-cancel').textContent = 'Cancel';
        document.getElementById('batch-close').hidden = true;
        document.getElementById('batch-close-x').hidden = true;
        buildBatchRows(items);
        updateBatchProgress(items.length, 0);
        openDialog(batchDialog);

        const results = [];
        let completed = 0;
        for (let index = 0; index < items.length; index++) {
            const item = items[index];
            if (item.skip) {
                setBatchRow(index, 'skipped', item.skipReason || 'Skipped');
                results.push({ status: 'skipped', file: item.name || item.path, reason: item.skipReason || 'Skipped' });
                completed++;
                updateBatchProgress(items.length, completed);
                continue;
            }

            if (batchState.cancelRequested) {
                setBatchRow(index, 'canceled', 'Canceled by user');
                results.push({ status: 'canceled', file: item.name || item.path, reason: 'Canceled by user' });
                completed++;
                updateBatchProgress(items.length, completed);
                continue;
            }

            setBatchRow(index, 'running', '');
            document.getElementById('batch-current').textContent = item.title || item.name || item.path;
            try {
                const data = await config.request(item);
                const status = batchResultStatus(data);
                const message = batchResultMessage(action, data, item);
                setBatchRow(index, status, message);
                results.push({ status: status, file: item.name || item.path, message: message });
            } catch (error) {
                setBatchRow(index, 'error', error.message);
                results.push({ status: 'error', file: item.name || item.path, reason: error.message });
            }
            completed++;
            updateBatchProgress(items.length, completed);
        }

        batchState.results = results;
        batchState.running = false;
        document.getElementById('batch-current').textContent = 'Done';
        document.getElementById('batch-cancel').hidden = true;
        document.getElementById('batch-close').hidden = false;
        document.getElementById('batch-close-x').hidden = false;
        showBatchSummary(action, results);
        await recordBatch(config.recordAction, results);
        clearSelection();

        try {
            if (action === 'move') {
                await loadFolder('downloads', '', findTreeNode('downloads', ''));
                const libraryNode = rootNodes['library'];
                if (libraryNode && libraryNode.dataset.loaded === '1') {
                    libraryNode.dataset.loaded = '0';
                    await loadTreeChildren(libraryNode);
                }
            } else {
                await loadFolder(currentRoot, currentFolder, findTreeNode(currentRoot, currentFolder));
            }
        } catch (error) {
            notify('error', error.message);
        }
    }

    function renderReport(data) {
        const counts = data.counts || {};
        const files = Array.isArray(data.files) ? data.files : [];
        const flagged = files.filter(function (file) { return file.severity === 'error' || file.severity === 'warning'; });
        const byType = counts.by_type || {};

        const reportRoot = data.root_label || rootLabel(data.root || currentRoot);
        document.getElementById('report-subtitle').textContent =
            (data.scope ? reportRoot + '/' + data.scope : reportRoot + ' root') +
            (data.recursive ? ' · include subfolders' : ' · this folder only') +
            ' · ' + new Date().toLocaleString();

        const stats = [
            ['Scanned', counts.tracks || 0],
            ['Clean', counts.ok || 0],
            ['Warnings', counts.warning || 0],
            ['Errors', counts.error || 0],
            ['Missing lyrics', counts.missing || 0]
        ];
        document.getElementById('report-stats').innerHTML = stats.map(function (entry) {
            return '<div class="music-report-stat"><span>' + escapeHtml(entry[0]) + '</span><strong>' + escapeHtml(entry[1]) + '</strong></div>';
        }).join('');

        const typeTone = {};
        files.forEach(function (file) {
            (file.issues || []).forEach(function (issue) {
                if (!issue || !issue.type) return;
                if (typeTone[issue.type] !== 'error') {
                    typeTone[issue.type] = issue.severity === 'error' ? 'error' : 'warning';
                }
            });
        });
        const typeEntries = Object.entries(byType).filter(function (entry) { return entry[1] > 0; });
        document.getElementById('report-types').innerHTML = typeEntries.length
            ? typeEntries.map(function (entry) {
                const tone = typeTone[entry[0]] === 'error' ? 'error' : 'warning';
                return '<span class="music-issue-chip music-issue-chip--' + tone + '">' + escapeHtml(issueLabels[entry[0]] || entry[0]) + ' · ' + escapeHtml(entry[1]) + '</span>';
            }).join('')
            : '<span class="music-hint">No issue type detected.</span>';

        const body = document.getElementById('report-body');
        const empty = document.getElementById('report-empty');
        body.innerHTML = '';
        if (!flagged.length) {
            empty.hidden = false;
        } else {
            empty.hidden = true;
            flagged.forEach(function (file) {
                const issues = Array.isArray(file.issues) ? file.issues : [];
                const types = issues.map(function (issue) {
                    return issueLabels[issue.type] || issue.type;
                }).filter(function (value, index, list) { return value && list.indexOf(value) === index; });
                const excerpt = issues.find(function (issue) { return issue.excerpt; });
                const severity = file.severity === 'error' ? 'danger' : 'warn';
                const row = document.createElement('tr');
                row.innerHTML =
                    '<td>' +
                        '<div class="music-track-name">' + escapeHtml(file.title || file.filename) + '</div>' +
                        '<div class="music-track-sub">' + escapeHtml(file.artist || 'Unknown artist') + (file.album ? ' · ' + escapeHtml(file.album) : '') + '</div>' +
                        '<div class="music-track-path">' + escapeHtml(file.path) + '</div>' +
                    '</td>' +
                    '<td><div class="music-report-types">' + types.map(function (type) {
                        return '<span class="music-issue-chip music-issue-chip--' + (file.severity === 'error' ? 'error' : 'warning') + '">' + escapeHtml(type) + '</span>';
                    }).join('') + '</div></td>' +
                    '<td><span class="music-report-excerpt">' + escapeHtml(excerpt ? excerpt.excerpt : (issues[0] ? issues[0].message : '—')) + '</span></td>' +
                    '<td><span class="music-lyrics music-lyrics--' + severity + '"><span class="music-dot music-dot--' + severity + '"></span>' + (file.severity === 'error' ? 'Error' : 'Warning') + '</span></td>';
                body.appendChild(row);
            });
        }

        openDialog(reportDialog);
    }

    async function runAudit() {
        const scope = document.querySelector('input[name="scan-scope"]:checked');
        const recursive = scope ? scope.value === 'recursive' : false;
        const status = document.getElementById('scan-status');
        const button = document.getElementById('scan-start');
        status.textContent = 'Scanning ' + (currentFolder ? rootLabel(currentRoot) + '/' + currentFolder : rootLabel(currentRoot) + ' root') + '…';
        button.disabled = true;
        button.textContent = 'Scanning…';
        try {
            const data = await postJson(routes.audit, { root: currentRoot, path: currentFolder, recursive: recursive });
            closeDialog(scanDialog);
            renderReport(data);
            await loadFolder(currentRoot, currentFolder, findTreeNode(currentRoot, currentFolder));
        } catch (error) {
            status.textContent = error.message;
            notify('error', error.message);
        } finally {
            button.disabled = false;
            button.textContent = 'Start audit';
        }
    }

    document.getElementById('btn-audit-lyrics').addEventListener('click', function () {
        document.getElementById('scan-subtitle').textContent =
            'Audit ' + (currentFolder ? rootLabel(currentRoot) + '/' + currentFolder : rootLabel(currentRoot) + ' root') + ' for broken lyrics. This is read-only.';
        document.getElementById('scan-status').textContent = '';
        openDialog(scanDialog);
    });

    document.getElementById('scan-start').addEventListener('click', runAudit);
    document.getElementById('btn-play-folder').addEventListener('click', playFolder);
    document.getElementById('player-previous').addEventListener('click', playPreviousPlayerTrack);
    document.getElementById('player-toggle').addEventListener('click', togglePlayerPlayback);
    document.getElementById('player-next').addEventListener('click', playNextPlayerTrack);
    document.getElementById('player-close').addEventListener('click', closePlayer);
    document.getElementById('player-seek').addEventListener('input', function (event) { seekPlayer(event.target.value); });
    document.getElementById('player-volume').addEventListener('input', function (event) { libraryAudio.volume = Number(event.target.value); });

    libraryAudio.addEventListener('loadedmetadata', function () {
        document.getElementById('player-duration').textContent = formatPlayerTime(libraryAudio.duration);
    });
    libraryAudio.addEventListener('timeupdate', function () {
        document.getElementById('player-current').textContent = formatPlayerTime(libraryAudio.currentTime);
        if (Number.isFinite(libraryAudio.duration) && libraryAudio.duration > 0) {
            document.getElementById('player-seek').value = (libraryAudio.currentTime / libraryAudio.duration) * 100;
        }
    });
    libraryAudio.addEventListener('play', updatePlayerButton);
    libraryAudio.addEventListener('pause', updatePlayerButton);
    libraryAudio.addEventListener('ended', playNextPlayerTrack);
    libraryAudio.addEventListener('error', function () {
        const track = playerTrack();
        notify('error', 'Playback failed' + (track ? ' for ' + (track.title || track.name) : '') + '.');
    });

    document.getElementById('library-refresh').addEventListener('click', function () {
        loadFolder(currentRoot, currentFolder, findTreeNode(currentRoot, currentFolder)).catch(function (error) {
            notify('error', error.message);
        });
    });

    document.getElementById('track-filters').addEventListener('click', function (event) {
        const button = event.target.closest('[data-track-filter]');
        if (!button) return;
        activeFilter = button.dataset.trackFilter;
        document.querySelectorAll('#track-filters [data-track-filter]').forEach(function (chip) {
            chip.classList.toggle('is-active', chip === button);
        });
        applyFilters();
        updateSelection();
    });

    document.getElementById('track-search').addEventListener('input', function () {
        applyFilters();
        updateSelection();
    });

    document.getElementById('select-all').addEventListener('change', function (event) {
        const checked = event.target.checked;
        trackBody.querySelectorAll('.music-track-row').forEach(function (row) {
            if (row.hidden) return;
            const checkbox = row.querySelector('.music-track-check');
            if (!checkbox) return;
            checkbox.checked = checked;
            if (checked) selectedPaths.add(checkbox.value);
            else selectedPaths.delete(checkbox.value);
        });
        updateSelection();
    });

    trackBody.addEventListener('change', function (event) {
        const checkbox = event.target.closest('.music-track-check');
        if (!checkbox) return;
        if (checkbox.checked) selectedPaths.add(checkbox.value);
        else selectedPaths.delete(checkbox.value);
        updateSelection();
    });

    trackBody.addEventListener('click', function (event) {
        const playButton = event.target.closest('[data-play-track]');
        if (playButton) {
            playTrack(playButton.dataset.playTrack);
            return;
        }
        const editButton = event.target.closest('[data-edit-track]');
        if (editButton) {
            openMetadata([editButton.dataset.editTrack]);
        }
    });

    document.getElementById('selection-clear').addEventListener('click', clearSelection);

    document.getElementById('selection-edit').addEventListener('click', function () {
        openMetadata(Array.from(selectedPaths));
    });

    document.getElementById('metadata-save').addEventListener('click', saveMetadata);
    document.getElementById('metadata-fetch-lyrics').addEventListener('click', fetchMetadataLyrics);
    document.getElementById('metadata-ai-genre').addEventListener('click', fetchMetadataGenre);
    document.getElementById('metadata-clear-lyrics').addEventListener('click', clearMetadataLyrics);
    document.getElementById('selection-lyrics').addEventListener('click', function () { runBatch('lyrics'); });
    document.getElementById('selection-genre').addEventListener('click', function () { runBatch('genres'); });
    document.getElementById('btn-move-library').addEventListener('click', function () { runBatch('move'); });
    document.getElementById('batch-cancel').addEventListener('click', function () {
        if (!batchState || !batchState.running) return;
        batchState.cancelRequested = true;
        const button = document.getElementById('batch-cancel');
        button.disabled = true;
        button.textContent = 'Stopping after current…';
    });
    document.getElementById('batch-close-x').addEventListener('click', function () {
        if (!batchState || !batchState.running) closeDialog(batchDialog);
    });

    treeElement.addEventListener('click', async function (event) {
        const toggle = event.target.closest('[data-tree-toggle]');
        const label = event.target.closest('[data-folder-select]');
        const item = (toggle || label) ? (toggle || label).closest('.music-tree-item') : null;
        if (!item) return;

        if (toggle) {
            const isOpen = item.classList.contains('is-open');
            if (isOpen) {
                item.classList.remove('is-open');
                const children = item.querySelector(':scope > .music-tree-children');
                if (children) children.hidden = true;
                return;
            }
            try {
                await loadTreeChildren(item);
                item.classList.add('is-open');
                const children = item.querySelector(':scope > .music-tree-children');
                if (children) children.hidden = false;
            } catch (error) {
                notify('error', error.message);
            }
            return;
        }

        if (label) {
            await selectFolder(item.dataset.root || currentRoot, item.dataset.path || '', item);
        }
    });

    document.getElementById('folder-filter').addEventListener('input', function (event) {
        const value = event.target.value.trim().toLowerCase();
        treeElement.querySelectorAll('.music-tree-item').forEach(function (item) {
            const label = item.querySelector(':scope > .music-tree-row .music-tree-label');
            const text = label ? label.textContent.toLowerCase() : '';
            item.classList.toggle('music-hidden', value !== '' && text.indexOf(value) === -1);
        });
    });

    document.querySelectorAll('[data-close-dialog]').forEach(function (button) {
        button.addEventListener('click', function () {
            closeDialog(document.getElementById(button.dataset.closeDialog));
        });
    });

    [metadataDialog, scanDialog, reportDialog, batchDialog].forEach(function (dialog) {
        dialog.addEventListener('click', function (event) {
            if (event.target !== dialog) return;
            if (dialog === batchDialog && batchState && batchState.running) return;
            dialog.close();
        });
    });
    batchDialog.addEventListener('cancel', function (event) {
        if (batchState && batchState.running) event.preventDefault();
    });

    window.addEventListener('resize', updateStickyOffsets);
    updateStickyOffsets();

    initTree();
    const initialParams = new URLSearchParams(window.location.search);
    const requestedRoot = initialParams.get('root') || '';
    const initialRoot = rootNodes[requestedRoot] ? requestedRoot : defaultRoot;
    const initialFolder = initialParams.get('folder') || '';
    loadFolder(initialRoot, '', rootNodes[initialRoot]).then(function () {
        if (initialFolder !== '') {
            return selectFolder(initialRoot, initialFolder, findTreeNode(initialRoot, initialFolder));
        }
        return null;
    }).catch(function (error) {
        notify('error', error.message);
        trackBody.innerHTML = '<tr><td colspan="9" class="music-empty">' + escapeHtml(error.message) + '</td></tr>';
    });
})();
</script>
{% endblock %}
