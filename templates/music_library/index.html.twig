{% extends 'base.html.twig' %}

{% block title %}Music Library - Downloader{% endblock %}

{% block body %}
{% embed '_partials/page_header.html.twig' with {
    title: 'Music Library',
    subtitle: 'Browse the library folder by folder, edit tags in place, and audit lyrics quality. Audio files are never moved or deleted.',
    icon: 'music',
    badge: 'Tags only · no delete',
    badge_class: 'header-badge--neutral'
} %}
    {% block actions %}
        <button class="btn btn-secondary" type="button" id="library-refresh">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/></svg>
            Refresh
        </button>
    {% endblock %}
{% endembed %}

<div class="music-library-layout">
    <aside class="card music-folder-panel">
        <div class="music-folder-head">
            <div>
                <h2 class="music-panel-title">Folders</h2>
                <p class="music-panel-subtitle">Folder mode, like the media library.</p>
            </div>
        </div>
        <div class="music-folder-search">
            <input class="music-input" type="search" id="folder-filter" placeholder="Filter folders…" aria-label="Filter folders">
        </div>
        <div class="music-tree" id="folder-tree">
            <div class="music-loading">Loading folders…</div>
        </div>
        <div class="music-folder-foot">Folder actions apply to the selected folder. Lyrics scans are read-only and run on demand.</div>
    </aside>

    <div class="music-library-main">
        <div class="music-player" id="library-player" hidden>
            <div class="music-player-controls">
                <button class="btn btn-secondary btn-sm music-player-btn" type="button" id="player-previous" title="Previous" aria-label="Previous">⏮</button>
                <button class="btn btn-primary btn-sm music-player-btn" type="button" id="player-toggle" title="Play / Pause" aria-label="Play or pause">▶</button>
                <button class="btn btn-secondary btn-sm music-player-btn" type="button" id="player-next" title="Next" aria-label="Next">⏭</button>
            </div>
            <div class="music-player-main">
                <div class="music-player-title" id="player-title">No track selected</div>
                <div class="music-player-sub" id="player-subtitle"></div>
                <input class="music-player-seek" type="range" id="player-seek" min="0" max="100" step="0.1" value="0" aria-label="Seek">
                <div class="music-player-time">
                    <span id="player-current">0:00</span>
                    <span id="player-duration">0:00</span>
                </div>
            </div>
            <input class="music-player-volume" type="range" id="player-volume" min="0" max="1" step="0.01" value="1" title="Volume" aria-label="Volume">
            <button class="btn btn-ghost btn-sm music-player-btn" type="button" id="player-close" title="Close player" aria-label="Close player">×</button>
            <audio id="library-audio" preload="metadata"></audio>
        </div>

        <section class="card music-folder-summary">
            <div class="music-breadcrumb" id="folder-breadcrumb"></div>
            <div class="music-folder-title-row">
                <div class="music-folder-heading">
                    <h2 id="folder-title">Music</h2>
                    <div class="music-folder-path" id="folder-path">Library root</div>
                </div>
                <div class="music-folder-actions">
                    <button class="btn btn-secondary" type="button" id="btn-play-folder">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        Play folder
                    </button>
                    <button class="btn btn-warning" type="button" id="btn-move-library" hidden>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7h18v12H3z"/><path d="M12 3v10"/><path d="m8 9 4 4 4-4"/></svg>
                        Move to library
                    </button>
                    <button class="btn btn-primary" type="button" id="btn-audit-lyrics">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16v13H7l-3 3z"/><path d="M8 9h8M8 13h5"/></svg>
                        Scan lyrics here
                    </button>
                </div>
            </div>
        </section>

        <section class="music-stat-grid">
            <article class="music-stat">
                <span class="music-stat-label">Folders</span>
                <strong id="stat-folders">—</strong>
                <span class="music-stat-meta">in this folder</span>
            </article>
            <article class="music-stat">
                <span class="music-stat-label">Tracks</span>
                <strong id="stat-tracks">—</strong>
                <span class="music-stat-meta">directly in this folder</span>
            </article>
            <article class="music-stat">
                <span class="music-stat-label">Lyrics issues</span>
                <strong id="stat-issues">—</strong>
                <span class="music-stat-meta">from the last scan</span>
            </article>
            <article class="music-stat">
                <span class="music-stat-label">Last audit</span>
                <strong id="stat-last-audit" class="music-stat-date">Never</strong>
                <span class="music-stat-meta">for this folder</span>
            </article>
        </section>

        <section class="card music-tracks-card">
            <div id="subfolder-section" class="music-subfolder-section" hidden>
                <div class="music-section-head">
                    <h3>Subfolders</h3>
                </div>
                <div class="music-subfolders" id="subfolder-list"></div>
            </div>

            <div class="music-toolbar">
                <div class="music-chips" id="track-filters">
                    <button class="music-chip is-active" type="button" data-track-filter="all">All <span id="filter-count-all">0</span></button>
                    <button class="music-chip" type="button" data-track-filter="issue">Issues <span id="filter-count-issue">0</span></button>
                    <button class="music-chip" type="button" data-track-filter="unsynced">Unsynced <span id="filter-count-unsynced">0</span></button>
                    <button class="music-chip" type="button" data-track-filter="missing">Missing lyrics <span id="filter-count-missing">0</span></button>
                    <button class="music-chip" type="button" data-track-filter="clean">Clean <span id="filter-count-clean">0</span></button>
                </div>
                <input class="music-input music-track-search" type="search" id="track-search" placeholder="Search title, artist, album…" aria-label="Search tracks">
            </div>

            <div class="music-selection-bar" id="selection-bar" hidden>
                <span><strong id="selection-count">0</strong> tracks selected · changes are written to tags only</span>
                <div class="music-selection-actions">
                    <button class="btn btn-primary btn-sm" type="button" id="selection-edit">Edit selected</button>
                    <button class="btn btn-secondary btn-sm" type="button" id="selection-lyrics">Fetch lyrics</button>
                    <button class="btn btn-secondary btn-sm" type="button" id="selection-genre">Fetch genre</button>
                    <button class="btn btn-secondary btn-sm" type="button" id="selection-clear">Clear selection</button>
                </div>
            </div>

            <div class="music-table-wrap">
                <table class="music-table">
                    <thead>
                        <tr>
                            <th class="music-check-col"><input type="checkbox" id="select-all" aria-label="Select all tracks"></th>
                            <th>Title / Artist</th>
                            <th class="music-hide-md">Album</th>
                            <th class="music-hide-md">Genre</th>
                            <th class="music-hide-sm">Format</th>
                            <th>Lyrics</th>
                            <th class="music-hide-md">Size</th>
                            <th class="music-hide-md">Modified</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="track-body">
                        <tr><td colspan="9" class="music-empty">Loading tracks…</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="music-legend">
                <span><span class="music-dot music-dot--ok"></span> Lyrics present</span>
                <span><span class="music-dot music-dot--warn"></span> Warning (repetition, length, junk)</span>
                <span><span class="music-dot music-dot--danger"></span> Error (encoding, timestamps)</span>
                <span><span class="music-dot music-dot--muted"></span> No lyrics</span>
            </div>
        </section>
    </div>
</div>

<dialog class="music-dialog" id="metadata-dialog">
    <div class="music-dialog-header">
        <div>
            <h2 id="metadata-title">Edit metadata</h2>
            <p class="music-dialog-subtitle" id="metadata-subtitle"></p>
        </div>
        <button class="music-dialog-close" type="button" data-close-dialog="metadata-dialog" aria-label="Close">×</button>
    </div>
    <div class="music-dialog-body">
        <div class="music-field-grid">
            <label class="music-field">Title<input class="music-input" type="text" id="meta-title" autocomplete="off"></label>
            <label class="music-field">Artist<input class="music-input" type="text" id="meta-artist" autocomplete="off"></label>
            <label class="music-field">Album<input class="music-input" type="text" id="meta-album" autocomplete="off"></label>
            <label class="music-field">Album artist<input class="music-input" type="text" id="meta-albumartist" autocomplete="off"></label>
            <label class="music-field">Year<input class="music-input" type="text" id="meta-year" autocomplete="off"></label>
            <div class="music-field">
                <label for="meta-genre">Genre</label>
                <span class="music-input-group">
                    <input class="music-input" type="text" id="meta-genre" autocomplete="off">
                    <button class="btn btn-secondary btn-sm" type="button" id="metadata-ai-genre" title="Fetch genre with AI">AI</button>
                </span>
            </div>
            <label class="music-field">Track #<input class="music-input" type="text" id="meta-tracknumber" autocomplete="off"></label>
            <label class="music-field">Disc #<input class="music-input" type="text" id="meta-discnumber" autocomplete="off"></label>
            <label class="music-field music-span-2">Comment<input class="music-input" type="text" id="meta-comment" autocomplete="off"></label>
        </div>
        <details class="music-lyrics-editor" id="metadata-lyrics-wrap">
            <summary>Lyrics tag</summary>
            <textarea class="music-textarea" id="meta-lyrics" rows="10" spellcheck="false"></textarea>
            <p class="music-hint">Editing here rewrites the embedded lyrics tag only. Leave the value untouched to keep the current lyrics. Files are never deleted.</p>
        </details>
        <p class="music-hint" id="metadata-mode-note"></p>
    </div>
    <div class="music-dialog-footer">
        <button class="btn btn-secondary" type="button" id="metadata-fetch-lyrics">Fetch lyrics</button>
        <button class="btn btn-secondary" type="button" id="metadata-clear-lyrics">Clear lyrics</button>
        <button class="btn btn-secondary" type="button" data-close-dialog="metadata-dialog">Cancel</button>
        <button class="btn btn-primary" type="button" id="metadata-save">Save changes</button>
    </div>
</dialog>

<dialog class="music-dialog" id="scan-dialog">
    <div class="music-dialog-header">
        <div>
            <h2>Scan lyrics</h2>
            <p class="music-dialog-subtitle" id="scan-subtitle">Audit the selected folder for broken lyrics. This is read-only.</p>
        </div>
        <button class="music-dialog-close" type="button" data-close-dialog="scan-dialog" aria-label="Close">×</button>
    </div>
    <div class="music-dialog-body">
        <fieldset class="music-fieldset">
            <legend>Scope</legend>
            <label class="music-radio"><input type="radio" name="scan-scope" value="folder" checked> This folder only</label>
            <label class="music-radio"><input type="radio" name="scan-scope" value="recursive"> Include subfolders</label>
        </fieldset>
        <div class="music-scan-checks">
            <span>Encoding / mojibake</span>
            <span>Timestamp integrity</span>
            <span>Junk / boilerplate</span>
            <span>Repetition / low content</span>
            <span>Abnormal length</span>
        </div>
        <p class="music-hint">The scan only reads tags. No lyrics or audio files are modified. The report lists every flagged track with an excerpt.</p>
        <p class="music-scan-status" id="scan-status"></p>
    </div>
    <div class="music-dialog-footer">
        <button class="btn btn-secondary" type="button" data-close-dialog="scan-dialog">Cancel</button>
        <button class="btn btn-primary" type="button" id="scan-start">Start audit</button>
    </div>
</dialog>

<dialog class="music-dialog" id="batch-dialog">
    <div class="music-dialog-header">
        <div>
            <h2 id="batch-title">Batch action</h2>
            <p class="music-dialog-subtitle" id="batch-subtitle"></p>
        </div>
        <button class="music-dialog-close" type="button" id="batch-close-x" aria-label="Close" hidden>×</button>
    </div>
    <div class="music-dialog-body">
        <div class="music-batch-head">
            <span id="batch-current">Preparing…</span>
            <span id="batch-counter">0 / 0</span>
        </div>
        <div class="music-progress-track"><div class="music-progress-bar" id="batch-progress-bar"></div></div>
        <div class="music-batch-summary" id="batch-summary" hidden></div>
        <div class="music-batch-list" id="batch-list"></div>
    </div>
    <div class="music-dialog-footer">
        <button class="btn btn-secondary" type="button" id="batch-cancel">Cancel</button>
        <button class="btn btn-primary" type="button" id="batch-close" data-close-dialog="batch-dialog" hidden>Close</button>
    </div>
</dialog>

<dialog class="music-dialog music-report-dialog" id="report-dialog">
    <div class="music-dialog-header">
        <div>
            <h2>Lyrics health report</h2>
            <p class="music-dialog-subtitle" id="report-subtitle"></p>
        </div>
        <button class="music-dialog-close" type="button" data-close-dialog="report-dialog" aria-label="Close">×</button>
    </div>
    <div class="music-dialog-body">
        <div class="music-report-stats" id="report-stats"></div>
        <div class="music-report-types" id="report-types"></div>
        <div class="music-report-table-wrap">
            <table class="music-table music-report-table">
                <thead>
                    <tr>
                        <th>Track</th>
                        <th>Issue</th>
                        <th>Excerpt</th>
                        <th>Severity</th>
                    </tr>
                </thead>
                <tbody id="report-body"></tbody>
            </table>
        </div>
        <div class="music-empty" id="report-empty" hidden>No broken lyrics detected in this scan.</div>
        <p class="music-hint">Read-only report. Nothing was written to the library. Missing lyrics are counted separately.</p>
    </div>
    <div class="music-dialog-footer">
        <button class="btn btn-primary" type="button" data-close-dialog="report-dialog">Close</button>
    </div>
</dialog>

<style>
    .music-library-layout [hidden],
    .music-dialog [hidden] {
        display: none !important;
    }

    .music-library-layout {
        display: grid;
        grid-template-columns: 292px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
    }

    .music-folder-panel {
        position: sticky;
        top: 84px;
        padding: 0;
        overflow: hidden;
    }

    .music-folder-head {
        padding: 1rem 1rem 0.55rem;
    }

    .music-panel-title {
        margin: 0;
        font-size: 1rem;
    }

    .music-panel-subtitle {
        margin: 0.25rem 0 0;
        color: var(--text-secondary);
        font-size: 0.73rem;
        line-height: 1.45;
    }

    .music-folder-search {
        padding: 0 1rem 0.7rem;
    }

    .music-input {
        width: 100%;
        margin: 0;
        padding: 0.62rem 0.75rem;
        border-radius: 9px;
        border: 1px solid var(--border, rgba(148, 163, 184, 0.2));
        background: rgba(15, 23, 42, 0.72);
        color: var(--text-primary);
        font: inherit;
        font-size: 0.8rem;
        box-sizing: border-box;
    }

    .music-input:focus {
        outline: none;
        border-color: rgba(56, 189, 248, 0.55);
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.1);
    }

    .music-tree {
        max-height: min(58vh, 560px);
        overflow: auto;
        padding: 0 0.55rem 0.75rem;
    }

    .music-tree-list,
    .music-tree-children ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .music-tree-children {
        margin-left: 0.48rem;
        padding-left: 0.5rem;
        border-left: 1px dashed rgba(148, 163, 184, 0.18);
    }

    .music-tree-children[hidden] {
        display: none;
    }

    .music-tree-row {
        display: flex;
        align-items: center;
        gap: 0.38rem;
        padding: 0.4rem 0.4rem;
        border-radius: 8px;
        color: var(--text-secondary);
        font-size: 0.76rem;
    }

    .music-tree-row:hover {
        background: rgba(255, 255, 255, 0.045);
        color: var(--text-primary);
    }

    .music-tree-item.is-active > .music-tree-row {
        color: var(--text-primary);
        background: rgba(56, 189, 248, 0.12);
        box-shadow: inset 2px 0 0 var(--accent);
    }

    .music-tree-toggle {
        width: 16px;
        height: 16px;
        flex: 0 0 auto;
        display: grid;
        place-items: center;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-muted, #64748b);
        font-size: 0.62rem;
        cursor: pointer;
        transition: transform 0.15s ease;
    }

    .music-tree-item.is-open > .music-tree-row .music-tree-toggle {
        transform: rotate(90deg);
    }

    .music-tree-spacer {
        width: 16px;
        flex: 0 0 auto;
    }

    .music-tree-icon {
        width: 15px;
        height: 15px;
        flex: 0 0 auto;
        color: #fbbf24;
        opacity: 0.85;
    }

    .music-tree-label {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        font-weight: 600;
        text-align: left;
        cursor: pointer;
    }

    .music-tree-count {
        flex: 0 0 auto;
        color: var(--text-muted, #64748b);
        font-size: 0.65rem;
        font-variant-numeric: tabular-nums;
    }

    .music-tree-issue {
        flex: 0 0 auto;
        min-width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.3rem;
        border-radius: 999px;
        color: #fde68a;
        background: rgba(245, 158, 11, 0.16);
        font-size: 0.62rem;
        font-weight: 800;
    }

    .music-tree-item.music-hidden {
        display: none;
    }

    .music-folder-foot {
        padding: 0.75rem 1rem 1rem;
        border-top: 1px solid var(--border, rgba(148, 163, 184, 0.16));
        color: var(--text-muted, #64748b);
        font-size: 0.69rem;
        line-height: 1.5;
    }

    .music-library-main {
        min-width: 0;
        display: grid;
        gap: 1rem;
    }

    .music-player {
        position: sticky;
        top: var(--music-player-top, 84px);
        z-index: 950;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.65rem;
        padding: 0.7rem 0.85rem;
        border: 1px solid var(--border, rgba(148, 163, 184, 0.2));
        border-left: 4px solid var(--accent);
        border-radius: 12px;
        background: rgba(15, 23, 42, 0.94);
        box-shadow: 0 12px 36px rgba(2, 6, 23, 0.35);
        backdrop-filter: blur(10px);
    }

    .music-player[hidden] {
        display: none;
    }

    .music-player-controls {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        flex: 0 0 auto;
    }

    .music-player-btn {
        min-width: 34px;
        padding: 0.4rem 0.55rem;
    }

    .music-player-main {
        flex: 1;
        min-width: 190px;
    }

    .music-player-title {
        overflow: hidden;
        color: var(--text-primary);
        font-size: 0.8rem;
        font-weight: 700;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .music-player-sub {
        margin-top: 0.08rem;
        overflow: hidden;
        color: var(--text-secondary);
        font-size: 0.68rem;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .music-player-seek,
    .music-player-volume {
        accent-color: var(--accent);
        cursor: pointer;
    }

    .music-player-seek {
        width: 100%;
        margin-top: 0.2rem;
    }

    .music-player-volume {
        width: 84px;
        flex: 0 0 auto;
    }

    .music-player-time {
        display: flex;
        justify-content: space-between;
        color: var(--text-muted, #64748b);
        font-size: 0.62rem;
        font-variant-numeric: tabular-nums;
    }

    .music-track-row.is-playing td {
        background: rgba(56, 189, 248, 0.08);
    }

    @media (max-width: 700px) {
        .music-player {
            top: var(--music-player-top, 74px);
        }

        .music-player-volume {
            width: 100%;
        }
    }

    .music-folder-summary {
        padding: 1rem 1.2rem;
    }

    .music-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.32rem;
        min-height: 1.2rem;
        color: var(--text-secondary);
        font-size: 0.72rem;
    }

    .music-breadcrumb button {
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-secondary);
        font: inherit;
        cursor: pointer;
    }

    .music-breadcrumb button:hover {
        color: var(--accent);
    }

    .music-breadcrumb .sep {
        color: var(--text-muted, #64748b);
    }

    .music-folder-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.35rem;
    }

    .music-folder-heading h2 {
        margin: 0;
        font-size: 1.35rem;
        letter-spacing: -0.03em;
    }

    .music-folder-path {
        margin-top: 0.25rem;
        color: var(--text-muted, #64748b);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        overflow-wrap: anywhere;
    }

    .music-folder-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .music-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .music-stat {
        display: grid;
        gap: 0.2rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--border, rgba(148, 163, 184, 0.16));
        border-radius: 12px;
        background: rgba(30, 41, 59, 0.55);
    }

    .music-stat-label {
        color: var(--text-secondary);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .music-stat strong {
        font-size: 1.35rem;
        letter-spacing: -0.03em;
    }

    .music-stat strong.music-stat-date {
        font-size: 0.92rem;
        line-height: 1.7;
    }

    .music-stat-meta {
        color: var(--text-muted, #64748b);
        font-size: 0.66rem;
    }

    .music-tracks-card {
        padding: 1rem 1.2rem;
    }

    .music-subfolder-section {
        margin-bottom: 1rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid var(--border, rgba(148, 163, 184, 0.16));
    }

    .music-section-head h3 {
